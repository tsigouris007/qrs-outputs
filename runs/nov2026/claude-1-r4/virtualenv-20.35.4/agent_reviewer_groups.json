    "codeql_raw_query": "/**\n * @name Insecure SSL/TLS configuration\n * @description Disabling SSL certificate verification can allow man-in-the-middle attacks\n * @kind problem\n * @problem.severity error\n * @id py/insecure-ssl-config\n * @tags security\n *        external/cwe/cwe-295\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    // urllib.request with context that doesn't verify\n    call = API::moduleImport(\"urllib\").getMember(\"request\").getMember([\"urlopen\", \"Request\"]).getACall() or\n    // requests with verify=False\n    call = API::moduleImport(\"requests\").getMember([\"get\", \"post\", \"request\", \"put\", \"delete\", \"patch\"]).getACall() or\n    // SSL context with CERT_NONE\n    call = API::moduleImport(\"ssl\").getMember(\"_create_unverified_context\").getACall()\n  )\nselect call, \"Potentially insecure SSL/TLS configuration that may allow man-in-the-middle attacks.\"\n",
    "hypothesis": "Detecting insecure SSL/TLS configurations that disable certificate verification",
