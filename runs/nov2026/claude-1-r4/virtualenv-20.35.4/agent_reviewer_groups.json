    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description Using user-controlled paths without validation can lead to path traversal\n * @kind path-problem\n * @problem.severity error\n * @id py/path-injection\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\nimport semmle.python.ApiGraphs\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // CLI arguments\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"argparse\").getMember(\"ArgumentParser\").getReturn().getMember(\"parse_args\").getACall() and\n      source = call\n    )\n    or\n    // Environment variables\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"os\").getMember(\"environ\").getMember(\"get\").getACall() and\n      source = call\n    )\n    or\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"os\").getMember(\"getenv\").getACall() and\n      source = call\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(FileSystemAccess fsa |\n      sink = fsa.getAPathArgument()\n    )\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Path traversal from $@.\", source.getNode(), \"user input\"",
    "hypothesis": "User-controlled paths from CLI arguments or environment variables flowing to file system operations without proper validation could allow path traversal attacks",
