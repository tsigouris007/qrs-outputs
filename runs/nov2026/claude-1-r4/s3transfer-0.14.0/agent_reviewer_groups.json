    "codeql_raw_query": "/**\n * @name Symlink following vulnerability\n * @description File operations that follow symlinks may allow attackers to access arbitrary files\n * @kind problem\n * @problem.severity high\n * @id py/s3transfer-symlink-following\n * @tags security\n *        external/cwe/cwe-59\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    // os.path.exists, os.path.isfile, os.path.isdir - all follow symlinks by default\n    call = API::moduleImport(\"os\").getMember(\"path\").getMember([\"exists\", \"isfile\", \"isdir\"]).getACall() or\n    // open() without specific symlink handling\n    call = API::builtin(\"open\").getACall() or\n    // os.stat follows symlinks (os.lstat does not)\n    call = API::moduleImport(\"os\").getMember(\"stat\").getACall() or\n    // shutil operations that may follow symlinks\n    call = API::moduleImport(\"shutil\").getMember([\"copy\", \"copy2\", \"copyfile\", \"move\"]).getACall()\n  )\nselect call, \"File operation that follows symlinks, potentially allowing symlink attack.\"",
    "hypothesis": "File operations follow symlinks without proper validation, allowing attackers to manipulate file paths through symbolic links",
