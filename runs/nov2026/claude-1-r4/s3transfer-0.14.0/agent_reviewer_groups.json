    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description File operations using unsanitized user input may allow access to arbitrary files\n * @kind path-problem\n * @problem.severity error\n * @id py/s3transfer-path-traversal\n * @tags security\n *        external/cwe/cwe-22\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\nimport semmle.python.ApiGraphs\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // S3 object keys - dictionary access with \"Key\"\n    exists(DataFlow::Node dictAccess |\n      dictAccess.asExpr().(Subscript).getIndex().(StrConst).getText() = \"Key\" |\n      source = dictAccess\n    )\n    or\n    // S3 get_object or similar calls returning objects with Key attribute\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"boto3\").getMember(\"client\").getACall() or\n      call = API::moduleImport(\"boto3\").getMember(\"resource\").getACall() |\n      source = call.getArg(_)\n    )\n    or\n    // Parameters with names suggesting external input\n    exists(DataFlow::ParameterNode param |\n      param.getParameter().getName() in [\"key\", \"filename\", \"path\", \"bucket_key\", \"extra_args\", \"object_key\", \"s3_key\"] |\n      source = param\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    sink = any(FileSystemAccess fa).getAPathArgument()\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from $@.\", source.getNode(), \"user-controlled input\"",
    "hypothesis": "Path traversal in file operations - S3 keys or external input flowing to file system operations without sanitization",
    "severity": "high",
    "cwe_ids": [
