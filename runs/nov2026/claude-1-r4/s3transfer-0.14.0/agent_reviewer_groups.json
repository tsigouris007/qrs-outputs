    "codeql_query_uuid": "20261118001837",
    "codeql_raw_query": "/**\n * @name Time-of-check Time-of-use race condition\n * @description File existence checks followed by file operations may lead to race conditions\n * @kind problem\n * @problem.severity warning\n * @id py/s3transfer-toctou\n * @tags security\n *        external/cwe/cwe-367\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode check, DataFlow::CallCfgNode use\nwhere\n  // File existence checks\n  (\n    check = API::moduleImport(\"os\").getMember(\"path\").getMember([\"exists\", \"isfile\", \"isdir\"]).getACall() or\n    check = API::moduleImport(\"os\").getMember([\"stat\", \"access\"]).getACall()\n  ) and\n  // File operations\n  (\n    use = API::builtin(\"open\").getACall() or\n    use = API::moduleImport(\"os\").getMember([\"remove\", \"unlink\", \"rmdir\", \"rename\", \"mkdir\", \"makedirs\"]).getACall() or\n    use = API::moduleImport(\"shutil\").getMember([\"copy\", \"copy2\", \"move\", \"rmtree\"]).getACall()\n  )\nselect check, \"File check operation that may be vulnerable to TOCTOU race condition.\"\n",
    "hypothesis": "TOCTOU race conditions where file existence is checked before operations",
    "severity": "medium",
    "cwe_ids": [
     "cwe-367"
    ],
