   {
    "codeql_query_uuid": "20261119193412",
    "codeql_raw_query": "/**\n * @name Unvalidated size from image header drives allocation\n * @description Sizes parsed from image headers control allocation sizes without upper bounds, enabling memory exhaustion\n * @kind problem\n * @problem.severity warning\n * @id py/pillow-unbounded-alloc\n * @tags security\n *        external/cwe/cwe-400\n *        external/cwe/cwe-770\n */\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule SizeConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    exists(Call c |\n      source.asExpr() = c and\n      c.getFunc().toString().regexpMatch(\"(.*\\\\.)?(i16|i32|i8|u8|u16|u32|unpack|getint|read)\")\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(Call c |\n      sink.asExpr() = c.getArg(0) and\n      c.getFunc().toString().regexpMatch(\"(.*\\\\.)?(tobytes|read|seek|decode|fill)$\")\n    )\n  }\n}\n\nmodule SizeFlow = TaintTracking::Global<SizeConfig>;\n\nfrom DataFlow::Node source, DataFlow::Node sink\nwhere SizeFlow::flow(source, sink)\nselect sink, \"Image header value $@ drives a size argument.\", source, \"parsed from image data\"",
    "hypothesis": "Unbounded allocations driven by size fields parsed from image headers (decompression bomb / memory exhaustion, CWE-400/770)",
