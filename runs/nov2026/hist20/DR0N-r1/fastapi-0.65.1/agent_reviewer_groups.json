    "codeql_query_uuid": "20261119030301",
    "codeql_raw_query": "/**\n * @name Subprocess call arguments in CI automation scripts\n * @description Shows the code of subprocess invocations inside repository automation scripts\n * @kind problem\n * @problem.severity note\n * @id py/subprocess-code-dump\n * @tags security\n */\n\nimport python\n\nfrom Call c, string path, int line\nwhere\n  c.getLocation().getFile().getRelativePath() = path and\n  path = \".github/actions/people/app/main.py\" and\n  line = c.getLocation().getStartLine() and\n  line >= 495 and line <= 530\nselect c, path + \":\" + line.toString() + \" => \" + c.toString()\n",
