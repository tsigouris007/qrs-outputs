    "codeql_raw_query": "/**\n * @name Dump suspicious library calls in fastapi core\n * @description Inventory of risky API usage inside the fastapi package source\n * @kind problem\n * @problem.severity note\n * @id py/core-risky-inventory\n * @tags security\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call, string kind\nwhere\n  call.getLocation().getFile().getRelativePath().matches(\"fastapi/%\") and\n  (\n    call = API::moduleImport(\"yaml\").getMember([\"load\", \"load_all\", \"unsafe_load\"]).getACall() and kind = \"yaml load\"\n    or call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\"]).getACall() and kind = \"pickle\"\n    or call = API::moduleImport(\"marshal\").getMember([\"load\", \"loads\"]).getACall() and kind = \"marshal\"\n    or call = API::builtin([\"eval\", \"exec\", \"compile\"]).getACall() and kind = \"eval/exec\"\n    or call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall() and kind = \"os command\"\n    or call = API::moduleImport(\"subprocess\").getMember([\"call\", \"run\", \"Popen\", \"check_output\", \"check_call\"]).getACall() and kind = \"subprocess\"\n    or call = API::moduleImport(\"builtins\").getMember(\"open\").getACall() and kind = \"file open\"\n    or call = API::moduleImport(\"base64\").getMember([\"b64decode\", \"decodebytes\", \"urlsafe_b64decode\"]).getACall() and kind = \"base64 decode\"\n    or call = API::moduleImport(\"tempfile\").getMember([\"mktemp\"]).getACall() and kind = \"insecure temp\"\n    or call = API::moduleImport(\"hashlib\").getMember([\"md5\", \"sha1\"]).getACall() and kind = \"weak hash\"\n    or call = API::moduleImport(\"requests\").getMember([\"get\", \"post\", \"request\"]).getACall() and kind = \"outbound http\"\n    or call = API::moduleImport(\"random\").getMember([\"random\", \"randint\", \"choice\"]).getACall() and kind = \"insecure random\"\n  )\nselect call, kind",
