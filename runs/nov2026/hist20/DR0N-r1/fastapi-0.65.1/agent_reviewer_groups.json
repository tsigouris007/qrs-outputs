   {
    "codeql_query_uuid": "20261119025805",
    "codeql_raw_query": "/**\n * @name Dangerous function usage survey\n * @description Survey of dangerous API usages across the package\n * @kind problem\n * @problem.severity warning\n * @id py/dangerous-usage-survey\n * @tags security\n */\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call, string msg\nwhere\n  (\n    call = API::moduleImport(\"yaml\").getMember([\"load\", \"load_all\"]).getACall() and\n    msg = \"yaml.load without SafeLoader may deserialize arbitrary Python objects\"\n  ) or\n  (\n    call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\"]).getACall() and\n    msg = \"Unsafe pickle deserialization\"\n  ) or\n  (\n    call = API::moduleImport(\"subprocess\").getMember([\"call\", \"run\", \"Popen\", \"check_output\", \"check_call\", \"getoutput\", \"getstatusoutput\"]).getACall() and\n    msg = \"subprocess invocation\"\n  ) or\n  (\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall() and\n    msg = \"os command execution\"\n  ) or\n  (\n    call = API::builtin([\"eval\", \"exec\"]).getACall() and\n    msg = \"eval/exec dynamic code execution\"\n  ) or\n  (\n    call = API::moduleImport(\"requests\").getMember([\"get\", \"post\", \"put\", \"delete\", \"request\", \"head\", \"patch\"]).getACall() and\n    msg = \"outbound HTTP request\"\n  ) or\n  (\n    call = API::moduleImport(\"httpx\").getMember([\"get\", \"post\", \"put\", \"delete\", \"request\", \"head\", \"patch\"]).getACall() and\n    msg = \"outbound HTTP request (httpx)\"\n  )\nselect call, msg\n",
    "hypothesis": "Survey for dangerous API usage: unsafe deserialization, command execution, eval/exec, outbound requests",
    "severity": "medium",
    "cwe_ids": [
     "cwe-502",
     "cwe-78",
     "cwe-94"
    ],
