    "codeql_query_uuid": "20261119022801",
    "codeql_raw_query": "/**\n * @name XXE / unsafe XML parsing\n * @description XML parsing used to deserialize untrusted data\n * @kind problem\n * @problem.severity error\n * @id py/django-xxe\n * @tags security\n *        external/cwe/cwe-611\n */\nimport python\n\nfrom Call c\nwhere\n  c.getFunc().(Attribute).getAttr() = [\"parse\", \"parseString\", \"fromstring\", \"XML\", \"iterparse\"]\n  and\n  (\n    c.getFunc().(Attribute).getObject().(Name).getId() in [\"minidom\", \"etree\", \"ElementTree\", \"pulldom\", \"sax\"]\n    or\n    c.getFunc().(Attribute).getObject().(Attribute).getAttr() = \"ElementTree\"\n  )\nselect c, \"XML parsing call - check DTD/entity/external entity restrictions\"",
