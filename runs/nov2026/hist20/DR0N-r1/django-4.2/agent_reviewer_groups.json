    "codeql_raw_query": "/**\n * @name Dangerous execution and deserialization sinks in Django\n * @description Finds calls to code execution, unsafe deserialization, and shell execution APIs\n * @kind problem\n * @problem.severity warning\n * @id py/django-dangerous-sinks\n * @tags security\n *        external/cwe/cwe-094\n *        external/cwe/cwe-502\n *        external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string msg\nwhere\n  (\n    call = API::builtin(\"eval\").getACall() and msg = \"eval() call\"\n    or\n    call = API::builtin(\"exec\").getACall() and msg = \"exec() call\"\n    or\n    call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\"]).getACall() and msg = \"pickle load\"\n    or\n    call = API::moduleImport(\"marshal\").getMember([\"load\", \"loads\"]).getACall() and msg = \"marshal load\"\n    or\n    call = API::moduleImport(\"yaml\").getMember([\"load\", \"load_all\", \"unsafe_load\"]).getACall() and msg = \"yaml load\"\n    or\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall() and msg = \"os shell command\"\n    or\n    call = API::moduleImport(\"subprocess\").getMember([\"call\", \"run\", \"Popen\", \"check_output\", \"check_call\"]).getACall() and\n       call.getArgByName(\"shell\").asExpr().(IntegerLiteral).getValue() = 1 and msg = \"subprocess with shell=True\"\n  )\nselect call, msg",
    "hypothesis": "Dangerous code/shell execution and unsafe deserialization sinks exist in Django",
