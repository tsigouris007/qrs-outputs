    "codeql_query_uuid": "20261119023427",
    "codeql_raw_query": "/**\n * @name Path traversal from remote input to filesystem access\n * @description Remote input reaching filesystem path operations\n * @kind path-problem\n * @problem.severity error\n * @id py/django-path-traversal-path\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) { source instanceof RemoteFlowSource }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(Call call, Attribute attr |\n      call.getFunc() = attr and\n      attr.getName() =\n        [\"open\", \"urlopen\", \"exists\", \"isfile\", \"isdir\", \"remove\", \"unlink\", \"load\", \"save\", \"read_text\", \"read_bytes\"] and\n      sink.asExpr() = call.getAnArg()\n    )\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Filesystem operation on $@ may allow path traversal.\", source.getNode(), \"user input\"",
