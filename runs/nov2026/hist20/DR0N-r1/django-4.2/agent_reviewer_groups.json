    "codeql_query_uuid": "20261119023147",
    "codeql_raw_query": "/**\n * @name Path traversal in filesystem operations\n * @description Remote input flowing into filesystem path operations\n * @kind problem\n * @problem.severity error\n * @id py/django-path-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) { source instanceof RemoteFlowSource }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(Call call, Attribute attr |\n      call.getFunc() = attr and\n      attr.getName() =\n        [\"open\", \"urlopen\", \"exists\", \"isfile\", \"isdir\", \"remove\", \"unlink\", \"load\", \"save\", \"read_text\", \"read_bytes\"] and\n      sink.asExpr() = call.getAnArg()\n    )\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\n\nfrom DataFlow::Node source, DataFlow::Node sink\nwhere PathTraversalFlow::flow(source, sink)\nselect sink, \"Filesystem operation on $@ may allow path traversal.\", source, \"user input\"",
    "hypothesis": "Remote input flowing into filesystem path operations enabling path traversal (CWE-22)",
    "severity": "high",
    "cwe_ids": [
     "cwe-022"
    ],
