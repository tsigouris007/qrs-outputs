   {
    "codeql_query_uuid": "20261119203326",
    "codeql_raw_query": "/**\n * @name PyYAML unsafe object construction helpers\n * @description Lists the helper functions used to resolve and instantiate arbitrary Python objects from YAML tags (CVE-2020-1747 mechanism).\n * @kind problem\n * @problem.severity warning\n * @id py/pyyaml-object-construct-helpers\n */\n\nimport python\n\nfrom Function f\nwhere\n  f.getName() in [\n    \"find_python_name\", \"find_python_module\", \"make_python_instance\",\n    \"set_python_instance_state\", \"construct_python_object\", \"construct_python_object_new\",\n    \"construct_python_object_apply\", \"construct_python_name\", \"construct_python_module\"\n  ]\nselect f, \"PyYAML object-construction helper: \" + f.getName()\n",
    "hypothesis": "PyYAML contains helpers that resolve arbitrary dotted names into Python objects and invoke them (find_python_name/make_python_instance), the mechanism behind CVE-2020-1747 when FullLoader is used on untrusted YAML.",
    "severity": "critical",
