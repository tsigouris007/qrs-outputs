    "codeql_query_uuid": "20261119202940",
    "codeql_raw_query": "/**\n * @name pyyaml default loader selection\n * @description Finds uses of FullLoader / UnsafeLoader in the top-level API\n * @kind problem\n * @problem.severity warning\n * @id py/pyyaml-default-loader\n * @tags security\n *        external/cwe/cwe-502\n */\n\nimport python\n\nfrom Name n\nwhere\n  n.getId() in [\"FullLoader\", \"UnsafeLoader\", \"FullConstructor\", \"Constructor\"]\n  and n.getLocation().getFile().getBaseName() = \"__init__.py\"\nselect n, n.getId() + \" used in top-level API\"",
