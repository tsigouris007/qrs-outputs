    "codeql_query_uuid": "20261119202646",
    "codeql_raw_query": "/**\n * @name Dangerous calls in PyYAML\n * @description Finds eval/exec/pickle/os.system style calls inside the package\n * @kind problem\n * @problem.severity warning\n * @id py/pyyaml-dangerous-calls\n * @tags security\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string what\nwhere\n  (\n    call = API::builtin([\"eval\", \"exec\", \"compile\"]).getACall() and what = \"eval/exec/compile\"\n    or\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall() and what = \"os shell\"\n    or\n    call = API::moduleImport(\"subprocess\").getMember([\"call\", \"run\", \"Popen\", \"check_output\", \"check_call\"]).getACall() and what = \"subprocess\"\n    or\n    call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall() and what = \"pickle\"\n    or\n    call = API::moduleImport(\"marshal\").getMember([\"load\", \"loads\"]).getACall() and what = \"marshal\"\n    or\n    call = API::builtin(\"__import__\").getACall() and what = \"import\"\n  )\nselect call, \"Dangerous call: \" + what",
    "hypothesis": "Library contains dangerous evaluation/deserialization sinks (CWE-94, CWE-502)",
    "severity": "high",
