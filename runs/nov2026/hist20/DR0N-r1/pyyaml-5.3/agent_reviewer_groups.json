   {
    "codeql_query_uuid": "20261119203350",
    "codeql_raw_query": "/**\n * @name PyYAML dynamic instantiation / attribute access sink\n * @description Confirms calls that instantiate a class resolved from YAML-controlled data\n *              (the code-execution sink behind CVE-2020-1747 in FullLoader / UnsafeLoader).\n * @kind problem\n * @problem.severity error\n * @id py/pyyaml-dynamic-instantiation\n * @tags security\n *        external/cwe/cwe-094\n */\n\nimport python\n\nfrom Call c, Name n\nwhere\n  c.getFunc() = n and\n  n.getId() in [\"cls\", \"suffix\", \"instance\", \"obj\"]\nselect c, \"Dynamic call through YAML-controlled name '\" + n.getId() + \"' (CVE-2020-1747 code execution sink)\"\n",
    "hypothesis": "PyYAML's make_python_instance / find_python_name / find_python_module resolve attacker-supplied dotted names and then invoke/instantiate them, giving code execution reachable from YAML tags.",
    "severity": "critical",
    "cwe_ids": [
     "cwe-094",
     "cwe-502"
    ],
    "results_count": 2,
    "results": [
