    "codeql_raw_query": "/**\n * @name getattr calls in sandbox-relevant modules\n * @description inventory\n * @kind problem\n * @problem.severity warning\n * @id py/getattr-inventory\n */\nimport python\n\nfrom Call c\nwhere\n  c.getFunc().(Name).getId() = \"getattr\"\n  and c.getLocation().getFile().getBaseName() in [\"filters.py\", \"sandbox.py\"]\nselect c, \"getattr() at line \" + c.getLocation().getStartLine().toString()",
    "hypothesis": "The |attr filter (do_attr in filters.py) may call getattr() directly without consulting SandboxedEnvironment.is_safe_attribute, enabling sandbox escape (CVE-2025-27516) in 3.1.5.",
