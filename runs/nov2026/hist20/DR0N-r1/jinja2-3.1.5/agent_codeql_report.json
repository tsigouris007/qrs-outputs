   "codeql_raw_query": "/**\n * @name Dangerous execution sinks inventory\n * @description Lists calls to eval/exec/compile, deserialization, command execution and dynamic import\n * @kind problem\n * @problem.severity recommendation\n * @id py/sink-inventory\n * @tags security\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string kind\nwhere\n  (\n    call = API::moduleImport(\"pickle\").getMember([\"loads\", \"load\", \"Unpickler\"]).getACall() and kind = \"pickle-deserialize\"\n    or call = API::moduleImport(\"marshal\").getMember([\"loads\", \"load\"]).getACall() and kind = \"marshal-deserialize\"\n    or call = API::builtin([\"eval\", \"exec\", \"compile\"]).getACall() and kind = \"code-exec\"\n    or call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall() and kind = \"os-command\"\n    or call = API::moduleImport(\"subprocess\").getMember([\"call\", \"run\", \"Popen\", \"check_output\", \"check_call\"]).getACall() and kind = \"subprocess\"\n    or call = API::moduleImport(\"importlib\").getMember([\"import_module\", \"__import__\"]).getACall() and kind = \"dynamic-import\"\n    or call = API::moduleImport(\"pickle\").getMember([\"dumps\"]).getACall() and kind = \"pickle-serialize\"\n  )\nselect call, kind",
