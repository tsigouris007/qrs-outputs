    "codeql_raw_query": "/**\n * @name Dangerous function calls in package\n * @description Identifies calls to dangerous APIs (deserialization, code exec, command exec)\n * @kind problem\n * @problem.severity warning\n * @id py/dangerous-calls-survey\n * @tags security\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string msg\nwhere\n  (\n    call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall() and msg = \"pickle deserialization\"\n    or\n    call = API::moduleImport(\"marshal\").getMember([\"load\", \"loads\"]).getACall() and msg = \"marshal deserialization\"\n    or\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall() and msg = \"os command execution\"\n    or\n    call = API::moduleImport(\"os\").getMember([\"execv\", \"execve\", \"spawnv\", \"spawnve\"]).getACall() and msg = \"os exec\"\n    or\n    call = API::moduleImport(\"subprocess\").getMember([\"call\", \"run\", \"Popen\", \"check_output\", \"check_call\"]).getACall() and msg = \"subprocess\"\n    or\n    call = API::builtin(\"eval\").getACall() and msg = \"eval\"\n    or\n    call = API::builtin(\"exec\").getACall() and msg = \"exec\"\n    or\n    call = API::moduleImport(\"builtins\").getMember([\"eval\", \"exec\"]).getACall() and msg = \"eval/exec\"\n    or\n    call = API::moduleImport(\"yaml\").getMember([\"load\", \"unsafe_load\", \"full_load\"]).getACall() and msg = \"unsafe yaml load\"\n    or\n    call = API::moduleImport(\"importlib\").getMember(\"import_module\").getACall() and msg = \"dynamic import\"\n    or\n    call = API::moduleImport(\"shelve\").getMember(\"open\").getACall() and msg = \"shelve open\"\n  )\nselect call, msg",
