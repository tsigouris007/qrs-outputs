    "codeql_query_uuid": "20261119010558",
    "codeql_raw_query": "/**\n * @name Path traversal in static file resolution\n * @description Request-derived path components flowing into filesystem path construction\n * @kind path-problem\n * @problem.severity error\n * @id py/aiohttp-static-path-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\n\nmodule C implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node src) {\n    exists(Attribute a | a.getAttr() = [\"match_info\", \"rel_url\", \"raw_path\"] and src.asExpr() = a)\n    or exists(Subscript s |\n      s.getObject().(Attribute).getAttr() = [\"match_info\", \"rel_url\"]\n      and src.asExpr() = s\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode c |\n      c.asExpr().(Call).getFunc().(Attribute).getAttr() =\n        [\"joinpath\", \"join\", \"normpath\", \"abspath\", \"resolve\", \"open\", \"stat\", \"is_file\", \"exists\"]\n      and sink = c.getArg(0)\n    )\n  }\n}\n\nmodule F = TaintTracking::Global<C>;\nimport F::PathGraph\n\nfrom F::PathNode s, F::PathNode k\nwhere F::flowPath(s, k)\nselect k.getNode(), s, k, \"Filesystem path derived from $@.\", s.getNode(), \"request path data\"",
    "hypothesis": "CVE-2024-23334: static-file path traversal - request derived path reaching filesystem sinks",
    "severity": "high",
    "cwe_ids": [
     "cwe-022"
    ],
    "results_count": 1,
    "results": [
     {
