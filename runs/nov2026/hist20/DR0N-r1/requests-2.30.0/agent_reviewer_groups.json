    "codeql_raw_query": "/**\n * @name Proxy-Authorization header handling\n * @description Locates code that emits or manipulates the Proxy-Authorization header, used to check whether\n *              proxy credentials are stripped when a redirect changes the destination host/proxy.\n * @kind problem\n * @problem.severity note\n * @id py/proxy-auth-header-usage\n * @tags security\n *        external/cwe/cwe-200\n */\n\nimport python\n\nfrom Str s\nwhere s.getText() = \"Proxy-Authorization\"\nselect s, \"Proxy-Authorization header is constructed/used here; verify it is stripped on cross-host redirects (CVE-2023-32681).\"",
