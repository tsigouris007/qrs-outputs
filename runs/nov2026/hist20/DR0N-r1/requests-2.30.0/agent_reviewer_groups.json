    "codeql_raw_query": "/**\n * @name Header stripping in redirect handling\n * @description Find header pop/del operations and literals matching auth headers\n * @kind problem\n * @problem.severity warning\n * @id py/header-strip-debug\n */\nimport python\n\nfrom Call c, StrConst s\nwhere\n  c.getFunc().(Attribute).getName() = [\"pop\", \"remove\", \"__delitem__\"] and\n  s = c.getAnArg() and\n  s.getText().regexpMatch(\".*(?i)(authorization|cookie).*\")\nselect c, \"Header removal of $@ near auth-sensitive literal\", s, s.getText()",
