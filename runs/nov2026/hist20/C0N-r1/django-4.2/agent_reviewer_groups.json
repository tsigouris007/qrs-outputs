    "codeql_raw_query": "/**\n * @name Hardcoded credentials\n * @description Hardcoded credentials in source code can be discovered and exploited\n * @kind problem\n * @problem.severity error\n * @id py/hardcoded-credentials\n * @tags security\n *        external/cwe/cwe-798\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::Node assignment, string value\nwhere\n  exists(DataFlow::AttrWrite attr |\n    attr.getAttributeName().toLowerCase().matches([\"%password%\", \"%secret%\", \"%key%\", \"%token%\"]) and\n    assignment = attr.getValue() and\n    value = assignment.asExpr().(StringLiteral).getText() and\n    value.length() > 8 and\n    not value.matches(\"%{%\") and\n    not value.matches(\"%<%\") and\n    not value.matches(\"%$%\")\n  )\nselect assignment, \"Potential hardcoded credential: \" + value",
    "hypothesis": "Check for hardcoded credentials like passwords, secrets, or API keys in the source code",
    "severity": "high",
