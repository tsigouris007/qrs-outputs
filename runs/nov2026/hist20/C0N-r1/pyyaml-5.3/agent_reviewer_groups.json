    "codeql_raw_query": "/**\n * @name Complex regular expressions that may cause ReDoS\n * @description Regular expressions with nested quantifiers or alternations can cause exponential backtracking\n * @kind problem\n * @problem.severity warning\n * @id py/pyyaml-redos-regex\n * @tags security\n *        external/cwe/cwe-1333\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, StrConst pattern\nwhere\n  call = API::moduleImport(\"re\").getMember(\"compile\").getACall() and\n  pattern = call.getArg(0).asExpr() and\n  (\n    pattern.getText().regexpMatch(\".*[*+]{2,}.*\") or\n    pattern.getText().regexpMatch(\".*(\\\\([^)]*[*+]){2,}.*\") or\n    pattern.getText().regexpMatch(\".*\\\\|.*\\\\|.*\")\n  )\nselect call, \"Complex regular expression pattern that may be vulnerable to ReDoS: \" + pattern.getText()",
    "hypothesis": "Complex regular expressions with nested quantifiers or multiple alternations that could lead to ReDoS attacks",
