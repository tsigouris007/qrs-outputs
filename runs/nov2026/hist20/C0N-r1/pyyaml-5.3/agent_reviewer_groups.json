    "codeql_raw_query": "/**\n * @name Dangerous YAML tag strings\n * @description String literals containing dangerous YAML tags that enable arbitrary Python object instantiation\n * @kind problem\n * @problem.severity error\n * @id py/pyyaml-dangerous-tag-strings\n * @tags security\n *        external/cwe/cwe-502\n */\n\nimport python\n\nfrom StrConst str\nwhere\n  (\n    str.getText().matches(\"%python/object/apply%\") or\n    str.getText().matches(\"%python/object/new%\") or\n    str.getText().matches(\"%python/name:%\") or\n    str.getText().matches(\"%python/module:%\")\n  )\nselect str, \"Dangerous YAML tag string: \" + str.getText()",
