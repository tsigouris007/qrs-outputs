    "codeql_raw_query": "/**\n * @name Use of dangerous code execution functions\n * @description Using eval, exec, or compile can lead to arbitrary code execution\n * @kind problem\n * @problem.severity error\n * @id py/pyyaml-dangerous-functions\n * @tags security\n *        external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string funcName\nwhere\n  (\n    call = API::builtin(\"eval\").getACall() and funcName = \"eval\"\n    or\n    call = API::builtin(\"exec\").getACall() and funcName = \"exec\"\n    or\n    call = API::builtin(\"compile\").getACall() and funcName = \"compile\"\n    or\n    call = API::builtin(\"__import__\").getACall() and funcName = \"__import__\"\n  )\nselect call, \"Use of dangerous function '\" + funcName + \"' that can execute arbitrary code.\"\n",
