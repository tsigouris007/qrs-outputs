   "codeql_query_uuid": "20261118193223",
   "codeql_raw_query": "/**\n * @name SQL injection via string formatting in raw SQL\n * @description Using string formatting or concatenation to construct SQL queries can lead to SQL injection\n * @kind problem\n * @problem.severity error\n * @id py/sql-injection-string-format\n * @tags security\n *        external/cwe/cwe-089\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node sqlArg\nwhere\n  (\n    // raw() method calls\n    call = API::moduleImport(\"django\").getMember(\"db\").getMember(\"models\").getMember(\"expressions\").getMember(\"RawSQL\").getACall() or\n    call = API::moduleImport(\"django\").getMember(\"db\").getMember(\"connection\").getMember(\"cursor\").getReturn().getMember(\"execute\").getACall() or\n    call = API::moduleImport(\"django\").getMember(\"db\").getMember(\"models\").getMember(\"Manager\").getASubclass*().getMember(\"raw\").getACall()\n  ) and\n  sqlArg = call.getArg(0) and\n  exists(DataFlow::CallCfgNode formatCall |\n    formatCall.getFunction().asCfgNode().(AttrNode).getObject(\"format\") = sqlArg.asCfgNode() or\n    formatCall = any(DataFlow::MethodCallNode mc | mc.getMethodName() = \"format\" and mc.getObject() = sqlArg)\n  )\nselect call, \"SQL query constructed using string formatting, which may be vulnerable to SQL injection.\"",
   "hypothesis": "SQL injection through string formatting in raw SQL queries",
