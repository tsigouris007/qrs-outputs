   "codeql_raw_query": "/**\n * @name Cross-site scripting (XSS) via template rendering\n * @description Rendering user input in templates without proper escaping can lead to XSS\n * @kind path-problem\n * @problem.severity error\n * @id py/xss-template\n * @tags security\n *        external/cwe/cwe-079\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.ApiGraphs\n\nmodule XSSConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof RemoteFlowSource\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      // Django mark_safe function\n      call = API::moduleImport(\"django\").getMember(\"utils\").getMember(\"safestring\").getMember(\"mark_safe\").getACall() and\n      sink = call.getArg(0)\n      or\n      // Django SafeString/SafeText constructors\n      call = API::moduleImport(\"django\").getMember(\"utils\").getMember(\"safestring\").getMember([\"SafeString\", \"SafeText\"]).getACall() and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule XSSFlow = TaintTracking::Global<XSSConfig>;\nimport XSSFlow::PathGraph\n\nfrom XSSFlow::PathNode source, XSSFlow::PathNode sink\nwhere XSSFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential XSS via mark_safe with untrusted data from $@.\", source.getNode(), \"user input\"",
