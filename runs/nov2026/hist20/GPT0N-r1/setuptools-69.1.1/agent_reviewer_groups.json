    "codeql_query_uuid": "20261120001312",
    "codeql_raw_query": "/**\n * @name Unsafe deserialization in setuptools\n * @description Detects uses of pickle, marshal, or yaml.load that may deserialize untrusted data.\n * @kind problem\n * @problem.severity error\n * @id py/setuptools/unsafe-deserialization\n * @tags security\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall()\n  or call = API::moduleImport(\"marshal\").getMember([\"load\", \"loads\"]).getACall()\n  or call = API::moduleImport(\"yaml\").getMember([\"load\", \"unsafe_load\"]).getACall()\nselect call, \"Potentially unsafe deserialization operation in setuptools that could execute arbitrary code.\"",
    "hypothesis": "Setuptools may use pickle/marshal/yaml.load on data that could be influenced by remote sources (indexes, package metadata, cache).",
    "severity": "high",
    "cwe_ids": [
     "cwe-502"
    ],
    "results_count": 2,
