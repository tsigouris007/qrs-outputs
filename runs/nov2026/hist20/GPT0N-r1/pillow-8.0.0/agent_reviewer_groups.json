    "codeql_raw_query": "/**\n * @name Use of eval/exec in Pillow\n * @description Detect dynamic code execution which can be dangerous if influenced by untrusted input.\n * @kind problem\n * @problem.severity error\n * @id py/pillow-eval-exec\n * @tags security\n *       external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin([\"eval\", \"exec\"]).getACall()\nselect call, \"Dynamic code execution via eval/exec in Pillow codebase.\"",
