    "codeql_query_uuid": "20261119225125",
    "codeql_raw_query": "/**\n * @name Unsafe deserialization in Django\n * @description Detects uses of pickle, yaml.unsafe_load, or similar unsafe deserialization in Django codebase.\n * @kind problem\n * @problem.severity error\n * @id py/django-unsafe-deserialization\n * @tags security\n *       framework\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall() or\n  call = API::moduleImport(\"yaml\").getMember([\"load\", \"unsafe_load\"]).getACall()\nselect call, \"Potentially unsafe deserialization that could lead to code execution if used on untrusted data.\"",
    "hypothesis": "Django may use unsafe deserialization helpers (pickle, yaml.load) on untrusted data.",
