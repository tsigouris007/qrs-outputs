    "codeql_query_uuid": "20261119225157",
    "codeql_raw_query": "/**\n * @name Path traversal in Django file handling\n * @description Detects flows from remote/user-controlled sources into filesystem path operations in Django.\n * @kind path-problem\n * @problem.severity error\n * @id py/django-path-traversal\n * @tags security\n *       framework\n *       external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.Concepts\n\nmodule DjangoPathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof RemoteFlowSource\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(FileSystemAccess fa |\n      sink = fa.getAPathArgument()\n    )\n  }\n}\n\nmodule DjangoPathTraversalFlow = TaintTracking::Global<DjangoPathTraversalConfig>;\nimport DjangoPathTraversalFlow::PathGraph\n\nfrom DjangoPathTraversalFlow::PathNode source, DjangoPathTraversalFlow::PathNode sink\nwhere DjangoPathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"User-controlled data reaches filesystem path operation $@.\", source.getNode(), \"user input\"",
    "hypothesis": "User-controlled data may reach filesystem APIs in Django, leading to path traversal or arbitrary file access.",
    "severity": "high",
