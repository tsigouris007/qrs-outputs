    "codeql_raw_query": "/**\n * @name TOCTOU race condition in file operations\n * @description Checking file existence before operating on it can lead to race conditions\n * @kind problem\n * @problem.severity warning\n * @id py/toctou-file-access\n * @tags security\n *        external/cwe/cwe-367\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode existsCheck, DataFlow::CallCfgNode fileOp\nwhere\n  // Check for os.path.exists or os.path.isfile\n  (existsCheck = API::moduleImport(\"os\").getMember(\"path\").getMember([\"exists\", \"isfile\", \"isdir\"]).getACall() or\n   existsCheck = API::moduleImport(\"pathlib\").getMember(\"Path\").getReturn().getMember(\"exists\").getACall()) and\n  // Look for file operations like open, remove, rename\n  (fileOp = API::builtin(\"open\").getACall() or\n   fileOp = API::moduleImport(\"os\").getMember([\"remove\", \"unlink\", \"rename\", \"rmdir\"]).getACall() or\n   fileOp = API::moduleImport(\"shutil\").getMember([\"rmtree\", \"move\", \"copy\"]).getACall())\nselect existsCheck, \"Potential TOCTOU race condition: file existence check may be followed by file operation.\"\n",
    "hypothesis": "Time-of-check to time-of-use (TOCTOU) race conditions in file operations where existence is checked before use",
    "severity": "medium",
    "cwe_ids": [
