   {
    "codeql_query_uuid": "20261117191416",
    "codeql_raw_query": "/**\n * @name Path traversal vulnerability in file operations\n * @description File paths derived from external sources without validation can lead to path traversal\n * @kind path-problem\n * @problem.severity error\n * @id py/s3transfer-path-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Parameters that could be controlled by external input\n    exists(DataFlow::ParameterNode param |\n      source = param and\n      (\n        param.getParameter().getName().matches([\"%key%\", \"%filename%\", \"%path%\", \"%name%\"]) or\n        param.getParameter().getName() = [\"bucket\", \"extra_args\", \"callback\"]\n      )\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    // File system access operations\n    exists(FileSystemAccess fa |\n      sink = fa.getAPathArgument()\n    )\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from untrusted input $@.\", source.getNode(), \"user-controlled parameter\"\n",
    "hypothesis": "Path traversal in file operations - file paths from S3 keys or parameters may allow directory traversal attacks",
    "severity": "high",
    "cwe_ids": [
     "cwe-22"
    ],
    "results_count": 18,
