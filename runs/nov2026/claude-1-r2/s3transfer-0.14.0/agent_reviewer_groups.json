    "codeql_raw_query": "/**\n * @name Insecure file permissions\n * @description Creating files or directories with overly permissive permissions can expose sensitive data\n * @kind problem\n * @problem.severity warning\n * @id py/insecure-file-permissions\n * @tags security\n *        external/cwe/cwe-732\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    // os.chmod with overly permissive modes\n    call = API::moduleImport(\"os\").getMember(\"chmod\").getACall() or\n    // os.mkdir with mode argument\n    call = API::moduleImport(\"os\").getMember(\"mkdir\").getACall() or\n    // os.makedirs with mode argument\n    call = API::moduleImport(\"os\").getMember(\"makedirs\").getACall() or\n    // open with explicit mode parameter\n    call = API::builtin(\"open\").getACall() or\n    // os.open with mode flags\n    call = API::moduleImport(\"os\").getMember(\"open\").getACall()\n  )\nselect call, \"File or directory operation that may use insecure permissions.\"\n",
