    "codeql_raw_query": "/**\n * @name Arbitrary file read via open\n * @description Opening files with user-controlled paths without validation\n * @kind problem\n * @problem.severity warning\n * @id py/jsonschema-file-read\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::builtin(\"open\").getACall() or\n    call = API::moduleImport(\"pathlib\").getMember(\"Path\").getReturn().getMember([\"read_text\", \"read_bytes\", \"open\"]).getACall()\n  ) and\n  exists(call.getLocation().getFile().getRelativePath())\nselect call, \"File access operation that may be exploitable if path is user-controlled.\"\n",
