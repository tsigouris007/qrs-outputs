    "codeql_query_uuid": "20261118032848",
    "codeql_raw_query": "/**\n * @name Path traversal in CLI file operations\n * @description Opening files with user-controlled paths without validation can lead to path traversal\n * @kind path-problem\n * @problem.severity error\n * @id py/jsonschema-cli-path-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\nimport semmle.python.Concepts\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"argparse\").getMember(\"ArgumentParser\").getReturn().getMember(\"parse_args\").getACall() and\n      source = call\n    ) or\n    exists(DataFlow::AttrRead attr |\n      attr.getAttributeName() = \"instance\" and\n      source = attr\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::builtin(\"open\").getACall() and\n      sink = call.getArg(0)\n    ) or\n    sink = any(FileSystemAccess fa).getAPathArgument()\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink, DataFlow::CallCfgNode call\nwhere \n  PathTraversalFlow::flowPath(source, sink) and\n  call.getLocation().getFile().getBaseName() = \"cli.py\"\nselect sink.getNode(), source, sink, \"Path traversal from $@.\", source.getNode(), \"CLI argument\"",
    "hypothesis": "Path traversal in jsonschema CLI module when handling file paths from command-line arguments",
