   {
    "codeql_query_uuid": "20261118033947",
    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description User-controlled file paths in file operations without proper validation can lead to path traversal\n * @kind path-problem\n * @problem.severity error\n * @id py/s3transfer-path-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Parameters that could contain S3 keys or file paths\n    exists(DataFlow::ParameterNode param |\n      source = param and\n      (\n        param.getParameter().getName().matches([\"%key%\", \"%filename%\", \"%path%\", \"%name%\"]) or\n        param.getParameter().getName() in [\"bucket\", \"key\", \"filename\", \"extra_args\"]\n      )\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    // File system operations\n    exists(FileSystemAccess fsa |\n      sink = fsa.getAPathArgument()\n    )\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from $@.\", source.getNode(), \"user-controlled input\"",
    "hypothesis": "Path traversal vulnerability in file download/upload operations where user-controlled S3 keys could be used to write files outside intended directories",
    "severity": "high",
    "cwe_ids": [
     "cwe-22"
    ],
    "results_count": 18,
