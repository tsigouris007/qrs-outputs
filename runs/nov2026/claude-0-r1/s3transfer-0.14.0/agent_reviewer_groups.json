    "codeql_raw_query": "/**\n * @name Time-of-check time-of-use (TOCTOU) race condition\n * @description Checking file existence before opening can lead to race conditions\n * @kind problem\n * @problem.severity warning\n * @id py/s3transfer-toctou\n * @tags security\n *        external/cwe/cwe-367\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode check, DataFlow::CallCfgNode open_call\nwhere\n  (\n    check = API::moduleImport(\"os\").getMember(\"path\").getMember([\"exists\", \"isfile\", \"isdir\"]).getACall() or\n    check = API::moduleImport(\"os\").getMember([\"access\", \"stat\"]).getACall()\n  ) and\n  (\n    open_call = API::builtin(\"open\").getACall() or\n    open_call = API::moduleImport(\"os\").getMember(\"open\").getACall()\n  )\nselect check, \"File existence check that may lead to TOCTOU race condition if followed by file operation.\"\n",
    "hypothesis": "TOCTOU race conditions where file existence is checked before opening",
