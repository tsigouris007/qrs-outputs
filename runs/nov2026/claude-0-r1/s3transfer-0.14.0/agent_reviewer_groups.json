    "codeql_raw_query": "/**\n * @name Information disclosure via logging\n * @description Logging sensitive information can lead to information disclosure\n * @kind problem\n * @problem.severity warning\n * @id py/s3transfer-info-disclosure-logging\n * @tags security\n *        external/cwe/cwe-532\n *        external/cwe/cwe-200\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"logging\").getMember([\"debug\", \"info\", \"warning\", \"error\", \"critical\", \"log\"]).getACall() or\n    call = API::moduleImport(\"logging\").getMember(\"getLogger\").getReturn().getMember([\"debug\", \"info\", \"warning\", \"error\", \"critical\", \"log\"]).getACall()\n  ) and\n  exists(DataFlow::Node arg |\n    arg = call.getArg(_) and\n    (\n      arg.asExpr().(StringLiteral).getText().regexpMatch(\"(?i).*(password|secret|token|key|credential|auth).*\") or\n      exists(Name n | n = arg.asExpr() and n.getId().regexpMatch(\"(?i).*(password|secret|token|key|credential|auth).*\"))\n    )\n  )\nselect call, \"Potential logging of sensitive information.\"",
