    "codeql_raw_query": "/**\n * @name Missing size constraint validation\n * @description ASN.1 decoders should validate size constraints to prevent resource exhaustion\n * @kind problem\n * @problem.severity warning\n * @id py/missing-size-validation\n * @tags security\n *        external/cwe/cwe-1284\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call.getLocation().getFile().getRelativePath().matches(\"%decoder%\") and\n  (\n    // Calls to read or consume data\n    call.getFunction().asExpr().(Attribute).getName() in [\"read\", \"decode\", \"valueDecoder\", \"indefLenValueDecoder\"] or\n    // Slice operations that could be unbounded\n    call.asExpr() instanceof Subscript\n  )\nselect call, \"Data read operation that may lack size constraint validation\"\n",
    "hypothesis": "Missing size constraint validation in decoders could allow attackers to cause resource exhaustion",
