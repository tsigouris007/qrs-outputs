    "codeql_raw_query": "/**\n * @name Unbounded memory allocation in decoder\n * @description Decoders that allocate memory based on untrusted input without bounds checking can lead to DoS\n * @kind problem\n * @problem.severity error\n * @id py/unbounded-allocation\n * @tags security\n *        external/cwe/cwe-770\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  // Look for memory allocation patterns in decoder files\n  call.getLocation().getFile().getRelativePath().matches(\"%decoder%\") and\n  (\n    // bytearray or bytes allocation\n    call = API::builtin(\"bytearray\").getACall() or\n    call = API::builtin(\"bytes\").getACall() or\n    // list multiplication\n    call.asExpr().(BinaryExpr).getOp() instanceof Mult\n  )\nselect call, \"Potential unbounded memory allocation in decoder that could lead to DoS\"",
    "hypothesis": "Decoders may allocate memory based on untrusted input without proper bounds checking, leading to DoS",
