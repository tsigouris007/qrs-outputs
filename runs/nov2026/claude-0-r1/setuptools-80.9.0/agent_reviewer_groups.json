    "codeql_raw_query": "/**\n * @name Unsafe file write operations\n * @description Writing to files without proper path validation can lead to arbitrary file write\n * @kind problem\n * @problem.severity high\n * @id py/setuptools-unsafe-file-write\n * @tags security\n *        external/cwe/cwe-073\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::builtin(\"open\").getACall() and\n    exists(DataFlow::Node mode |\n      mode = call.getArg(1) or mode = call.getArgByName(\"mode\") |\n      mode.asExpr().(StrConst).getText().matches(\"%w%\")\n    )\n  )\n  and\n  not exists(string path |\n    call.getArg(0).asExpr().(StrConst).getText() = path and\n    (path.matches(\"/tmp/%\") or path.matches(\"/var/tmp/%\"))\n  )\nselect call, \"File write operation that may be vulnerable to path traversal.\"",
