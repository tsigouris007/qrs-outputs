    "codeql_raw_query": "/**\n * @name Unsafe archive extraction\n * @description Extracting archives without path validation can lead to path traversal\n * @kind problem\n * @problem.severity error\n * @id py/setuptools-unsafe-archive-extract\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"tarfile\").getMember([\"open\", \"TarFile\"]).getACall() or\n    call = API::moduleImport(\"zipfile\").getMember(\"ZipFile\").getACall()\n  ) and\n  exists(DataFlow::CallCfgNode extractCall |\n    extractCall.getFunction().(DataFlow::AttrRead).getAttributeName() in [\"extract\", \"extractall\"] and\n    call.getAMethodCall(\"extract\") = extractCall or\n    call.getAMethodCall(\"extractall\") = extractCall\n  )\nselect call, \"Archive extraction without path validation may allow path traversal attacks.\"",
    "hypothesis": "Archive extraction operations that don't validate member paths could allow path traversal attacks",
    "severity": "high",
