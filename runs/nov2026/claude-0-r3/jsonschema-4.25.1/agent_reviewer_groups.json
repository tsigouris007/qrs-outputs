   {
    "codeql_query_uuid": "20261118081536",
    "codeql_raw_query": "/**\n * @name Uncontrolled recursion\n * @description Recursive functions without depth limits can cause stack overflow\n * @kind problem\n * @problem.severity warning\n * @id py/jsonschema-uncontrolled-recursion\n * @tags security\n *        external/cwe/cwe-674\n *        external/cwe/cwe-400\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\npredicate isRecursiveFunction(Function f) {\n  exists(Call call |\n    call.getScope() = f and\n    call.getFunc().(Name).getId() = f.getName()\n  )\n}\n\npredicate hasDepthCheck(Function f) {\n  exists(If ifstmt, Compare cmp |\n    ifstmt.getScope() = f and\n    ifstmt.getTest() = cmp and\n    (\n      cmp.getOp(0) instanceof Gt or\n      cmp.getOp(0) instanceof GtE or\n      cmp.getOp(0) instanceof Lt or\n      cmp.getOp(0) instanceof LtE\n    )\n  )\n}\n\nfrom Function f\nwhere\n  isRecursiveFunction(f) and\n  not hasDepthCheck(f) and\n  f.getLocation().getFile().getRelativePath().matches(\"jsonschema/%\")\nselect f, \"Recursive function without apparent depth limit may cause stack overflow.\"\n",
    "hypothesis": "Uncontrolled recursion in schema validation could lead to stack overflow or resource exhaustion",
    "severity": "medium",
    "cwe_ids": [
     "cwe-674",
     "cwe-400"
    ],
    "results_count": 4,
