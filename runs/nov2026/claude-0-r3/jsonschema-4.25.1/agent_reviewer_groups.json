    "codeql_raw_query": "/**\n * @name Information disclosure through exception messages\n * @description Sensitive information in exception messages can leak implementation details\n * @kind problem\n * @problem.severity warning\n * @id py/jsonschema-info-disclosure\n * @tags security\n *        external/cwe/cwe-209\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string sensitiveInfo\nwhere\n  (\n    call = API::builtin(\"open\").getACall() or\n    call = API::moduleImport(\"os\").getMember(\"path\").getMember(\"exists\").getACall() or\n    call = API::moduleImport(\"pathlib\").getMember(\"Path\").getACall()\n  ) and\n  exists(DataFlow::Node errorHandler |\n    errorHandler.asCfgNode().getScope() = call.asCfgNode().getScope() and\n    sensitiveInfo = \"file path\"\n  )\nselect call, \"File operation that may disclose sensitive path information in error messages.\"\n",
