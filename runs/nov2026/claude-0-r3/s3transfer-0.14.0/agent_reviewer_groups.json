    "codeql_query_uuid": "20261118082405",
    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description User-controlled file paths flowing to file system operations without validation can lead to path traversal\n * @kind path-problem\n * @problem.severity error\n * @id py/s3transfer-path-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\nimport semmle.python.ApiGraphs\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Parameters that could contain user-controlled paths\n    exists(DataFlow::ParameterNode param |\n      source = param and\n      (\n        param.getParameter().getName() in [\"filename\", \"key\", \"path\", \"filepath\", \"destination\", \"source\", \"bucket_key\", \"extra_args\"]\n      )\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    // File system operations\n    exists(DataFlow::CallCfgNode call |\n      sink = call.getArg(_) and\n      (\n        call = API::moduleImport(\"os\").getMember([\"open\", \"remove\", \"unlink\", \"rename\", \"makedirs\", \"mkdir\"]).getACall() or\n        call = API::moduleImport(\"os\").getMember(\"path\").getMember([\"join\", \"exists\", \"isfile\", \"isdir\"]).getACall() or\n        call = API::builtin(\"open\").getACall()\n      )\n    )\n    or\n    sink = any(FileSystemAccess fa).getAPathArgument()\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from user-controlled $@.\", source.getNode(), \"file path\"\n",
    "hypothesis": "Path traversal vulnerability in file download/upload operations where user-controlled input flows to file system operations without proper sanitization",
    "severity": "high",
    "cwe_ids": [
     "cwe-22"
    ],
