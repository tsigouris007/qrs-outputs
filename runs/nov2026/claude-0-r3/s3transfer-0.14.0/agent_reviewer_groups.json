    "codeql_raw_query": "/**\n * @name Symlink following vulnerability\n * @description Following symlinks without validation can lead to unauthorized file access\n * @kind problem\n * @problem.severity warning\n * @id py/symlink-following\n * @tags security\n *        external/cwe/cwe-59\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"os\").getMember([\"remove\", \"unlink\", \"rmdir\", \"rename\", \"chmod\", \"chown\"]).getACall() or\n    call = API::moduleImport(\"shutil\").getMember([\"rmtree\", \"move\", \"copy\", \"copy2\", \"copyfile\"]).getACall() or\n    call.getFunction().asExpr().(Attribute).getName() in [\"write\", \"truncate\"]\n  ) and\n  not exists(DataFlow::CallCfgNode lstatCall |\n    lstatCall = API::moduleImport(\"os\").getMember(\"lstat\").getACall()\n  )\nselect call, \"File operation that may follow symlinks without validation.\"",
