    "codeql_raw_query": "/**\n * @name Use of weak cryptographic algorithm\n * @description Using weak or broken cryptographic algorithms can compromise security\n * @kind problem\n * @problem.severity warning\n * @id py/weak-crypto\n * @tags security\n *        external/cwe/cwe-327\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"hashlib\").getMember([\"md5\", \"sha1\"]).getACall() or\n    call = API::moduleImport(\"Crypto\").getMember(\"Hash\").getMember([\"MD5\", \"SHA1\"]).getACall() or\n    call = API::moduleImport(\"random\").getMember([\"random\", \"randint\", \"choice\", \"shuffle\"]).getACall()\n  )\nselect call, \"Use of weak cryptographic algorithm or insecure random number generator.\"\n",
    "hypothesis": "Check for use of weak cryptographic algorithms (MD5, SHA1) or insecure random number generation that could be used for security-sensitive operations",
