    "codeql_raw_query": "/**\n * @name Regular Expression Denial of Service (ReDoS)\n * @description Regular expressions with exponential worst-case complexity can lead to denial of service\n * @kind problem\n * @problem.severity warning\n * @id py/numpy-redos\n * @tags security\n *        external/cwe/cwe-1333\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, Expr pattern\nwhere\n  (\n    call = API::moduleImport(\"re\").getMember([\"compile\", \"match\", \"search\", \"findall\", \"finditer\", \"sub\", \"subn\", \"split\"]).getACall() and\n    pattern = call.getArg(0).asExpr()\n  ) and\n  exists(StrConst s | s = pattern |\n    // Check for nested quantifiers or alternation that could cause exponential backtracking\n    s.getText().regexpMatch(\".*[(].*[*+].*[)][*+].*\") or\n    s.getText().regexpMatch(\".*[(].*[|].*[)][*+].*\")\n  )\nselect call, \"Regular expression may be vulnerable to ReDoS attacks due to nested quantifiers.\"",
