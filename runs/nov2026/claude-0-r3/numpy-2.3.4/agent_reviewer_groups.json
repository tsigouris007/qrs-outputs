    "codeql_raw_query": "/**\n * @name Hardcoded credentials\n * @description Hardcoded credentials in source code can be exploited by attackers\n * @kind problem\n * @problem.severity warning\n * @id py/numpy-hardcoded-credentials\n * @tags security\n *        external/cwe/cwe-798\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom Assign assign, StrConst str\nwhere\n  (\n    assign.getATarget().(Name).getId().toLowerCase().matches([\"%password%\", \"%passwd%\", \"%secret%\", \"%api_key%\", \"%apikey%\", \"%token%\", \"%credential%\"]) or\n    assign.getATarget().(Attribute).getName().toLowerCase().matches([\"%password%\", \"%passwd%\", \"%secret%\", \"%api_key%\", \"%apikey%\", \"%token%\", \"%credential%\"])\n  ) and\n  str = assign.getValue() and\n  str.getText().length() > 8 and\n  not str.getText().matches([\"\", \"password\", \"secret\", \"token\", \"%test%\", \"%example%\", \"%dummy%\", \"%TODO%\", \"%FIXME%\"])\nselect assign, \"Potential hardcoded credential found.\"",
