    "codeql_query_uuid": "20261117151422",
    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description File operations using unsanitized paths may allow path traversal attacks\n * @kind problem\n * @problem.severity error\n * @id py/s3transfer-path-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::builtin(\"open\").getACall() or\n    call = API::moduleImport(\"os\").getMember([\"makedirs\", \"mkdir\", \"remove\", \"unlink\", \"rename\"]).getACall() or\n    call = API::moduleImport(\"shutil\").getMember([\"copy\", \"copyfile\", \"move\", \"rmtree\"]).getACall()\n  ) and\n  // Check if the path argument lacks proper validation\n  exists(DataFlow::Node pathArg |\n    pathArg = call.getArg(0) and\n    not exists(DataFlow::CallCfgNode normCall |\n      normCall = API::moduleImport(\"os\").getMember(\"path\").getMember([\"abspath\", \"realpath\", \"normpath\"]).getACall() and\n      DataFlow::localFlow(normCall, pathArg)\n    )\n  )\nselect call, \"File operation without path normalization or validation.\"\n",
    "hypothesis": "Path traversal in file operations - detecting unsanitized paths used in file operations",
    "severity": "high",
    "cwe_ids": [
     "cwe-022"
    ],
