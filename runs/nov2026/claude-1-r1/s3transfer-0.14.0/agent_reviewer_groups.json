   {
    "codeql_query_uuid": "20261117151513",
    "codeql_raw_query": "/**\n * @name Path traversal from S3 keys to file operations\n * @description S3 object keys used in file paths without validation may allow directory traversal\n * @kind path-problem\n * @problem.severity error\n * @id py/s3transfer-key-path-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule KeyPathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Parameters that might receive S3 keys or filenames\n    exists(DataFlow::ParameterNode param |\n      param.getParameter().getName() in [\"key\", \"filename\", \"fileobj\", \"s3_key\", \"bucket_key\", \"extra_args\"] and\n      source = param\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::builtin(\"open\").getACall() and\n      sink = call.getArg(0)\n    )\n    or\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"os\").getMember([\"makedirs\", \"mkdir\", \"remove\", \"unlink\", \"rmdir\"]).getACall() and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule KeyPathTraversalFlow = TaintTracking::Global<KeyPathTraversalConfig>;\nimport KeyPathTraversalFlow::PathGraph\n\nfrom KeyPathTraversalFlow::PathNode source, KeyPathTraversalFlow::PathNode sink\nwhere KeyPathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal: S3 key parameter flows to file operation $@.\", source.getNode(), \"source\"",
    "hypothesis": "Path traversal via S3 object keys flowing into file operations without proper sanitization",
    "severity": "high",
