    "codeql_query_uuid": "20261122121239",
    "codeql_raw_query": "/**\n * @name Subprocess shell=True usage\n * @description Finds subprocess calls that enable the shell, which can lead to command injection if arguments are influenced by untrusted input.\n * @kind problem\n * @problem.severity warning\n * @id click/audit/subprocess-shell-true\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"subprocess\").getMember([\"Popen\", \"run\", \"call\", \"check_call\", \"check_output\"]).getACall() and\n  exists(DataFlow::Node arg |\n    arg = call.getArgByName(\"shell\") and\n    arg.asExpr().(Name).getId() = \"True\"\n  )\nselect call, \"subprocess call with shell=True\"\n",
    "hypothesis": "Subprocess calls with shell=True could enable command injection if command strings are influenced by untrusted input (e.g., env vars like EDITOR/VISUAL).",
