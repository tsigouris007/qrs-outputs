    "codeql_raw_query": "/**\n * @name Enumerate subprocess call sites\n * @description List all calls to subprocess module functions and os.system in the package\n * @kind problem\n * @problem.severity warning\n * @id click/audit/subprocess-calls\n */\n\nimport python\n\nfrom Call call, Attribute attr\nwhere\n  call.getFunc() = attr and\n  (\n    attr.getObject().(Name).getId() = \"subprocess\" and\n    attr.getName() in [\"Popen\", \"call\", \"run\", \"check_call\", \"check_output\", \"getoutput\", \"getstatusoutput\"]\n    or\n    attr.getObject().(Name).getId() = \"os\" and\n    attr.getName() in [\"system\", \"popen\", \"spawnl\", \"spawnlp\", \"spawnv\", \"spawnvp\", \"execl\", \"execlp\", \"execv\", \"execvp\"]\n  )\nselect call, \"Potential subprocess/command call: \" + attr.getName()\n",
