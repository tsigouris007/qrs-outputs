    "codeql_raw_query": "/**\n * @name Shell command execution via os.system/os.popen\n * @description Using os.system or os.popen invokes a shell and can lead to command injection\n * @kind problem\n * @problem.severity warning\n * @id np/os-shell-command\n * @tags security\n *        external/cwe/cwe-078\n */\n\nimport python\n\nfrom Call call, Attribute attr, Name modname\nwhere\n  call.getFunc() = attr and\n  attr.getObject() = modname and\n  modname.getId() = \"os\" and\n  attr.getName() in [\"system\", \"popen\"]\nselect call, \"Shell command execution via os.\" + attr.getName() + \".\"\n",
