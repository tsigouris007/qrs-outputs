    "codeql_query_uuid": "20261122145015",
    "codeql_raw_query": "/**\n * @name Unsafe deserialization in numpy runtime\n * @description Pickle load/loads calls in numpy runtime code (excluding build tooling) that may deserialize untrusted data\n * @kind problem\n * @problem.severity warning\n * @id np/unsafe-deserialization-runtime\n * @tags security\n *        external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call, string path\nwhere\n  (\n    call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall() or\n    call = API::moduleImport(\"_pickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall() or\n    call = API::moduleImport(\"numpy\").getMember(\"load\").getACall()\n  )\n  and path = call.getLocation().getFile().getRelativePath()\n  and not path.matches(\"vendored-meson/%\")\n  and not path.matches(\"tools/%\")\nselect call, \"Unsafe deserialization in numpy runtime file \" + path",
    "hypothesis": "Pickle-based deserialization occurs in numpy runtime modules and may process attacker-controlled serialized data",
    "severity": "high",
