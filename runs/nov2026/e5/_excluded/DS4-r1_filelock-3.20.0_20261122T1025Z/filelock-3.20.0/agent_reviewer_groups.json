    "codeql_raw_query": "/**\n * @name Dump fchmod/chmod calls\n * @description List chmod/fchmod call sites to check for insecure permission changes\n * @kind problem\n * @problem.severity note\n * @id py/dump-chmod\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"os\").getMember(\"fchmod\").getACall() or\n  call = API::moduleImport(\"os\").getMember(\"chmod\").getACall()\nselect call, \"chmod call: \" + call.toString()\n",
