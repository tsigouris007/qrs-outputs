    "codeql_raw_query": "/**\n * @name Dump os.open flags variable definitions\n * @description Show RHS of assignments to flags/open_flags variables used with os.open\n * @kind problem\n * @problem.severity warning\n * @id py/dump-flags-def\n * @tags debug\n */\n\nimport python\n\nfrom Assign a, Name lhs, Expr rhs\nwhere\n  a.getATarget() = lhs and\n  a.getValue() = rhs and\n  (lhs.getId() = \"flags\" or lhs.getId() = \"open_flags\" or lhs.getId() = \"open_mode\")\nselect a, lhs.getId() + \" = \" + rhs.toString()\n",
