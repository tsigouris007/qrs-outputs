    "codeql_query_uuid": "20261122091905",
    "codeql_raw_query": "/**\n * @name Dump chmod/fchmod calls and modes\n * @description Show chmod family calls and their mode arguments\n * @kind problem\n * @problem.severity warning\n * @id py/dump-chmod-args\n * @tags debug\n */\n\nimport python\n\nfrom Call call, Attribute a\nwhere\n  call.getFunc() = a and\n  a.getName() in [\"chmod\", \"fchmod\", \"lchmod\"]\nselect call, a.getName() + \" mode arg=\" + call.getArg(1).toString()\n",
