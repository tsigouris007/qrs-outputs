   "codeql_raw_query": "/**\n * @name Outgoing network and URL requests\n * @description Check usage of requests and urllib for potential SSRF or local file inclusion via file:// URLs\n * @kind problem\n * @problem.severity high\n * @id py/ssrf-url-resolution\n * @tags security\n *       external/cwe/cwe-918\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"requests\").getMember([\"get\", \"post\", \"put\", \"delete\", \"head\", \"request\", \"Session\"]).getACall() or\n  call = API::moduleImport(\"urllib\").getMember(\"request\").getMember([\"urlopen\", \"Request\", \"urlretrieve\"]).getACall()\nselect call, \"URL request at \" + call.getLocation().getFile().getRelativePath() + \":\" + call.getLocation().getStartLine().toString()\n",
