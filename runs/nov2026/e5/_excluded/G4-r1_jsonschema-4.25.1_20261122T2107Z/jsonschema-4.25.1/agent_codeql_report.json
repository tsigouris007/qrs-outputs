   "codeql_query_uuid": "20261122224951",
   "codeql_raw_query": "/**\n * @name Inspect HTTP/URL resolution context in validators.py\n * @description Examine functions and arguments used in URL resolution within jsonschema/validators.py\n * @kind problem\n * @problem.severity warning\n * @id py/inspect-ssrf-validators\n * @tags security\n *        external/cwe/cwe-918\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, Function f\nwhere\n  (\n    call = API::moduleImport(\"requests\").getMember([\"get\", \"request\", \"post\", \"head\"]).getACall() or\n    call = API::moduleImport(\"urllib\").getMember(\"request\").getMember([\"urlopen\", \"urlretrieve\", \"Request\"]).getACall()\n  ) and\n  call.getLocation().getFile().getShortName() = \"validators.py\" and\n  f = call.getScope()\nselect call, \"In function '\" + f.getName() + \"' (lines \" + f.getLocation().getStartLine().toString() + \"-\" + f.getLocation().getEndLine().toString() + \"), call to \" + call.asExpr().toString() + \" with arg0=\" + call.getArg(0).asExpr().toString()\n",
