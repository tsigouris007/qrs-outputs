   "codeql_raw_query": "/**\n * @name Callers and references to remote retrieval functions\n * @description Find all uses of _warn_for_remote_retrieve and resolve_remote to check if SSRF/local file read via file:// URI is reachable by default\n * @kind problem\n * @problem.severity warning\n * @id py/ssrf-callers\n * @tags security\n *        external/cwe/cwe-918\n *        external/cwe/cwe-022\n */\n\nimport python\n\nfrom AstNode n\nwhere\n  (\n    n.(Name).getId() in [\"_warn_for_remote_retrieve\", \"resolve_remote\", \"RefResolver\", \"_REMOTE_WARNING\"] or\n    n.(Attribute).getAttr() in [\"_warn_for_remote_retrieve\", \"resolve_remote\"]\n  ) and\n  n.getLocation().getFile().getShortName() != \"noxfile.py\"\nselect n, \"Reference to \" + n.toString() + \" in \" + n.getScope().toString() + \" at line \" + n.getLocation().getStartLine().toString()\n",
