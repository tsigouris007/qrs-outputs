    "codeql_raw_query": "/**\n * @name Temp file and risky calls\n * @kind problem\n * @problem.severity warning\n * @id py/click-tmp2\n */\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string n\nwhere\n  (call = API::moduleImport(\"tempfile\").getMember([\"mktemp\",\"mkstemp\",\"NamedTemporaryFile\"]).getACall() and n = \"tempfile\") or\n  (call = API::moduleImport(\"os\").getMember([\"system\",\"popen\"]).getACall() and n = \"os-cmd\") or\n  (call = API::builtin([\"eval\",\"exec\"]).getACall() and n = \"eval\") or\n  (call = API::moduleImport(\"importlib\").getMember(\"import_module\").getACall() and n = \"import\")\nselect call, n",
