    "codeql_raw_query": "/**\n * @name Risky calls\n * @kind problem\n * @problem.severity warning\n * @id py/risky-calls\n */\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string k\nwhere\n  (call = API::moduleImport(\"tarfile\").getMember(\"open\").getReturn().getMember([\"extractall\",\"extract\"]).getACall() and k = \"tar-extract\") or\n  (call = API::moduleImport(\"zipfile\").getMember(\"ZipFile\").getReturn().getMember([\"extractall\",\"extract\"]).getACall() and k = \"zip-extract\") or\n  (call = API::moduleImport(\"os\").getMember(\"system\").getACall() and k = \"os.system\") or\n  (call = API::moduleImport(\"subprocess\").getMember([\"Popen\",\"run\",\"call\",\"check_call\",\"check_output\"]).getACall() and\n    call.getArgByName(\"shell\").asExpr().(ImmutableLiteral).booleanValue() = true and k = \"shell=True\") or\n  (call = API::moduleImport(\"urllib\").getMember(\"request\").getMember(\"urlopen\").getACall() and k = \"urlopen\") or\n  (call = API::builtin([\"eval\",\"exec\"]).getACall() and k = \"eval/exec\")\nselect call, k",
