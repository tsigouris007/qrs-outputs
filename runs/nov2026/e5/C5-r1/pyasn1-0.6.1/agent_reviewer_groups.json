    "codeql_query_uuid": "20261123002705",
    "codeql_raw_query": "/**\n * @name While loops with shift/accumulate in decoder\n * @kind problem\n * @problem.severity warning\n * @id py/decoder-unbounded-accum\n */\nimport python\n\nfrom While w, AugAssign a\nwhere w.getLocation().getFile().getShortName() = \"decoder.py\"\n  and a.getScope() = w.getScope()\n  and a.getLocation().getStartLine() > w.getLocation().getStartLine()\n  and a.getLocation().getStartLine() < w.getLocation().getStartLine() + 25\n  and (a.getOperation().getOp() instanceof LShift or a.getOperation().getOp() instanceof Add or a.getOperation().getOp() instanceof Mult)\nselect a, \"Accumulation in loop at line \" + w.getLocation().getStartLine().toString() + \": \" + a.toString()",
    "hypothesis": "Unbounded integer/OID accumulation in decoder loops (DoS)",
