   "codeql_raw_query": "/**\n * @name Datasource path handling\n * @kind problem\n * @problem.severity warning\n * @id py/np-datasource-paths\n */\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string kind\nwhere\n  call.getLocation().getFile().getRelativePath().matches(\"numpy/lib/_datasource.py\") and\n  (\n    call = API::moduleImport(\"shutil\").getMember(\"copyfileobj\").getACall() and kind = \"copyfileobj\" or\n    call = API::moduleImport(\"urllib\").getMember(\"request\").getMember(\"urlopen\").getACall() and kind = \"urlopen\" or\n    call = API::moduleImport(\"os\").getMember(\"makedirs\").getACall() and kind = \"makedirs\" or\n    call = API::moduleImport(\"os\").getMember(\"path\").getMember(\"join\").getACall() and kind = \"join\" or\n    call = API::moduleImport(\"os\").getMember(\"path\").getMember(\"splitdrive\").getACall() and kind = \"splitdrive\"\n  )\nselect call, kind",
