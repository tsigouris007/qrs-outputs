    "codeql_raw_query": "/**\n * @name Insecure temp file / shell=True / unverified ssl\n * @kind problem\n * @problem.severity warning\n * @id py/np-misc\n */\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string msg\nwhere\n  (\n    call = API::moduleImport(\"tempfile\").getMember(\"mktemp\").getACall() and msg = \"mktemp\"\n    or\n    call = API::moduleImport(\"subprocess\").getMember([\"run\",\"Popen\",\"call\",\"check_output\",\"check_call\"]).getACall() and\n    call.getArgByName(\"shell\").asExpr().(ImmutableLiteral).booleanValue() = true and msg = \"shell=True\"\n    or\n    call = API::moduleImport(\"os\").getMember([\"system\",\"popen\"]).getACall() and msg = \"os.system/popen\"\n  ) and call.getLocation().getFile().getRelativePath().matches(\"numpy/%\")\n  and not call.getLocation().getFile().getRelativePath().matches(\"numpy/%/tests/%\")\nselect call, msg",
