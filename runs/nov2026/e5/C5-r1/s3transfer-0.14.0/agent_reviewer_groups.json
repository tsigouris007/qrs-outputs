    "codeql_raw_query": "/**\n * @name Dangerous calls\n * @kind problem\n * @problem.severity warning\n * @id py/dangerous-calls\n */\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string kind\nwhere\n  (call = API::builtin([\"eval\",\"exec\",\"compile\",\"__import__\"]).getACall() and kind = \"code-exec\") or\n  (call = API::moduleImport(\"os\").getMember([\"system\",\"popen\",\"chmod\",\"mkdir\",\"makedirs\",\"umask\",\"remove\",\"rename\",\"replace\"]).getACall() and kind = \"os\") or\n  (call = API::moduleImport(\"subprocess\").getMember([\"run\",\"Popen\",\"call\",\"check_output\",\"check_call\"]).getACall() and kind = \"subprocess\") or\n  (call = API::moduleImport(\"tempfile\").getMember([\"mktemp\"]).getACall() and kind = \"mktemp\") or\n  (call = API::moduleImport(\"pickle\").getMember([\"load\",\"loads\"]).getACall() and kind = \"pickle\") or\n  (call = API::moduleImport(\"random\").getMember([\"random\",\"randint\",\"choice\"]).getACall() and kind = \"random\") or\n  (call = API::moduleImport(\"multiprocessing\").getAMember().getACall() and kind = \"mp\") or\n  (call = API::moduleImport(\"socket\").getMember([\"socket\"]).getACall() and kind = \"socket\")\nselect call, kind + \": \" + call.getLocation().getFile().getRelativePath()",
