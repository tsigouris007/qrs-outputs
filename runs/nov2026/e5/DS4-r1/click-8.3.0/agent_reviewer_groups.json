    "codeql_query_uuid": "20261122185245",
    "codeql_raw_query": "/**\n * @name List subprocess calls with shell flag\n * @description Enumerate subprocess invocations and their shell keyword argument\n * @kind problem\n * @problem.severity warning\n * @id click/subprocess-calls\n * @tags security\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string name\nwhere\n  call = API::moduleImport(\"subprocess\").getMember(name).getACall() and\n  name in [\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]\nselect call,\n  \"subprocess.\" + name + \" at \" + call.getLocation().getFile().getRelativePath() + \":\" + call.getLocation().getStartLine().toString() +\n  \" cmd=\" + call.getArg(0).toString() +\n  \" shell=\" + call.getArgByName(\"shell\").toString()\n",
    "hypothesis": "Identify subprocess invocations and shell usage for potential command injection",
