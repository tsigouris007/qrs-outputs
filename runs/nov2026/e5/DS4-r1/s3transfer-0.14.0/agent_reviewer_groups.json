    "codeql_query_uuid": "20261122201742",
    "codeql_raw_query": "/**\n * @name Temp file and permission sinks overview\n * @description Find tempfile creation, chmod, and os.open/rename calls\n * @kind problem\n * @problem.severity warning\n * @id py/s3transfer-tempfile-overview\n */\n\nimport python\n\nfrom Call call\nwhere\n  call.getFunc().(Attribute).getName() in [\n    \"mkstemp\", \"mkdtemp\", \"NamedTemporaryFile\", \"TemporaryFile\",\n    \"chmod\", \"chown\", \"rename\", \"replace\", \"link\", \"symlink\", \"unlink\"\n  ]\n  or call.getFunc().(Name).getId() in [\"chmod\", \"chown\", \"rename\", \"replace\", \"link\", \"symlink\", \"unlink\", \"mkstemp\", \"mkdtemp\"]\nselect call, \"sink \" + call.getFunc().toString() + \" at \" + call.getLocation().getFile().getRelativePath() + \":\" + call.getLocation().getStartLine().toString()\n",
