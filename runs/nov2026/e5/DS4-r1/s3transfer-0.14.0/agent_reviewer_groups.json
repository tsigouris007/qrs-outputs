    "codeql_query_uuid": "20261122201242",
    "codeql_raw_query": "/**\n * @name Map dangerous sinks overview\n * @description Find calls to dangerous functions like pickle, eval, exec, subprocess, os.system, yaml load\n * @kind problem\n * @problem.severity warning\n * @id py/s3transfer-dangerous-sinks-overview\n * @tags security\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call, string kind\nwhere\n  (\n    call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall() and kind = \"pickle.load\"\n    or\n    call = API::moduleImport(\"yaml\").getMember([\"load\", \"unsafe_load\"]).getACall() and kind = \"yaml.unsafe_load\"\n    or\n    call = API::moduleImport(\"marshal\").getMember([\"load\", \"loads\"]).getACall() and kind = \"marshal.load\"\n    or\n    call = API::builtin(\"eval\").getACall() and kind = \"eval\"\n    or\n    call = API::builtin(\"exec\").getACall() and kind = \"exec\"\n    or\n    call = API::moduleImport(\"subprocess\").getMember([\"Popen\", \"call\", \"check_call\", \"check_output\", \"run\"]).getACall() and kind = \"subprocess\"\n    or\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\", \"spawnl\", \"spawnle\", \"spawnlp\", \"spawnlpe\", \"spawnv\", \"spawnve\", \"spawnvp\", \"spawnvpe\", \"execl\", \"execle\", \"execlp\", \"execlpe\", \"execv\", \"execve\", \"execvp\", \"execvpe\"]).getACall() and kind = \"os.command\"\n    or\n    call = API::moduleImport(\"os\").getMember(\"remove\").getACall() and kind = \"os.remove\"\n    or\n    call = API::moduleImport(\"tempfile\").getMember(\"mktemp\").getACall() and kind = \"tempfile.mktemp\"\n    or\n    call = API::builtin(\"open\").getACall() and kind = \"open\"\n  )\nselect call, \"Dangerous sink \" + kind + \" at \" + call.getLocation().getFile().getRelativePath()\n",
    "hypothesis": "Overview of dangerous sinks present in the package to prioritize deeper taint analysis",
