    "codeql_query_uuid": "20261122215319",
    "codeql_raw_query": "/**\n * @name File, symlink, permission, and temporary file operations\n * @description Audit tempfile, shutil, stat, and file system calls for TOCTOU, symlink attacks, or insecure permissions\n * @kind problem\n * @problem.severity warning\n * @id py/file-temp-symlink-audit\n * @tags security\n *       external/cwe/cwe-377\n *       external/cwe/cwe-059\n *       external/cwe/cwe-367\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string modName, string funcName\nwhere\n  modName in [\"tempfile\", \"shutil\", \"stat\", \"os\"] and\n  call = API::moduleImport(modName).getMember(funcName).getACall() and\n  not (modName = \"os\" and funcName in [\"environ\", \"getcwd\", \"fspath\"])\n  or\n  (modName = \"builtins\" and funcName = \"open\" and call = API::builtin(\"open\").getACall())\n  or\n  (modName = \"os.path\" and call = API::moduleImport(\"os\").getMember(\"path\").getMember(funcName).getACall())\nselect call, modName + \".\" + funcName + \" in \" + call.getScope().getName()\n",
