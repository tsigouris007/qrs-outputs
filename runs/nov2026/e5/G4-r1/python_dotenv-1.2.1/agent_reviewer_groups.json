 "critical_sometimes_high": {
  "findings": [
   {
    "codeql_query_uuid": "20261122215249",
    "codeql_raw_query": "/**\n * @name Check command execution details and code execution\n * @description Inspect arguments to Popen, os.exec*, and any eval/exec/compile calls\n * @kind problem\n * @problem.severity warning\n * @id py/cmd-and-code-exec-details\n * @tags security\n *       external/cwe/cwe-078\n *       external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.Concepts\n\nfrom DataFlow::CallCfgNode call, Function f, string info\nwhere\n  call.getScope() = f and\n  (\n    exists(SystemCommandExecution cmd |\n      call = cmd and\n      (\n        if exists(call.getArgByName(\"shell\"))\n        then info = \"Cmd exec in \" + f.getName() + \" with shell=\" + call.getArgByName(\"shell\").asExpr().toString() + \" arg0=\" + call.getArg(0).asExpr().toString()\n        else info = \"Cmd exec in \" + f.getName() + \" (no shell kwarg) arg0=\" + call.getArg(0).asExpr().toString()\n      )\n    )\n    or\n    call = API::builtin([\"eval\", \"exec\", \"compile\", \"__import__\"]).getACall() and\n    info = \"Builtin code exec in \" + f.getName()\n  )\nselect call, info\n",
    "hypothesis": "Check whether subprocess.Popen or os.exec* use shell=True or untrusted arguments, and check for dynamic code execution primitives.",
