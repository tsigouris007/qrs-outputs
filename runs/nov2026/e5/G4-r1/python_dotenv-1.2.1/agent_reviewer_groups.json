    "codeql_query_uuid": "20261122215221",
    "codeql_raw_query": "/**\n * @name Command and process execution audit\n * @description Finds calls to subprocess or os process execution functions\n * @kind problem\n * @problem.severity warning\n * @id py/command-execution-audit\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.Concepts\n\nfrom DataFlow::CallCfgNode call, string detail\nwhere\n  (\n    call = API::moduleImport(\"subprocess\").getMember([\"Popen\", \"run\", \"call\", \"check_call\", \"check_output\"]).getACall() and\n    detail = \"subprocess call: \" + call.asExpr().toString()\n  )\n  or\n  (\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\", \"execl\", \"execle\", \"execlp\", \"execlpe\", \"execv\", \"execve\", \"execvp\", \"execvpe\", \"spawnl\", \"spawnle\", \"spawnlp\", \"spawnlpe\", \"spawnv\", \"spawnve\", \"spawnvp\", \"spawnvpe\"]).getACall() and\n    detail = \"os exec/system call: \" + call.asExpr().toString()\n  )\n  or\n  (\n    exists(SystemCommandExecution sce | call = sce and detail = \"SystemCommandExecution: \" + call.asExpr().toString())\n  )\nselect call, detail\n",
    "hypothesis": "Check how subprocess or os process execution APIs are used, especially whether shell=True or untrusted arguments are passed in cli.py or main.py",
    "severity": "critical",
