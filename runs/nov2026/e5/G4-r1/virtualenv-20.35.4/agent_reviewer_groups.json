    "codeql_raw_query": "/**\n * @name Subprocess and OS command execution\n * @description Detects all subprocess and OS command executions, especially checking shell=True or dynamic command args\n * @kind problem\n * @problem.severity warning\n * @id py/command-execution-audit\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.Concepts\n\nfrom DataFlow::CallCfgNode call, string detail\nwhere\n  (\n    call = API::moduleImport(\"subprocess\").getMember([\"Popen\", \"run\", \"call\", \"check_call\", \"check_output\"]).getACall() and\n    (\n      if exists(call.getArgByName(\"shell\"))\n      then detail = \"subprocess call with shell=\" + call.getArgByName(\"shell\").asExpr().toString()\n      else detail = \"subprocess call without shell arg: \" + call.getArg(0).asExpr().toString()\n    )\n  )\n  or\n  (\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\", \"spawnl\", \"spawnle\", \"spawnlp\", \"spawnlpe\", \"spawnv\", \"spawnve\", \"spawnvp\", \"spawnvpe\", \"execl\", \"execle\", \"execlp\", \"execlpe\", \"execv\", \"execve\", \"execvp\", \"execvpe\"]).getACall() and\n    detail = \"os command execution\"\n  )\nselect call, detail\n",
    "hypothesis": "Check for command injection via subprocess or os command execution functions, particularly with shell=True or untrusted arguments.",
