   "codeql_raw_query": "/**\n * @name Network request sinks in jsonschema\n * @description Identifies calls to requests or urllib that may lead to SSRF or local file disclosure via URI schemes\n * @kind problem\n * @problem.severity warning\n * @id py/network-request-sinks\n * @tags security\n *       external/cwe/cwe-918\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.Concepts\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"requests\").getMember([\"get\", \"post\", \"put\", \"delete\", \"request\", \" head\", \"Session\"]).getACall()\n  or\n  call = API::moduleImport(\"urllib\").getMember(\"request\").getMember([\"urlopen\", \"Request\", \"urlretrieve\"]).getACall()\n  or\n  call instanceof Http::Client::Request\nselect call, \"Network request call in \" + call.getLocation().getFile().getRelativePath() + \" at line \" + call.getLocation().getStartLine().toString()\n",
