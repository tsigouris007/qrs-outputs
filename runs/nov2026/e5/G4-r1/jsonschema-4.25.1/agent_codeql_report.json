   "codeql_raw_query": "/**\n * @name Inspect network request functions and callers in validators.py\n * @description Examine functions making network requests and where they are called or referenced\n * @kind problem\n * @problem.severity warning\n * @id py/inspect-ssrf-validators\n * @tags security\n *        external/cwe/cwe-918\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom Function func, DataFlow::CallCfgNode netCall\nwhere\n  (\n    netCall = API::moduleImport(\"requests\").getMember([\"get\", \"post\", \"request\", \"Session\"]).getACall() or\n    netCall = API::moduleImport(\"urllib\").getMember(\"request\").getMember([\"urlopen\", \"Request\", \"urlretrieve\"]).getACall()\n  ) and\n  netCall.getScope() = func\nselect netCall,\n  \"Function '\" + func.getName() + \"' (lines \" + func.getLocation().getStartLine().toString() + \"-\" +\n    func.getLocation().getEndLine().toString() + \") makes network call with arg0: \" +\n    netCall.getArg(0).asExpr().toString()\n",
