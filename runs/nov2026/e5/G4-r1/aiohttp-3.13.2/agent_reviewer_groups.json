    "codeql_raw_query": "/**\n * @name Dangerous sinks: deserialization, command execution, and code execution\n * @description Identifies calls to pickle, subprocess, os.system, eval, or exec\n * @kind problem\n * @problem.severity error\n * @id py/dangerous-sinks-audit\n * @tags security\n *       external/cwe/cwe-502\n *       external/cwe/cwe-078\n *       external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string category\nwhere\n  (\n    call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall() and\n    category = \"pickle deserialization\"\n  )\n  or\n  (\n    call = API::moduleImport(\"subprocess\").getMember([\"Popen\", \"run\", \"call\", \"check_call\", \"check_output\"]).getACall() and\n    category = \"subprocess execution\"\n  )\n  or\n  (\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall() and\n    category = \"os command execution\"\n  )\n  or\n  (\n    call = API::builtin([\"eval\", \"exec\", \"compile\"]).getACall() and\n    category = \"dynamic code execution\"\n  )\nselect call, \"Found \" + category + \" in \" + call.getLocation().getFile().getRelativePath() + \" inside \" + call.getScope().toString()\n",
    "hypothesis": "Check for unsafe deserialization (pickle), OS command execution (subprocess/os), and dynamic code execution (eval/exec) across aiohttp.",
