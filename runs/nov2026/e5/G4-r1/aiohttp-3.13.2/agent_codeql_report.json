   "codeql_raw_query": "/**\n * @name Path traversal in static file handling or request processing\n * @description Untrusted input flowing to filesystem operations can allow reading arbitrary files\n * @kind path-problem\n * @problem.severity error\n * @id py/path-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.Concepts\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof RemoteFlowSource or\n    exists(Function f |\n      f.getLocation().getFile().getRelativePath().regexpMatch(\"aiohttp/web_.*\\\\.py\") and\n      f.getName() in [\"_handle\", \"handle\", \"resolve\"] and\n      source.(DataFlow::ParameterNode).getParameter() = f.getAnArg()\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    sink = any(FileSystemAccess fa).getAPathArgument()\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from $@.\", source.getNode(), \"request input\"\n",
   "hypothesis": "Test for path traversal vulnerabilities where HTTP request inputs reach filesystem access sinks in aiohttp web handlers or static resource dispatchers.",
