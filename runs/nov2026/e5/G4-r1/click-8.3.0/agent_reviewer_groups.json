    "codeql_query_uuid": "20261122220936",
    "codeql_raw_query": "/**\n * @name Detailed audit of command execution calls and shell usage\n * @description Inspects arguments, keyword arguments, and enclosing functions of command execution calls\n * @kind problem\n * @problem.severity warning\n * @id py/click-command-exec-details\n * @tags security\n *        external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, Function f, string details\nwhere\n  (\n    call = API::moduleImport(\"subprocess\").getAMember().getACall() or\n    call = API::moduleImport(\"webbrowser\").getAMember().getACall()\n  ) and\n  call.getScope() = f and\n  details =\n    \"Func: \" + f.getName() + \" | Args: \" +\n      concat(int i, Expr arg |\n        arg = call.getArg(i).asExpr()\n      |\n        i.toString() + \"=\" + arg.toString() + \" (\" +\n          concat(Variable v | v.getAnAccess() = arg.getASubExpression*() | v.getId(), \",\") + \")\",\n        \"; \"\n      ) + \" | Kwargs: \" +\n      concat(string k, Expr kw |\n        kw = call.getArgByName(k).asExpr()\n      |\n        k + \"=\" + kw.toString(), \"; \"\n      )\nselect call, details\n",
    "hypothesis": "Inspect arguments, shell=True usage, and variable inputs to subprocess and webbrowser calls in _termui_impl.py and shell_completion.py.",
