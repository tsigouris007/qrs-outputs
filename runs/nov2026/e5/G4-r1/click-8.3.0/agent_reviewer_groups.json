    "codeql_query_uuid": "20261122221336",
    "codeql_raw_query": "/**\n * @name Dangerous dynamic execution, tempfile, and shell quoting audit\n * @description Audits dynamic execution, insecure temporary file usage, and shell string construction in Click\n * @kind problem\n * @problem.severity warning\n * @id py/click-security-sinks-audit\n * @tags security\n *       external/cwe/cwe-078\n *       external/cwe/cwe-094\n *       external/cwe/cwe-377\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string category\nwhere\n  (\n    call = API::builtin([\"eval\", \"exec\", \"compile\", \"__import__\"]).getACall() and\n    category = \"builtin-exec\"\n  )\n  or\n  (\n    call = API::moduleImport(\"importlib\").getMember(\"import_module\").getACall() and\n    category = \"importlib\"\n  )\n  or\n  (\n    call = API::moduleImport(\"tempfile\").getMember([\"mktemp\", \"NamedTemporaryFile\", \"mkstemp\", \"TemporaryDirectory\"]).getACall() and\n    category = \"tempfile\"\n  )\n  or\n  (\n    call = API::moduleImport(\"shlex\").getMember([\"quote\", \"split\"]).getACall() and\n    category = \"shlex\"\n  )\nselect call, category + \" in \" + call.getScope().getName() + \" at line \" + call.getLocation().getStartLine().toString()\n",
    "hypothesis": "Check all dynamic code execution, importlib usage, tempfile creation, and shlex quoting/splitting across click",
