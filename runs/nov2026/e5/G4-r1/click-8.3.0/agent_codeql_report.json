   "codeql_raw_query": "/**\n * @name Audit edit_files implementation\n * @description Inspect statements and expressions in edit_files around subprocess call with shell=True\n * @kind problem\n * @problem.severity warning\n * @id py/click-edit-files-audit\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\n\nfrom Stmt s, Function f\nwhere\n  f.getName() = \"edit_files\" and\n  s.getScope() = f and\n  s.getLocation().getStartLine() >= 575 and\n  s.getLocation().getStartLine() <= 620\nselect s,\n  \"L\" + s.getLocation().getStartLine().toString() + \" [\" + s.getAQlClass() + \"]: \" +\n    concat(Expr e |\n      e.getParent+() = s or e = s.(ExprStmt).getValue()\n    |\n      e.getAQlClass() + \"(\" +\n        concat(string v |\n          v = e.(Name).getId() or\n          v = e.(StrConst).getText() or\n          v = e.(Attribute).getName()\n        |\n          v, \",\"\n        ) + \")\",\n      \" | \"\n    )\n",
