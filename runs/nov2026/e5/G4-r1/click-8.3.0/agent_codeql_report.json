   "codeql_raw_query": "/**\n * @name Command execution calls\n * @description Audit all command and process execution calls in click for potential OS command injection\n * @kind problem\n * @problem.severity warning\n * @id py/click-command-exec-audit\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.Concepts\n\nfrom DataFlow::CallCfgNode call, string detail\nwhere\n  (\n    call = API::moduleImport(\"subprocess\").getMember([\"Popen\", \"run\", \"call\", \"check_call\", \"check_output\"]).getACall() and\n    detail = \"subprocess call: \" + call.asExpr().toString()\n  )\n  or\n  (\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\", \"execl\", \"execle\", \"execlp\", \"execlpe\", \"execv\", \"execve\", \"execvp\", \"execvpe\", \"spawnl\", \"spawnle\", \"spawnlp\", \"spawnlpe\", \"spawnv\", \"spawnve\", \"spawnvp\", \"spawnvpe\"]).getACall() and\n    detail = \"os exec/system call: \" + call.asExpr().toString()\n  )\n  or\n  (\n    call = API::moduleImport(\"webbrowser\").getMember([\"open\", \"open_new\", \"open_new_tab\"]).getACall() and\n    detail = \"webbrowser call: \" + call.asExpr().toString()\n  )\nselect call, detail + \" in \" + call.getLocation().getFile().getRelativePath() + \":\" + call.getLocation().getStartLine().toString()\n",
