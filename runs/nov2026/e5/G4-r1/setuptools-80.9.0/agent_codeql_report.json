   "codeql_raw_query": "/**\n * @name Command execution details in bdist_rpm and shell invocations\n * @description Inspect arguments passed to os.system, os.popen, and subprocess with shell\n * @kind problem\n * @problem.severity warning\n * @id py/command-args-inspection\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node arg0\nwhere\n  (\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall() and\n    arg0 = call.getArg(0)\n  )\n  or\n  (\n    call = API::moduleImport(\"subprocess\").getMember([\"Popen\", \"run\", \"call\", \"check_call\", \"check_output\"]).getACall() and\n    exists(call.getArgByName(\"shell\")) and\n    arg0 = call.getArg(0)\n  )\nselect call, \"Command call with arg: \" + arg0.asExpr().toString() + \" in function \" + call.getScope().toString()\n",
