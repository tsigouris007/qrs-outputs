   "codeql_raw_query": "/**\n * @name Command execution sinks in setuptools\n * @description Identifies calls to subprocess, os.system, os.popen, and distutils spawn\n * @kind problem\n * @problem.severity warning\n * @id py/command-execution-audit\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.Concepts\n\nfrom DataFlow::CallCfgNode call, string detail\nwhere\n  not call.getLocation().getFile().getRelativePath().matches(\"tools/%\") and\n  (\n    exists(SystemCommandExecution cmd | call = cmd and detail = \"SystemCommandExecution: \" + call.toString())\n    or\n    call = API::moduleImport(\"subprocess\").getMember([\"Popen\", \"run\", \"call\", \"check_call\", \"check_output\"]).getACall() and\n    detail = \"subprocess call\"\n    or\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\", \"spawnl\", \"spawnle\", \"spawnlp\", \"spawnlpe\", \"spawnv\", \"spawnve\", \"spawnvp\", \"spawnvpe\"]).getACall() and\n    detail = \"os command call\"\n  )\nselect call, detail + \" in \" + call.getLocation().getFile().getRelativePath() + \":\" + call.getLocation().getStartLine().toString()\n",
   "hypothesis": "Identify all OS command execution points in setuptools to check for command injection or unsafe shell=True usage",
