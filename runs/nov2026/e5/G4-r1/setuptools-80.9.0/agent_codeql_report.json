   "codeql_raw_query": "/**\n * @name Archive extraction calls\n * @description Audit tarfile/zipfile extraction and wheel/archive unpacking for path traversal (ZipSlip/TarSlip)\n * @kind problem\n * @problem.severity warning\n * @id py/archive-extract-calls\n * @tags security\n *       external/cwe/cwe-022\n *       external/cwe/cwe-073\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, Function f\nwhere\n  f = call.getScope() and\n  not f.getLocation().getFile().getRelativePath().matches(\"setuptools/_vendor/backports/tarfile/%\") and\n  (\n    call = API::moduleImport([\"tarfile\", \"zipfile\"]).getMember([\"open\", \"ZipFile\", \"TarFile\"]).getReturn().getMember([\"extract\", \"extractall\", \"_extract_member\"]).getACall() or\n    call = API::moduleImport(\"shutil\").getMember(\"unpack_archive\").getACall() or\n    call.asExpr().(Call).getFunc().(Attribute).getName() in [\"extract\", \"extractall\", \"_extract_member\", \"unpack_archive\"]\n  )\nselect call, \"Archive extraction call in \" + f.toString() + \" (\" + call.getLocation().getFile().getRelativePath() + \":\" + call.getLocation().getStartLine().toString() + \")\"\n",
