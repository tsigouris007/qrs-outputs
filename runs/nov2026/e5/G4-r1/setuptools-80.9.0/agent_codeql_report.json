   "codeql_raw_query": "/**\n * @name Code execution and deserialization audit\n * @description Find calls to eval, exec, compile, marshal, pickle\n * @kind problem\n * @problem.severity error\n * @id py/code-exec-deser\n * @tags security\n *       external/cwe/cwe-094\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin([\"eval\", \"exec\", \"compile\"]).getACall() or\n  call = API::moduleImport([\"marshal\", \"pickle\"]).getMember([\"load\", \"loads\"]).getACall()\nselect call, \"Dynamic execution or deserialization call\"\n",
