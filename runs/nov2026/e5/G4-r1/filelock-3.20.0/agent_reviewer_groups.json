    "codeql_raw_query": "/**\n * @name Missing O_NOFOLLOW in os.open\n * @description Opening lock files with O_CREAT without O_NOFOLLOW allows symlink attacks\n * @kind problem\n * @problem.severity high\n * @id py/missing-o-nofollow\n * @tags security\n *       external/cwe/cwe-059\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, Function f, string attrs\nwhere\n  call = API::moduleImport(\"os\").getMember(\"open\").getACall() and\n  call.getScope() = f and\n  attrs = concat(Attribute a | a.getScope() = f | a.getName(), \", \")\nselect call, \"os.open in \" + f.getLocation().getFile().getRelativePath() + \" uses attributes: \" + attrs\n",
