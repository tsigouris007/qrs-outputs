    "codeql_raw_query": "/**\n * @name Symlink vulnerability check in os.open calls\n * @description Check if os.open calls use O_CREAT without O_NOFOLLOW or O_EXCL, allowing symlink attacks\n * @kind problem\n * @problem.severity high\n * @id py/symlink-os-open-check\n * @tags security\n *       external/cwe/cwe-059\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, Function f\nwhere\n  call = API::moduleImport(\"os\").getMember(\"open\").getACall() and\n  call.getScope() = f\nselect call,\n  \"Function \" + f.getName() + \" calls os.open with arg0=\" + call.getArg(0).asExpr().toString() +\n  \", arg1=\" + call.getArg(1).asExpr().toString() +\n  \" (local defs in func: \" + concat(AssignStmt a, Expr target, Expr val | a.getScope() = f and target = a.getATarget() and val = a.getValue() | target.toString() + \"=\" + val.toString(), \"; \") + \")\"\n",
    "hypothesis": "Check if os.open in UnixFileLock, WindowsFileLock, or SoftFileLock uses O_CREAT without O_NOFOLLOW or O_EXCL, enabling symlink attacks (CWE-59).",
