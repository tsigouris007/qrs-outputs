    "codeql_raw_query": "/**\n * @name File open and os.open operations\n * @description Inspect file opening flags and permissions for symlink attacks or insecure permissions\n * @kind problem\n * @problem.severity warning\n * @id py/file-open-audit\n * @tags security\n *       external/cwe/cwe-059\n *       external/cwe/cwe-367\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"os\").getMember([\"open\", \"chmod\", \"unlink\", \"remove\", \"makedirs\", \"mkdir\"]).getACall() or\n  call = API::builtin(\"open\").getACall() or\n  call = API::moduleImport(\"pathlib\").getMember(\"Path\").getACall()\nselect call, \"File operation in \" + call.getLocation().getFile().getRelativePath() + \":\" + call.getLocation().getStartLine().toString() + \" -> \" + call.asExpr().toString()\n",
