   {
    "codeql_query_uuid": "20261122212113",
    "codeql_raw_query": "/**\n * @name Check bounds in BER OID, Tag, and Length continuation loops\n * @description Check if continuation loops in BER decoder enforce maximum length or shift bounds to prevent DoS\n * @kind problem\n * @problem.severity warning\n * @id py/ber-unbounded-continuation-loop\n * @tags security\n *        external/cwe/cwe-400\n */\n\nimport python\n\nfrom While w\nwhere\n  w.getLocation().getFile().getShortName() = \"decoder.py\" and\n  w.getLocation().getStartLine() in [421, 430, 479, 488, 547, 564, 1608] and\n  not exists(Compare cmp |\n    cmp.getParentNode+() = w and\n    exists(IntegerLiteral lim | lim = cmp.getAChildNode() and lim.getValue() > 128)\n  )\nselect w, \"Continuation loop in BER decoder at line \" + w.getLocation().getStartLine().toString() + \" lacks upper bound check on accumulated integer size or byte count.\"\n",
    "hypothesis": "Check whether BER continuation-byte decoding loops for OID sub-identifiers, high-tag-number tags, and Real exponents/mantissas enforce upper bounds on byte counts or integer bit-widths to prevent quadratic CPU/memory exhaustion (DoS).",
