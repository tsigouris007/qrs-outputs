    "codeql_raw_query": "/**\n * @name Potentially expensive arithmetic or shift operations in decoders and types\n * @description Large shifts, exponentiations, or multiplications on decoded values can cause CPU or memory exhaustion (DoS).\n * @kind problem\n * @problem.severity warning\n * @id py/expensive-arithmetic-dos\n * @tags security\n *        external/cwe/cwe-400\n */\n\nimport python\n\nfrom BinaryExpr expr\nwhere\n  (\n    expr.getOp() instanceof Pow or\n    expr.getOp() instanceof LShift\n  ) and\n  expr.getLocation().getFile().getRelativePath().regexpMatch(\"pyasn1/(codec|type)/.*\")\nselect expr,\n  \"Operation \" + expr.getOp().toString() + \" in \" + expr.getScope().getName() + \" (\" +\n    expr.getLeft().toString() + \" op \" + expr.getRight().toString() + \")\"\n",
