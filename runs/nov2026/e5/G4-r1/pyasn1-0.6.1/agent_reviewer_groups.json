    "codeql_query_uuid": "20261122211606",
    "codeql_raw_query": "/**\n * @name Inspect setattr, os, sys, and io calls\n * @description Inspects calls to setattr and os/sys/io functions with argument details\n * @kind problem\n * @problem.severity warning\n * @id py/inspect-sensitive-usage\n * @tags security\n *        external/cwe/cwe-915\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, Function enclosing, string info\nwhere\n  call.getScope() = enclosing and\n  (\n    exists(string fn |\n      fn in [\"setattr\", \"getattr\"] and\n      call = API::builtin(fn).getACall() and\n      info = fn + \" in \" + enclosing.getName() + \" arg1=\" + call.getArg(1).asExpr().toString()\n    )\n    or\n    exists(string mod, string member |\n      mod in [\"os\", \"sys\", \"io\"] and\n      call = API::moduleImport(mod).getMember(member).getACall() and\n      info = mod + \".\" + member + \" in \" + enclosing.getName()\n    )\n  )\nselect call, info\n",
    "hypothesis": "Inspect dynamic attribute modifications and OS/IO interactions to check if external input can influence object attributes or file/system state.",
