    "codeql_raw_query": "/**\n * @name Dangerous builtins and OS operations\n * @description Check for eval, exec, compile, __import__, os calls, open, setattr\n * @kind problem\n * @problem.severity warning\n * @id py/dangerous-calls\n * @tags security\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string name\nwhere\n  (\n    name = [\"eval\", \"exec\", \"compile\", \"__import__\", \"open\", \"setattr\", \"getattr\"] and\n    call = API::builtin(name).getACall()\n  )\n  or\n  exists(string member |\n    call = API::moduleImport(\"os\").getMember(member).getACall() and\n    name = \"os.\" + member\n  )\n  or\n  exists(string member |\n    call = API::moduleImport(\"os\").getMember(\"path\").getMember(member).getACall() and\n    name = \"os.path.\" + member\n  )\nselect call, \"Call to potentially sensitive API: \" + name",
