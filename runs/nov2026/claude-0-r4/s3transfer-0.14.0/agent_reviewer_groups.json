    "codeql_raw_query": "/**\n * @name Time-of-check time-of-use (TOCTOU) race condition\n * @description Checking file existence before opening can lead to race conditions\n * @kind problem\n * @problem.severity warning\n * @id py/toctou-race-condition\n * @tags security\n *        external/cwe/cwe-362\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode check, DataFlow::CallCfgNode fileOp\nwhere\n  (\n    check = API::moduleImport(\"os\").getMember(\"path\").getMember([\"exists\", \"isfile\", \"isdir\"]).getACall() or\n    check = API::moduleImport(\"os\").getMember([\"access\", \"stat\"]).getACall()\n  ) and\n  (\n    fileOp = API::builtin(\"open\").getACall() or\n    fileOp = API::moduleImport(\"os\").getMember([\"remove\", \"unlink\", \"rmdir\", \"rename\"]).getACall()\n  )\nselect check, \"File existence check that may lead to TOCTOU race condition if followed by file operation.\"\n",
