    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description File operations using user-controlled paths without proper validation can lead to path traversal\n * @kind path-problem\n * @problem.severity error\n * @id py/s3transfer-path-traversal\n * @tags security\n *        external/cwe/cwe-22\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\nimport semmle.python.ApiGraphs\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Parameters that could contain user-controlled paths\n    exists(DataFlow::ParameterNode param |\n      source = param and\n      (\n        param.getParameter().getName() in [\"filename\", \"key\", \"path\", \"filepath\", \n                                            \"destination\", \"dest\", \"source\", \"src\",\n                                            \"bucket\", \"extra_args\", \"fileobj\"]\n      )\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    // File system operations that could be vulnerable\n    sink = any(FileSystemAccess fa).getAPathArgument()\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from user-controlled $@.\", source.getNode(), \"parameter\"",
    "hypothesis": "Path traversal vulnerabilities in file operations where user-controlled paths flow to file system operations without validation",
