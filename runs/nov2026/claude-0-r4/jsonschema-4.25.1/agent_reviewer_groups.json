    "codeql_raw_query": "/**\n * @name HTTP requests with potentially untrusted URLs\n * @description HTTP requests using URLs from external sources\n * @kind problem\n * @problem.severity warning\n * @id py/http-request-untrusted\n * @tags security\n *        external/cwe/cwe-918\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"requests\").getMember([\"get\", \"post\", \"put\", \"delete\", \"patch\", \"head\", \"options\", \"request\"]).getACall() or\n    call = API::moduleImport(\"urllib\").getMember(\"request\").getMember([\"urlopen\", \"Request\"]).getACall()\n  )\nselect call, \"HTTP request that may be vulnerable to SSRF if URL is user-controlled.\"\n",
