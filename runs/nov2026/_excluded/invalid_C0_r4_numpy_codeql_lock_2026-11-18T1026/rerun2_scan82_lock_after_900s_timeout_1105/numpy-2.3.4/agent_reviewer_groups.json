    "codeql_raw_query": "/**\n * @name Unsafe deserialization with pickle\n * @description Using pickle.load/loads on untrusted data can lead to arbitrary code execution\n * @kind problem\n * @problem.severity error\n * @id py/numpy-unsafe-pickle\n * @tags security\n *        external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall() or\n    call = API::moduleImport(\"_pickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall() or\n    call = API::moduleImport(\"cPickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall()\n  )\nselect call, \"Potentially unsafe pickle deserialization that could execute arbitrary code.\"\n",
