   {
    "codeql_query_uuid": "20261118104928",
    "codeql_raw_query": "/**\n * @name Command injection via subprocess\n * @description Using subprocess with shell=True or unsanitized user input can lead to command injection\n * @kind path-problem\n * @problem.severity error\n * @id py/numpy-command-injection\n * @tags security\n *        external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.ApiGraphs\n\nmodule CommandInjectionConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // User-controlled input from various sources\n    source instanceof RemoteFlowSource or\n    // Function parameters that might be user-controlled\n    exists(DataFlow::ParameterNode param |\n      source = param and\n      not param.getParameter().getName() in [\"self\", \"cls\"]\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      // subprocess.call, subprocess.run, subprocess.Popen with shell=True\n      (\n        call = API::moduleImport(\"subprocess\").getMember([\"call\", \"run\", \"Popen\", \"check_call\", \"check_output\"]).getACall() and\n        exists(DataFlow::Node shellArg |\n          shellArg = call.getArgByName(\"shell\") and\n          shellArg.asExpr().(BooleanLiteral).booleanValue() = true\n        ) and\n        sink = call.getArg(0)\n      ) or\n      // os.system, os.popen\n      (\n        call = API::moduleImport(\"os\").getMember([\"system\", \"popen\", \"popen2\", \"popen3\", \"popen4\"]).getACall() and\n        sink = call.getArg(0)\n      )\n    )\n  }\n}\n\nmodule CommandInjectionFlow = TaintTracking::Global<CommandInjectionConfig>;\nimport CommandInjectionFlow::PathGraph\n\nfrom CommandInjectionFlow::PathNode source, CommandInjectionFlow::PathNode sink\nwhere CommandInjectionFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Command injection from $@.\", source.getNode(), \"user input\"",
    "hypothesis": "Command injection through subprocess calls with shell=True or os.system with user-controlled input",
    "severity": "critical",
    "cwe_ids": [
     "cwe-078"
    ],
    "results_count": 4,
