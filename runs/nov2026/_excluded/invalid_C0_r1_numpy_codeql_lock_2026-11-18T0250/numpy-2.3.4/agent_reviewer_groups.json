    "codeql_query_uuid": "20261118023938",
    "codeql_raw_query": "/**\n * @name Command injection via subprocess\n * @description Using subprocess with shell=True or unsanitized user input can lead to command injection\n * @kind problem\n * @problem.severity error\n * @id py/numpy-command-injection\n * @tags security\n *        external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    // subprocess.call/run/Popen with shell=True\n    call = API::moduleImport(\"subprocess\").getMember([\"call\", \"run\", \"Popen\", \"check_call\", \"check_output\"]).getACall() and\n    exists(DataFlow::Node shellArg |\n      shellArg = call.getArgByName(\"shell\") and\n      shellArg.asExpr().(BooleanLiteral).booleanValue() = true\n    )\n  ) or\n  (\n    // os.system, os.popen\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\", \"popen2\", \"popen3\", \"popen4\"]).getACall()\n  ) or\n  (\n    // os.spawn* family\n    call = API::moduleImport(\"os\").getMember([\"spawnl\", \"spawnle\", \"spawnlp\", \"spawnlpe\", \"spawnv\", \"spawnve\", \"spawnvp\", \"spawnvpe\"]).getACall()\n  )\nselect call, \"Potentially unsafe command execution that could allow command injection.\"\n",
    "hypothesis": "Check for command injection vulnerabilities through subprocess calls with shell=True or os.system usage",
    "severity": "critical",
    "cwe_ids": [
     "cwe-78"
    ],
