    "codeql_raw_query": "/**\n * @name Integer overflow in length calculations\n * @description Arithmetic operations on lengths without overflow checks could lead to memory corruption\n * @kind problem\n * @problem.severity warning\n * @id py/integer-overflow-length\n * @tags security\n *        external/cwe/cwe-190\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom BinaryExpr binop\nwhere\n  (binop.getOp() instanceof Add or binop.getOp() instanceof Mult or binop.getOp() instanceof Sub) and\n  exists(Name n | \n    n = binop.getAChildNode*() and\n    (n.getId().matches(\"%length%\") or \n     n.getId().matches(\"%size%\") or\n     n.getId().matches(\"%len%\") or\n     n.getId().matches(\"%count%\"))\n  ) and\n  // Focus on codec modules where this is most critical\n  binop.getLocation().getFile().getAbsolutePath().matches(\"%/codec/%\")\nselect binop, \"Arithmetic operation on length/size value without overflow protection in codec implementation.\"\n",
    "hypothesis": "Integer overflow or underflow in arithmetic operations on lengths, sizes, or indices that could lead to buffer overruns or memory corruption",
