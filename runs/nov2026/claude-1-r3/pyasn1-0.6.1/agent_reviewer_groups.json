   {
    "codeql_query_uuid": "20261117204921",
    "codeql_raw_query": "/**\n * @name Memory allocation based on decoded length without bounds check\n * @description Allocating memory based on length values from untrusted ASN.1 input without validation can lead to DoS\n * @kind problem\n * @problem.severity warning\n * @id py/asn1-memory-allocation-dos\n * @tags security\n *        external/cwe/cwe-770\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\npredicate isDecoderRead(DataFlow::CallCfgNode call) {\n  exists(string methodName |\n    methodName in [\"read\", \"recv\", \"getvalue\"] and\n    call.getFunction().(DataFlow::AttrRead).getAttributeName() = methodName\n  )\n}\n\nfrom DataFlow::CallCfgNode alloc, DataFlow::CallCfgNode read\nwhere\n  (\n    alloc.getFunction().(DataFlow::AttrRead).getAttributeName() in [\"read\", \"recv\"] or\n    alloc.getFunction().asCfgNode().(NameNode).getId() in [\"bytearray\", \"bytes\"]\n  ) and\n  isDecoderRead(read) and\n  alloc.getLocation().getFile().getRelativePath().matches(\"%decoder.py%\")\nselect alloc, \"Memory allocation in decoder that may be controlled by untrusted input length.\"",
    "hypothesis": "Memory allocation in decoders based on parsed length values without bounds checking",
    "severity": "high",
    "cwe_ids": [
     "cwe-770"
    ],
    "results_count": 3,
