 "medium_often_high": {
  "findings": [
   {
    "codeql_query_uuid": "20261117221236",
    "codeql_raw_query": "/**\n * @name Unbounded memory allocation\n * @description Memory allocations without size limits can lead to resource exhaustion\n * @kind problem\n * @problem.severity warning\n * @id py/s3transfer-unbounded-allocation\n * @tags security\n *        external/cwe/cwe-770\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    // Reading file content without size limit\n    call = API::builtin(\"open\").getACall().getReturn().getMember([\"read\", \"readlines\"]).getACall() and\n    not exists(call.getArg(0))\n  )\n  or\n  (\n    // BytesIO or StringIO reads without limits\n    call = API::moduleImport(\"io\").getMember([\"BytesIO\", \"StringIO\"]).getACall().getReturn().getMember(\"read\").getACall() and\n    not exists(call.getArg(0))\n  )\nselect call, \"Unbounded read operation that could lead to memory exhaustion.\"\n",
    "hypothesis": "Unbounded memory allocation in file or buffer reads",
    "severity": "medium",
    "cwe_ids": [
     "cwe-770"
    ],
