    "codeql_query_uuid": "20261117220950",
    "codeql_raw_query": "/**\n * @name Time-of-check time-of-use race condition in file operations\n * @description Checking file existence separately from file operations can lead to race conditions\n * @kind problem\n * @problem.severity warning\n * @id py/s3transfer-toctou\n * @tags security\n *        external/cwe/cwe-367\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode check, DataFlow::CallCfgNode use\nwhere\n  // File existence check\n  (\n    check = API::moduleImport(\"os\").getMember(\"path\").getMember([\"exists\", \"isfile\", \"isdir\"]).getACall() or\n    check = API::moduleImport(\"os\").getMember([\"stat\", \"access\"]).getACall()\n  ) and\n  // Followed by file operation\n  (\n    use = API::builtin(\"open\").getACall() or\n    use = API::moduleImport(\"os\").getMember([\"remove\", \"unlink\", \"rmdir\", \"mkdir\", \"makedirs\"]).getACall()\n  ) and\n  // Both in same function (approximate check)\n  check.getLocation().getFile() = use.getLocation().getFile()\nselect check, \"File existence check that may lead to TOCTOU race condition if followed by file operations.\"\n",
    "hypothesis": "Time-of-check time-of-use race conditions in file operations",
    "severity": "medium",
    "cwe_ids": [
     "cwe-367"
    ],
