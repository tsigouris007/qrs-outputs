    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description File paths derived from external input without proper validation can lead to path traversal\n * @kind path-problem\n * @problem.severity error\n * @id py/s3transfer-path-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Parameters that might contain S3 keys or filenames\n    exists(DataFlow::ParameterNode p |\n      p.getParameter().getName() in [\"key\", \"s3_key\", \"object_key\", \"filename\", \"extra_args\", \"bucket\", \"download_path\"] and\n      source = p\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(FileSystemAccess fa |\n      sink = fa.getAPathArgument()\n    )\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from $@.\", source.getNode(), \"untrusted input\"",
    "hypothesis": "Path traversal in file operations - file paths from parameters flow to file system operations without validation",
    "severity": "high",
    "cwe_ids": [
     "cwe-022"
    ],
