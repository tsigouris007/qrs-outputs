    "codeql_raw_query": "/**\n * @name S3 key manipulation vulnerability\n * @description S3 keys constructed from user input without validation may allow unauthorized access\n * @kind path-problem\n * @problem.severity high\n * @id py/s3transfer-s3-key-manipulation\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule S3KeyManipulationConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    exists(DataFlow::ParameterNode param |\n      source = param and\n      param.getParameter().getName() in [\"key\", \"s3_key\", \"object_key\", \"prefix\"]\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      (\n        call.getFunction().(DataFlow::AttrRead).getAttributeName() in [\"put_object\", \"get_object\", \"head_object\", \"delete_object\", \"copy_object\"] or\n        call.getFunction().(DataFlow::AttrRead).getAttributeName() in [\"upload_file\", \"download_file\", \"copy\"]\n      ) and\n      sink = call.getArg(_)\n    )\n  }\n}\n\nmodule S3KeyManipulationFlow = TaintTracking::Global<S3KeyManipulationConfig>;\nimport S3KeyManipulationFlow::PathGraph\n\nfrom S3KeyManipulationFlow::PathNode source, S3KeyManipulationFlow::PathNode sink\nwhere S3KeyManipulationFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"S3 key manipulation from $@.\", source.getNode(), \"user-controlled input\"",
    "hypothesis": "S3 keys constructed from user input without validation may allow unauthorized access to S3 objects",
