    "codeql_raw_query": "/**\n * @name TOCTOU race condition in file operations\n * @description Checking file existence followed by file operations can lead to race conditions\n * @kind problem\n * @problem.severity warning\n * @id py/s3transfer-toctou\n * @tags security\n *        external/cwe/cwe-362\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode check, DataFlow::CallCfgNode operation\nwhere\n  // File existence check\n  (\n    check = API::moduleImport(\"os\").getMember(\"path\").getMember([\"exists\", \"isfile\", \"isdir\"]).getACall() or\n    check = API::moduleImport(\"os\").getMember([\"access\", \"stat\"]).getACall()\n  ) and\n  // Followed by file operation\n  (\n    operation = API::builtin(\"open\").getACall() or\n    operation = API::moduleImport(\"os\").getMember([\"remove\", \"unlink\", \"rmdir\", \"rename\", \"mkdir\"]).getACall()\n  )\nselect check, \"File existence check that may lead to TOCTOU race condition with subsequent file operations.\"\n",
    "hypothesis": "TOCTOU race conditions where file existence is checked before file operations",
