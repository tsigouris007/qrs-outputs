    "codeql_raw_query": "/**\n * @name XML External Entity (XXE) vulnerability - unsafe XML parsing\n * @description XML parsing with resolve_entities enabled can lead to XXE attacks\n * @kind problem\n * @problem.severity error\n * @id py/xxe-unsafe-xml-parsing\n * @tags security\n *        external/cwe/cwe-611\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    // XMLParser with resolve_entities=True (default or explicit)\n    call = API::moduleImport(\"lxml\").getMember(\"etree\").getMember(\"XMLParser\").getACall() or\n    call = API::moduleImport(\"lxml\").getMember(\"etree\").getMember(\"ETCompatXMLParser\").getACall() or\n    // parse/fromstring/iterparse functions that might use unsafe parser\n    call = API::moduleImport(\"lxml\").getMember(\"etree\").getMember([\"parse\", \"fromstring\", \"XML\", \"iterparse\"]).getACall() or\n    call = API::moduleImport(\"lxml\").getMember(\"objectify\").getMember([\"parse\", \"fromstring\", \"XML\"]).getACall()\n  )\nselect call, \"Potentially unsafe XML parsing that may be vulnerable to XXE attacks. Consider using resolve_entities=False.\"\n",
    "hypothesis": "XXE vulnerabilities in XML parsing operations where resolve_entities is not explicitly disabled",
    "severity": "critical",
    "cwe_ids": [
     "cwe-611"
    ],
