    "codeql_raw_query": "/**\n * @name Subprocess with shell=True\n * @description Using subprocess with shell=True can lead to command injection\n * @kind problem\n * @problem.severity warning\n * @id py/unsafe-shell-command\n * @tags security\n *        external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"subprocess\").getMember([\"call\", \"run\", \"Popen\", \"check_call\", \"check_output\"]).getACall() and\n    exists(DataFlow::Node shell_arg |\n      shell_arg = call.getArgByName(\"shell\") and\n      shell_arg.asExpr().(BooleanLiteral).booleanValue() = true\n    )\n  ) or\n  (\n    call = API::moduleImport(\"os\").getMember(\"system\").getACall()\n  )\nselect call, \"Potentially unsafe subprocess/shell command execution that may be vulnerable to injection.\"",
