    "codeql_raw_query": "/**\n * @name Potential resource exhaustion via unbounded operations\n * @description Unbounded loops or recursive operations without proper limits can cause DoS\n * @kind problem\n * @problem.severity warning\n * @id py/unbounded-resource-consumption\n * @tags security\n *        external/cwe/cwe-400\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    // Looking for recursive calls or loops with user input\n    call = API::moduleImport(\"dateutil\").getMember(\"parser\").getMember(\"parse\").getACall() or\n    call = API::moduleImport(\"dateutil\").getMember(\"rrule\").getMember(\"rrule\").getACall()\n  )\nselect call, \"Date parsing or recurrence rule operations may consume excessive resources with malformed input.\"\n",
