    "codeql_query_uuid": "20251229103314",
    "codeql_raw_query": "/**\n * @name Regular Expression Denial of Service (ReDoS)\n * @description Complex regular expressions can cause exponential runtime with certain inputs\n * @kind problem\n * @problem.severity warning\n * @id py/pillow-redos\n * @tags security\n *        external/cwe/cwe-1333\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string pattern\nwhere\n  (\n    call = API::moduleImport(\"re\").getMember([\"compile\", \"match\", \"search\", \"findall\", \"finditer\", \"split\", \"sub\", \"subn\"]).getACall()\n    or\n    call = API::builtin(\"compile\").getACall()\n  ) and\n  exists(DataFlow::Node patternNode |\n    patternNode = call.getArg(0) and\n    patternNode.asExpr().(StrConst).getText() = pattern and\n    (\n      // Nested quantifiers\n      pattern.regexpMatch(\".*[*+]{2,}.*\") or\n      // Overlapping groups\n      pattern.regexpMatch(\".*\\\\(.*[*+].*\\\\).*[*+].*\") or\n      // Alternation with overlap\n      pattern.regexpMatch(\".*\\\\(.*\\\\|.*\\\\).*[*+].*\")\n    )\n  )\nselect call, \"Regular expression pattern may be vulnerable to ReDoS: \" + pattern",
    "hypothesis": "Regular expressions with nested quantifiers or overlapping groups can cause ReDoS",
    "severity": "medium",
    "cwe_ids": [
     "cwe-1333",
     "cwe-400"
    ],
    "results_count": 13,
