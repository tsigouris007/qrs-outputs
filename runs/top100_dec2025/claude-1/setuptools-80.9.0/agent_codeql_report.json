   "codeql_raw_query": "/**\n * @name Command injection via subprocess\n * @description Using subprocess with shell=True and untrusted input can lead to command injection\n * @kind problem\n * @problem.severity error\n * @id py/command-injection-subprocess\n * @tags security\n *        external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"subprocess\").getMember([\"call\", \"run\", \"Popen\", \"check_call\", \"check_output\"]).getACall() or\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\", \"popen2\", \"popen3\", \"popen4\"]).getACall()\n  )\nselect call, \"Potentially unsafe subprocess/command execution that could lead to command injection.\"",
