    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description Using unsanitized user input in file paths can allow attackers to access arbitrary files\n * @kind path-problem\n * @problem.severity error\n * @id py/path-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\nimport semmle.python.ApiGraphs\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    exists(API::Node argv |\n      argv = API::moduleImport(\"sys\").getMember(\"argv\") and\n      source = argv.getAValueReachableFromSource()\n    ) or\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"os\").getMember(\"getenv\").getACall() and\n      source = call\n    ) or\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"argparse\").getMember(\"ArgumentParser\").getReturn().getMember(\"parse_args\").getACall() and\n      source = call\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    sink = any(FileSystemAccess fsa).getAPathArgument()\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from $@.\", source.getNode(), \"user input\"",
    "hypothesis": "Path traversal through unsanitized user input in file operations",
    "severity": "high",
