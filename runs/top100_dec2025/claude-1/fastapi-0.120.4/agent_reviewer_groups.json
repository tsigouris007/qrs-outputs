    "codeql_query_uuid": "20251229052151",
    "codeql_raw_query": "/**\n * @name Hardcoded secrets\n * @description Hardcoded passwords, API keys, or other secrets in source code\n * @kind problem\n * @problem.severity warning\n * @id py/hardcoded-credentials\n * @tags security\n *        external/cwe/cwe-798\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom Assign assign, string var_name, StrConst secret_value\nwhere\n  exists(Name target |\n    target = assign.getATarget() and\n    var_name = target.getId() and\n    (\n      var_name.regexpMatch(\"(?i).*(password|passwd|pwd|secret|token|api[_-]?key|private[_-]?key|access[_-]?key).*\")\n    ) and\n    secret_value = assign.getValue() and\n    secret_value.getText().length() > 8 and\n    not secret_value.getText().regexpMatch(\"(?i).*(example|test|dummy|fake|placeholder|your_|insert_|change_me|todo).*\")\n  )\nselect assign, \"Potential hardcoded secret in variable '\" + var_name + \"'.\"",
    "hypothesis": "Hardcoded passwords, API keys, or other secrets in source code",
