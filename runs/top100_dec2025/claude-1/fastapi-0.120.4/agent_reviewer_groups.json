    "codeql_raw_query": "/**\n * @name Use of weak cryptographic algorithms\n * @description Using weak or broken cryptographic algorithms can compromise security\n * @kind problem\n * @problem.severity warning\n * @id py/weak-crypto\n * @tags security\n *        external/cwe/cwe-327\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"hashlib\").getMember([\"md5\", \"sha1\"]).getACall() or\n    call = API::moduleImport(\"random\").getMember([\"random\", \"randint\", \"choice\", \"randrange\"]).getACall() or\n    call = API::moduleImport(\"Crypto\").getMember(\"Cipher\").getMember([\"DES\", \"ARC2\", \"ARC4\", \"Blowfish\"]).getACall()\n  )\nselect call, \"Use of weak cryptographic algorithm or insecure random number generator.\"\n",
