    "codeql_raw_query": "/**\n * @name Use of weak cryptographic algorithm\n * @description Using weak cryptographic algorithms can compromise security\n * @kind problem\n * @problem.severity warning\n * @id py/weak-crypto\n * @tags security\n *        external/cwe/cwe-327\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"hashlib\").getMember([\"md5\", \"sha1\"]).getACall() or\n    call = API::moduleImport(\"Crypto\").getMember(\"Hash\").getMember([\"MD2\", \"MD4\", \"MD5\", \"SHA1\"]).getACall() or\n    call = API::moduleImport(\"Cryptodome\").getMember(\"Hash\").getMember([\"MD2\", \"MD4\", \"MD5\", \"SHA1\"]).getACall()\n  )\nselect call, \"Use of weak cryptographic algorithm that may be vulnerable to attacks.\"",
