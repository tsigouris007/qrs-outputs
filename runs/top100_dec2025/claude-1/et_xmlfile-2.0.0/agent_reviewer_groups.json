    "codeql_query_uuid": "20251229050733",
    "codeql_raw_query": "/**\n * @name Unsafe file write operations\n * @description Writing to files without proper path validation can lead to overwriting critical files\n * @kind problem\n * @problem.severity warning\n * @id py/unsafe-file-write\n * @tags security\n *        external/cwe/cwe-73\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::builtin(\"open\").getACall() and\n    exists(DataFlow::Node modeArg |\n      modeArg = call.getArg(1) or modeArg = call.getArgByName(\"mode\") |\n      modeArg.asExpr().(StrConst).getText().matches(\"%w%\")\n    )\n  ) or\n  call = API::moduleImport(\"io\").getMember(\"open\").getACall()\nselect call, \"File write operation that could be exploited to overwrite files if path is user-controlled.\"\n",
    "hypothesis": "Check for unsafe file write operations that might overwrite critical files without proper validation",
