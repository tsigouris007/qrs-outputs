    "codeql_raw_query": "/**\n * @name Open redirect via URL construction\n * @description URL construction that doesn't properly validate redirect targets can lead to open redirect vulnerabilities\n * @kind problem\n * @problem.severity warning\n * @id py/yarl-open-redirect\n * @tags security\n *        external/cwe/cwe-601\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    // Look for URL construction from string inputs\n    call = API::moduleImport(\"yarl\").getMember(\"URL\").getACall() or\n    // Look for URL join operations\n    exists(DataFlow::AttrRead attr |\n      attr.getAttributeName() = \"join\" and\n      call.getFunction() = attr\n    ) or\n    // Look for URL modification operations\n    exists(DataFlow::AttrRead attr |\n      attr.getAttributeName() in [\"with_scheme\", \"with_host\", \"with_path\", \"with_query\"] and\n      call.getFunction() = attr\n    )\n  )\nselect call, \"URL construction or modification that may lead to open redirect if user input is not validated.\"\n",
