    "codeql_raw_query": "/**\n * @name Improper URL encoding or decoding\n * @description URL encoding/decoding functions that may not properly handle special characters\n * @kind problem\n * @problem.severity warning\n * @id py/yarl-improper-encoding\n * @tags security\n *        external/cwe/cwe-116\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    // urllib.parse unquote functions\n    call = API::moduleImport(\"urllib\").getMember(\"parse\").getMember([\"unquote\", \"unquote_plus\", \"unquote_to_bytes\"]).getACall() or\n    // urllib.parse quote functions\n    call = API::moduleImport(\"urllib\").getMember(\"parse\").getMember([\"quote\", \"quote_plus\", \"quote_from_bytes\"]).getACall() or\n    // Direct string decode operations on URL-like strings\n    exists(DataFlow::AttrRead attr |\n      attr.getAttributeName() in [\"decode\", \"encode\"] and\n      call.getFunction() = attr\n    )\n  )\nselect call, \"URL encoding/decoding operation that may not properly sanitize special characters.\"",
