    "codeql_query_uuid": "20251229060733",
    "codeql_raw_query": "/**\n * @name Timing attack in cryptographic comparison\n * @description Direct comparison of secrets/tokens may leak information via timing side-channel\n * @kind problem\n * @problem.severity warning\n * @id py/timing-attack-comparison\n * @tags security\n *        external/cwe/cwe-208\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\n// Find direct comparisons (== or !=) of security-sensitive values\nfrom Compare cmp, ControlFlowNode left, ControlFlowNode right\nwhere\n  cmp.getASubExpression() = left.getNode() and\n  cmp.getASubExpression() = right.getNode() and\n  left != right and\n  (cmp.getOp(0) instanceof Eq or cmp.getOp(0) instanceof NotEq) and\n  exists(string varName |\n    (\n      left.getNode().(Name).getId() = varName or\n      right.getNode().(Name).getId() = varName\n    ) and\n    (\n      varName.regexpMatch(\".*(?i)(token|secret|key|signature|hash|password|digest|hmac|auth).*\")\n    )\n  )\nselect cmp, \"Direct comparison of security-sensitive value may be vulnerable to timing attacks.\"",
    "hypothesis": "Direct comparison of security-sensitive values (tokens, secrets, signatures) without constant-time comparison may leak information via timing side-channel attacks",
    "severity": "medium",
