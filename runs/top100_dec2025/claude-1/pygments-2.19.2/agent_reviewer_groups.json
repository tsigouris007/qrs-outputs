    "codeql_raw_query": "/**\n * @name Code execution via eval/exec\n * @description Using eval or exec can lead to arbitrary code execution\n * @kind problem\n * @problem.severity error\n * @id py/code-execution\n * @tags security\n *        external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::builtin(\"eval\").getACall() or\n    call = API::builtin(\"exec\").getACall() or\n    call = API::builtin(\"compile\").getACall()\n  )\nselect call, \"Use of \" + call.getFunction().asExpr().(Name).getId() + \" function may allow code execution.\"",
    "hypothesis": "Check for eval/exec/compile usage that could lead to code execution",
