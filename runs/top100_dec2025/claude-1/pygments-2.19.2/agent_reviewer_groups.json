    "codeql_query_uuid": "20251229131125",
    "codeql_raw_query": "/**\n * @name Arbitrary file write via user-controlled path\n * @description Writing to files where the path is controlled by user input can allow arbitrary file writes\n * @kind path-problem\n * @problem.severity error\n * @id py/arbitrary-file-write\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.Concepts\nimport semmle.python.ApiGraphs\n\nmodule FileWriteConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof RemoteFlowSource or\n    exists(DataFlow::Node argvAccess |\n      argvAccess = API::moduleImport(\"sys\").getMember(\"argv\").getAValueReachableFromSource() and\n      source = argvAccess\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(FileSystemWriteAccess write |\n      sink = write.getAPathArgument()\n    )\n  }\n}\n\nmodule FileWriteFlow = TaintTracking::Global<FileWriteConfig>;\nimport FileWriteFlow::PathGraph\n\nfrom FileWriteFlow::PathNode source, FileWriteFlow::PathNode sink\nwhere FileWriteFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"File write with path from $@.\", source.getNode(), \"user input\"",
    "hypothesis": "Check for arbitrary file write vulnerabilities where user input flows to file write operations",
    "severity": "high",
