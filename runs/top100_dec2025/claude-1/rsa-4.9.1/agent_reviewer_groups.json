    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description User-controlled file paths without validation can lead to path traversal attacks\n * @kind path-problem\n * @problem.severity error\n * @id py/path-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.RemoteFlowSources\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Match sys.argv access\n    exists(API::Node argv |\n      argv = API::moduleImport(\"sys\").getMember(\"argv\") and\n      source = argv.getASubscript().asSource()\n    )\n    or\n    // Also include remote flow sources\n    source instanceof RemoteFlowSource\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    // Match file operations using open()\n    sink = API::builtin(\"open\").getACall().getArg(0)\n    or\n    // Match FileSystemAccess sinks\n    sink = any(FileSystemAccess fa).getAPathArgument()\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"File path from command-line argument $@ used without validation.\", source.getNode(), \"here\"",
    "hypothesis": "User-controlled file paths from command-line arguments used in file operations without validation can lead to path traversal attacks",
