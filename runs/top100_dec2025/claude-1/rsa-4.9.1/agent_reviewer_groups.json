    "codeql_raw_query": "/**\n * @name Information disclosure through exception messages\n * @description Exception messages that reveal sensitive cryptographic information\n * @kind problem\n * @problem.severity warning\n * @id py/sensitive-info-in-exception\n * @tags security\n *        external/cwe/cwe-209\n */\n\nimport python\n\nfrom Raise raise, StrConst msg\nwhere\n  msg = raise.getException().(Call).getArg(0) and\n  (\n    msg.getText().regexpMatch(\".*\\\\b(key|private|secret|password|decrypt)\\\\b.*\") or\n    msg.getText().regexpMatch(\".*\\\\b(blinding|prime|exponent)\\\\b.*\")\n  )\nselect raise, \"Exception message may disclose sensitive cryptographic information.\"",
    "hypothesis": "Exception messages that reveal sensitive cryptographic information like keys, primes, or decryption details could aid attackers",
