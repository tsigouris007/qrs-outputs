    "codeql_raw_query": "/**\n * @name Subprocess calls with shell=True or string commands\n * @description Using subprocess with shell=True or string commands can be dangerous\n * @kind problem\n * @problem.severity warning\n * @id py/subprocess-shell-true\n * @tags security\n *        external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"subprocess\").getMember([\"call\", \"run\", \"Popen\", \"check_call\", \"check_output\"]).getACall() and\n    exists(DataFlow::Node arg |\n      arg = call.getArgByName(\"shell\") and\n      arg.asExpr().(BooleanLiteral).booleanValue() = true\n    )\n  ) or\n  (\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall()\n  )\nselect call, \"Potentially dangerous subprocess/system call that may enable command injection.\"\n",
