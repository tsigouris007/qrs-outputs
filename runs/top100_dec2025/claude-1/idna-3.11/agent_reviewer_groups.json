    "codeql_raw_query": "/**\n * @name Unicode normalization and validation issues in IDNA\n * @description Check for potential issues with Unicode normalization and IDNA validation\n * @kind problem\n * @problem.severity medium\n * @id py/idna-unicode-validation\n * @tags security\n *       external/cwe/cwe-176\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call, string issue\nwhere\n  (\n    // Check for unicodedata.normalize calls\n    exists(DataFlow::AttrRead attr |\n      attr = call.getFunction() and\n      attr.getAttributeName() = \"normalize\" and\n      issue = \"Unicode normalization that may allow homograph attacks\"\n    )\n    or\n    // Check for check_label or check_bidi functions\n    exists(DataFlow::Node func |\n      func = call.getFunction() and\n      (func.asExpr().(Name).getId() = \"check_label\" or \n       func.asExpr().(Name).getId() = \"check_bidi\" or\n       func.asExpr().(Name).getId() = \"check_nfc\" or\n       func.asExpr().(Name).getId() = \"check_hyphen_ok\") and\n      issue = \"IDNA validation function that may have bypass issues\"\n    )\n    or\n    // Check for calls to idnadata functions\n    exists(DataFlow::AttrRead attr |\n      attr = call.getFunction() and\n      attr.getObject().asExpr().(Name).getId() = \"idnadata\" and\n      issue = \"Access to IDNA character data for validation\"\n    )\n  )\nselect call, issue",
