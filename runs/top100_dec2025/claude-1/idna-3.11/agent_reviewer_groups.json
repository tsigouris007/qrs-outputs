    "codeql_raw_query": "/**\n * @name Length validation in IDNA processing\n * @description Check if encode/decode functions validate input length\n * @kind problem\n * @problem.severity warning\n * @id py/idna-length-validation\n * @tags security\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call, string funcName\nwhere\n  (\n    call.getFunction().(DataFlow::AttrRead).getAttributeName() in [\"encode\", \"decode\"] or\n    exists(Name n | n = call.getFunction().asExpr() and n.getId() in [\"encode\", \"decode\"])\n  ) and\n  funcName = call.getFunction().toString() and\n  exists(DataFlow::Node arg | arg = call.getArg(0))\nselect call, \"Call to \" + funcName + \" without visible length check\"",
