    "codeql_raw_query": "/**\n * @name Check regex patterns in core library files\n * @description Find regex patterns used in the core IDNA library code\n * @kind problem\n * @problem.severity warning\n * @id py/idna-core-regex-patterns\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string pattern\nwhere\n  (\n    call = API::moduleImport(\"re\").getMember([\"compile\", \"match\", \"search\", \"findall\", \"sub\"]).getACall()\n  ) and\n  call.getArg(0).asExpr().(StringLiteral).getText() = pattern and\n  (\n    call.getLocation().getFile().getBaseName() = \"codec.py\" or\n    call.getLocation().getFile().getBaseName() = \"core.py\"\n  )\nselect call, \"Regex pattern in core library: \" + pattern",
