    "codeql_query_uuid": "20251229070819",
    "codeql_raw_query": "/**\n * @name Detailed regex pattern analysis for potential ReDoS\n * @description Identifies regex patterns with potentially dangerous constructs like nested quantifiers\n * @kind problem\n * @problem.severity warning\n * @id py/regex-pattern-detail\n * @tags security\n *        external/cwe/cwe-1333\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom Expr regexPattern, string pattern\nwhere\n  exists(DataFlow::CallCfgNode call |\n    call = API::moduleImport(\"re\").getMember([\"compile\", \"match\", \"search\", \"findall\", \"finditer\", \"sub\", \"subn\"]).getACall() and\n    call.getArg(0).asExpr() = regexPattern and\n    regexPattern.(StrConst).getText() = pattern and\n    // Look for patterns with nested quantifiers or alternations that could be problematic\n    (\n      pattern.regexpMatch(\".*\\\\(.*[*+].*\\\\)[*+?].*\") or  // nested quantifiers\n      pattern.regexpMatch(\".*\\\\(.*\\\\|.*\\\\)[*+].*\") or    // alternation with quantifiers\n      pattern.regexpMatch(\".*(\\\\w+\\\\+){2,}.*\") or        // multiple consecutive + quantifiers\n      pattern.length() > 30                               // complex patterns\n    )\n  )\nselect regexPattern, \"Regex pattern that may be vulnerable to ReDoS: \" + pattern",
    "hypothesis": "Identify regex patterns with nested quantifiers or complex alternations that could be vulnerable to ReDoS attacks",
    "severity": "high",
    "cwe_ids": [
     "cwe-1333",
     "cwe-400"
    ],
    "results_count": 10,
