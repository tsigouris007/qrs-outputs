    "codeql_raw_query": "/**\n * @name Regular expression denial of service (ReDoS)\n * @description Regular expressions with exponential worst-case complexity can cause denial of service\n * @kind problem\n * @problem.severity warning\n * @id py/redos\n * @tags security\n *        external/cwe/cwe-1333\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node pattern\nwhere\n  (\n    call = API::moduleImport(\"re\").getMember([\"compile\", \"match\", \"search\", \"findall\", \"finditer\", \"sub\", \"subn\", \"split\"]).getACall() and\n    pattern = call.getArg(0)\n  )\nselect call, \"Regular expression usage that may be vulnerable to ReDoS attacks.\"",
