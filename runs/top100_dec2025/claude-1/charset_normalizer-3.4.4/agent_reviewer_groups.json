    "codeql_raw_query": "/**\n * @name Clear text logging of sensitive information\n * @description Logging potentially sensitive data without sanitization can lead to information disclosure\n * @kind problem\n * @problem.severity warning\n * @id py/clear-text-logging\n * @tags security\n *        external/cwe/cwe-532\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"logging\").getMember([\"debug\", \"info\", \"warning\", \"error\", \"critical\", \"exception\"]).getACall() or\n    call = API::moduleImport(\"logging\").getMember(\"Logger\").getMember([\"debug\", \"info\", \"warning\", \"error\", \"critical\", \"exception\"]).getACall() or\n    call = API::builtin(\"print\").getACall()\n  ) and\n  exists(call.getArg(_))\nselect call, \"Potential logging of sensitive information without sanitization.\"",
