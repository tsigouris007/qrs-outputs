    "codeql_raw_query": "/**\n * @name Unbounded loop or operation leading to DoS\n * @description Operations without size limits could lead to resource exhaustion\n * @kind problem\n * @problem.severity warning\n * @id py/unbounded-operation\n * @tags security\n *        external/cwe/cwe-400\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::Node node\nwhere\n  (\n    // Check for uses of sys.maxsize as a potential unbounded value\n    node = API::moduleImport(\"sys\").getMember(\"maxsize\").getAValueReachableFromSource() or\n    // Check for range/xrange calls without arguments (unbounded)\n    exists(DataFlow::CallCfgNode call |\n      call = API::builtin([\"range\", \"xrange\"]).getACall() and\n      not exists(call.getArg(0)) and\n      node = call\n    )\n  )\nselect node, \"Potentially unbounded operation that could lead to resource exhaustion.\"",
