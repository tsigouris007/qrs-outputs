    "codeql_raw_query": "/**\n * @name Regular Expression Denial of Service (ReDoS)\n * @description User-controlled regular expressions or patterns with exponential complexity\n * @kind problem\n * @problem.severity warning\n * @id py/pathspec-redos\n * @tags security\n *        external/cwe/cwe-1333\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"re\").getMember([\"compile\", \"match\", \"search\", \"findall\", \"finditer\"]).getACall() or\n    call = API::moduleImport(\"re\").getMember(\"Pattern\").getMember([\"match\", \"search\", \"findall\", \"finditer\"]).getACall()\n  ) and\n  exists(DataFlow::Node pattern |\n    pattern = call.getArg(0) and\n    not exists(StrConst s | s = pattern.asExpr())\n  )\nselect call, \"Regular expression operation with potentially user-controlled pattern may be vulnerable to ReDoS.\"",
    "hypothesis": "Check for regular expressions with user-controlled patterns that could lead to ReDoS attacks",
