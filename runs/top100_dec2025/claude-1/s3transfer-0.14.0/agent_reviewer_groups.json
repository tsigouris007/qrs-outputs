    "codeql_query_uuid": "20251229144617",
    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description File operations with unsanitized user input may allow path traversal attacks\n * @kind path-problem\n * @problem.severity error\n * @id py/path-traversal-s3transfer\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.Concepts\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof RemoteFlowSource or\n    exists(DataFlow::ParameterNode param |\n      source = param and\n      param.getParameter().getName() in [\"filename\", \"key\", \"path\", \"bucket_key\", \"source\", \"destination\"]\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    sink = any(FileSystemAccess fa).getAPathArgument()\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from $@.\", source.getNode(), \"user-controlled input\"",
    "hypothesis": "File operations with unsanitized user input may allow path traversal attacks, especially for parameters like filename, key, path that control file system access",
    "severity": "critical",
    "cwe_ids": [
     "cwe-022"
    ],
