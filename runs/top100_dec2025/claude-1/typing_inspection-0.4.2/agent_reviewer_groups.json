    "codeql_raw_query": "/**\n * @name Code injection via exec with taint flow\n * @description Using exec with untrusted input can lead to arbitrary code execution\n * @kind path-problem\n * @problem.severity error\n * @id py/exec-taint-flow\n * @tags security\n *        external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\n\nmodule ExecTaintConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Any parameter to a function could be untrusted\n    source instanceof DataFlow::ParameterNode or\n    // Any attribute access could be untrusted\n    source.asExpr() instanceof Attribute\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call.getFunction().asExpr().(Name).getId() in [\"exec\", \"eval\"] and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule ExecTaintFlow = TaintTracking::Global<ExecTaintConfig>;\nimport ExecTaintFlow::PathGraph\n\nfrom ExecTaintFlow::PathNode source, ExecTaintFlow::PathNode sink\nwhere ExecTaintFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Exec with potentially untrusted input from $@.\", source.getNode(), \"here\"",
    "hypothesis": "Check if exec calls have taint flow from parameters or attributes that could be controlled by users",
