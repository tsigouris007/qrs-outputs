    "codeql_raw_query": "/**\n * @name Command injection in numpy core\n * @description Command execution with shell=True or os.system in numpy core modules\n * @kind problem\n * @problem.severity error\n * @id py/numpy-command-injection\n * @tags security\n *        external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"os\").getMember(\"system\").getACall() or\n    call = API::moduleImport(\"subprocess\").getMember([\"call\", \"run\", \"Popen\"]).getACall()\n  ) and\n  call.getLocation().getFile().getRelativePath().matches(\"numpy/%\") and\n  not call.getLocation().getFile().getRelativePath().matches(\"numpy/distutils/%\") and\n  not call.getLocation().getFile().getRelativePath().matches(\"vendored-meson/%\")\nselect call, \"Potentially unsafe command execution in numpy core module.\"",
