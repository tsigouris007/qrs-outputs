    "codeql_raw_query": "/**\n * @name XML external entity (XXE) injection\n * @description Parsing XML with external entity processing enabled can lead to XXE attacks\n * @kind problem\n * @problem.severity error\n * @id py/xxe-injection\n * @tags security\n *        external/cwe/cwe-611\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"xml\").getMember(\"etree\").getMember([\"parse\", \"fromstring\", \"XMLParser\"]).getACall() or\n    call = API::moduleImport(\"xml\").getMember(\"sax\").getMember([\"parse\", \"parseString\", \"make_parser\"]).getACall() or\n    call = API::moduleImport(\"xml\").getMember(\"dom\").getMember(\"minidom\").getMember([\"parse\", \"parseString\"]).getACall() or\n    call = API::moduleImport(\"lxml\").getMember(\"etree\").getMember([\"parse\", \"fromstring\", \"XMLParser\"]).getACall()\n  )\nselect call, \"XML parsing without explicitly disabling external entity processing can lead to XXE attacks.\"",
