    "codeql_query_uuid": "20251229054733",
    "codeql_raw_query": "/**\n * @name Hardcoded credentials\n * @description Hardcoded passwords, tokens, or API keys in source code pose security risks\n * @kind problem\n * @problem.severity warning\n * @id py/hardcoded-credentials\n * @tags security\n *        external/cwe/cwe-798\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::Node assignment\nwhere\n  exists(string s |\n    assignment.asExpr().(StrConst).getText() = s and\n    (\n      s.regexpMatch(\"(?i).*(password|passwd|pwd|secret|token|api[_-]?key|auth).*\") and\n      s.length() > 8 and\n      not s.regexpMatch(\"(?i).*(example|test|dummy|placeholder|your_|TODO|FIXME).*\")\n    )\n  )\nselect assignment, \"Potential hardcoded credential or secret in source code.\"\n",
