   {
    "codeql_query_uuid": "20251224230830",
    "codeql_raw_query": "/**\n * @name Analyze pkgconfig.py usage\n * @description Examine pkg-config command usage for security issues\n * @kind problem\n * @problem.severity warning\n * @id py/pkgconfig-analysis\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call.getLocation().getFile().getRelativePath().matches(\"%pkgconfig%\") and\n  (\n    // Find subprocess calls\n    call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall() or\n    // Find os.system calls\n    call = API::builtin(\"system\").getACall() or\n    call = API::moduleImport(\"os\").getMember(\"system\").getACall() or\n    call = API::moduleImport(\"os\").getMember(\"popen\").getACall()\n  )\nselect call, \"Found pkg-config or system command call that could be vulnerable to command injection\"",
    "hypothesis": "Command injection in pkg-config calls",
    "severity": "high",
    "cwe_ids": [
     "cwe-078"
    ],
    "results_count": 1,
