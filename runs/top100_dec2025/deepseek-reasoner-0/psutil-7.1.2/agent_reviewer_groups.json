    "codeql_raw_query": "/**\n * @name Process manipulation vulnerabilities\n * @description Checking for unsafe process manipulation that could allow privilege escalation or DoS\n * @kind problem\n * @problem.severity high\n * @id py/process-manipulation\n * @tags security\n *        external/cwe/cwe-269\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"psutil\").getMember([\"Process\", \"kill\", \"terminate\", \"suspend\", \"resume\", \"send_signal\"]).getACall() or\n  call = API::moduleImport(\"os\").getMember([\"kill\", \"killpg\"]).getACall() or\n  call = API::moduleImport(\"signal\").getMember([\"signal\", \"siginterrupt\"]).getACall()\nselect call, \"Process manipulation call that could be used for privilege escalation or DoS if controlled by untrusted input\"",
