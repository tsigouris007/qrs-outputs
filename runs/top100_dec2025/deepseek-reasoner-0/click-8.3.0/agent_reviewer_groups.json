    "codeql_query_uuid": "20251226122637",
    "codeql_raw_query": "/**\n * @name Code execution patterns in click\n * @description Checking for dangerous patterns like eval, exec, subprocess calls\n * @kind problem\n * @problem.severity warning\n * @id py/dangerous-patterns\n * @tags security\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  // Check for eval/exec\n  call = API::builtin(\"eval\").getACall() or\n  call = API::builtin(\"exec\").getACall() or\n  call = API::builtin(\"compile\").getACall() or\n  // Check for subprocess calls\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"run\", \"Popen\", \"check_output\"]).getACall() or\n  call = API::moduleImport(\"os\").getMember(\"system\").getACall() or\n  call = API::moduleImport(\"os\").getMember(\"popen\").getACall()\nselect call, \"Potentially dangerous operation found\"",
    "hypothesis": "Click may contain dangerous operations like eval/exec or subprocess calls that could be vulnerable",
    "severity": "high",
    "cwe_ids": [
     "cwe-078",
     "cwe-094"
    ],
    "results_count": 8,
