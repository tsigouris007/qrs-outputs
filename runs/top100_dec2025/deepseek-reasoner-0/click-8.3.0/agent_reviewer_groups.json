   {
    "codeql_query_uuid": "20251226124151",
    "codeql_raw_query": "/**\n * @name Find subprocess calls in click\n * @description Locate all subprocess and os.system calls within click package\n * @kind problem\n * @problem.severity note\n * @id py/subprocess-locations\n * @tags security\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere \n  // Direct calls to subprocess functions\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"Popen\", \"run\", \"check_output\", \"check_call\"]).getACall() or\n  call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall() or\n  call = API::moduleImport(\"webbrowser\").getMember([\"open\", \"open_new\", \"open_new_tab\"]).getACall()\nselect call, \"External program execution call found\"",
    "hypothesis": "Finding subprocess calls that could lead to command injection if user input flows to them",
    "severity": "medium",
    "cwe_ids": [
     "cwe-078"
    ],
