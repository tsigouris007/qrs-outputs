    "codeql_query_uuid": "20251226124245",
    "codeql_raw_query": "/**\n * @name Examine subprocess calls in click\n * @description Examine subprocess calls to understand what arguments are used\n * @kind problem\n * @problem.severity note\n * @id py/examine-subprocess\n * @tags security\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::ExprNode arg\nwhere\n  // Find subprocess or os calls\n  (\n    call = API::moduleImport(\"subprocess\").getMember([\"call\", \"Popen\", \"run\", \"check_output\", \"check_call\"]).getACall() or\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall()\n  ) and\n  // Get first argument (command)\n  arg = call.getArg(0)\nselect arg, \"Subprocess command argument: \" + arg.toString()",
    "hypothesis": "Examine subprocess calls in click to understand if they use hardcoded or dynamic arguments",
    "severity": "low",
