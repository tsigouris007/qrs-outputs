    "codeql_raw_query": "/**\n * @name Missing CRLF validation in HTTP headers\n * @description HTTP header values should be validated to prevent CRLF injection\n * @kind problem\n * @problem.severity warning\n * @id py/missing-crlf-validation\n * @tags security\n *        external/cwe/cwe-113\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node arg\nwhere\n  // Look for string operations that might be used to construct headers\n  (\n    call.getFunction().(DataFlow::AttrRead).getAttributeName() in [\"encode\", \"format\", \"join\", \"__add__\"] or\n    call = API::builtin(\"bytes\").getACall()\n  ) and\n  arg = call.getArg(_) and\n  // Check if there's any validation for \\r or \\n nearby\n  not exists(DataFlow::CallCfgNode validation |\n    validation.getFunction().(DataFlow::AttrRead).getAttributeName() in [\"replace\", \"translate\", \"strip\"] and\n    DataFlow::localFlow(arg, validation.getArg(_))\n  )\nselect call, \"Potential header construction without CRLF validation at this location\"\n",
    "hypothesis": "Detect missing validation for CRLF characters in HTTP header values that could enable header injection or response splitting",
    "severity": "high",
    "cwe_ids": [
     "cwe-113",
     "cwe-93"
    ],
