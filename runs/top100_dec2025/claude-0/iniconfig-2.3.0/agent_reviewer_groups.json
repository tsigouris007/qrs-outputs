    "codeql_query_uuid": "20251213171345",
    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description Opening files with user-controlled paths without validation can lead to path traversal\n * @kind path-problem\n * @problem.severity error\n * @id py/path-traversal-iniconfig\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Parameters to functions that accept file paths\n    exists(DataFlow::ParameterNode param |\n      source = param and\n      param.getParameter().getName() in [\"filepath\", \"filename\", \"path\", \"file\"]\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    // File system access operations\n    sink = any(FileSystemAccess fsa).getAPathArgument()\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from user-controlled path $@.\", source.getNode(), \"parameter\"",
    "hypothesis": "Path traversal vulnerability when opening configuration files - checking if user-controlled paths are used with file operations without validation",
    "severity": "high",
