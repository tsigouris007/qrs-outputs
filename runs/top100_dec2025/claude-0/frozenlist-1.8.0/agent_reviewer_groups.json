    "codeql_query_uuid": "20251206011725",
    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description Detects file operations with potentially user-controlled paths that lack proper sanitization\n * @kind path-problem\n * @problem.severity warning\n * @id py/path-traversal\n * @tags security\n *       external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.Concepts\nimport semmle.python.ApiGraphs\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Parameters to functions (potential external input)\n    source instanceof DataFlow::ParameterNode\n    or\n    // Remote flow sources\n    source instanceof RemoteFlowSource\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    // File system access operations\n    exists(FileSystemAccess fsa |\n      sink = fsa.getAPathArgument()\n    )\n    or\n    // Direct calls to file operations\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"os\").getMember([\"remove\", \"unlink\", \"rmdir\", \"mkdir\", \"makedirs\", \"rename\", \"replace\"]).getACall() or\n      call = API::moduleImport(\"shutil\").getMember([\"copy\", \"copy2\", \"copytree\", \"move\", \"rmtree\"]).getACall() or\n      call = API::builtin(\"open\").getACall()\n      |\n      sink = call.getArg(_)\n    )\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from $@.\", source.getNode(), \"user-controlled input\"\n",
    "hypothesis": "Path traversal vulnerabilities in file operations where unsanitized paths could allow access to files outside intended directories",
    "severity": "high",
