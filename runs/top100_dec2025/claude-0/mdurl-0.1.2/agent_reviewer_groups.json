    "codeql_raw_query": "/**\n * @name URL component processing without validation\n * @description Functions that process URL components without proper validation may be vulnerable to injection attacks\n * @kind problem\n * @problem.severity warning\n * @id py/url-component-no-validation\n * @tags security\n *        external/cwe/cwe-020\n *        external/cwe/cwe-116\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call, Function func\nwhere\n  // Look for functions in mdurl that take string parameters\n  func.getEnclosingModule().getName().matches(\"mdurl%\") and\n  call.getFunction().asExpr().(Name).getId() = func.getName() and\n  // Functions that manipulate URLs\n  (\n    func.getName() in [\"parse\", \"decode\", \"encode\", \"format\"] or\n    func.getName().matches(\"%url%\") or\n    func.getName().matches(\"%decode%\") or\n    func.getName().matches(\"%encode%\")\n  ) and\n  // Has at least one argument\n  call.getArg(_) instanceof DataFlow::Node\nselect call, \"URL processing function '\" + func.getName() + \"' may not validate input properly.\"\n",
    "hypothesis": "Check for functions that process URL components without proper validation, which could lead to injection attacks or bypass security checks",
