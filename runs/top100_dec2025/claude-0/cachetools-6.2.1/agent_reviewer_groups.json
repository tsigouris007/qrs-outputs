    "codeql_query_uuid": "20251205203329",
    "codeql_raw_query": "/**\n * @name Race condition in cache operations\n * @description Non-atomic operations on shared cache state in multi-threaded context\n * @kind problem\n * @problem.severity warning\n * @id py/cachetools-race-condition\n * @tags security\n *       concurrency\n *       external/cwe/cwe-362\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\n// Find cache attribute accesses that are not protected by locks\nfrom Attribute attr, Name self\nwhere\n  attr.getObject() = self and\n  self.getId() = \"self\" and\n  (\n    attr.getName() = \"__data\" or\n    attr.getName() = \"__cache\" or\n    attr.getName() = \"__currsize\" or\n    attr.getName() = \"__size\" or\n    attr.getName() = \"__maxsize\"\n  ) and\n  // Check if this is in a method that doesn't use locking\n  exists(Function func |\n    attr.getScope() = func and\n    not exists(With w | w.getScope() = func and w.getContextExpr().(Attribute).getName() = \"__lock\")\n  )\nselect attr, \"Potential race condition: cache state access without lock protection\"\n",
    "hypothesis": "Race conditions in cache operations where non-atomic read-modify-write operations on shared cache state could lead to data corruption or inconsistent cache state in multi-threaded environments",
    "severity": "high",
