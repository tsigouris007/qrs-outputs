    "codeql_query_uuid": "20251205223436",
    "codeql_raw_query": "/**\n * @name Hardcoded Secrets\n * @description Detects hardcoded secrets, passwords, or API keys\n * @kind problem\n * @problem.severity warning\n * @id py/hardcoded-secrets\n * @tags security\n * @cwe CWE-798\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::Node node, string varName\nwhere\n  exists(Assign assign, Name target, StrConst value |\n    assign.getATarget() = target and\n    assign.getValue() = value and\n    node.asExpr() = value and\n    varName = target.getId() and\n    (\n      varName.toLowerCase().matches(\"%password%\") or\n      varName.toLowerCase().matches(\"%secret%\") or\n      varName.toLowerCase().matches(\"%api_key%\") or\n      varName.toLowerCase().matches(\"%apikey%\") or\n      varName.toLowerCase().matches(\"%token%\") or\n      varName.toLowerCase().matches(\"%auth%\")\n    ) and\n    value.getText().length() > 8 and\n    not value.getText().matches(\"%{%\") and\n    not value.getText().matches(\"%<%\") and\n    not value.getText().matches(\"%$%\")\n  )\nselect node, \"Potential hardcoded secret in variable '\" + varName + \"'\"",
    "hypothesis": "Detects hardcoded secrets, passwords, or API keys in variable assignments",
    "severity": "medium",
    "cwe_ids": [
     "CWE-798"
    ],
