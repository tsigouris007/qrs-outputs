    "codeql_raw_query": "/**\n * @name Weak Random Number Generation\n * @description Using random module instead of secrets for security-sensitive operations\n * @kind problem\n * @problem.severity warning\n * @id py/weak-random\n * @tags security\n * @cwe CWE-338\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"random\").getMember([\"random\", \"randint\", \"choice\", \"randrange\", \"shuffle\"]).getACall()\nselect call, \"Use of weak random number generator. Consider using 'secrets' module for security-sensitive operations.\"\n",
