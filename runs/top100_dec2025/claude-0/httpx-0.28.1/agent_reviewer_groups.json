    "codeql_query_uuid": "20251213163540",
    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description File operations with user-controlled paths can lead to path traversal\n * @kind problem\n * @problem.severity error\n * @id py/path-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::builtin(\"open\").getACall() or\n    call = API::moduleImport(\"pathlib\").getMember(\"Path\").getACall() or\n    call = API::moduleImport(\"os\").getMember([\"open\", \"remove\", \"unlink\", \"rmdir\"]).getACall() or\n    call = API::moduleImport(\"os\").getMember(\"path\").getMember([\"join\", \"exists\", \"isfile\"]).getACall()\n  )\nselect call, \"File operation that may be vulnerable to path traversal.\"",
    "hypothesis": "Path traversal via file operations with potentially untrusted paths",
