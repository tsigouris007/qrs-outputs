   "codeql_raw_query": "/**\n * @name URL injection via string concatenation\n * @description Building URLs through string concatenation with user input can lead to URL injection\n * @kind problem\n * @problem.severity warning\n * @id py/url-injection\n * @tags security\n *        external/cwe/cwe-918\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::Node urlConstruction\nwhere\n  exists(BinaryExpr binop |\n    binop.getOp() instanceof Add and\n    (\n      binop.getLeft().toString().matches(\"%http%\") or\n      binop.getRight().toString().matches(\"%http%\") or\n      binop.getLeft().toString().matches(\"%url%\") or\n      binop.getRight().toString().matches(\"%url%\")\n    ) and\n    urlConstruction.asExpr() = binop\n  )\nselect urlConstruction, \"URL construction via string concatenation may be vulnerable to injection.\"",
   "hypothesis": "URL injection through unsafe string concatenation when building URLs",
   "severity": "medium",
   "cwe_ids": [
    "cwe-918"
   ],
