   "codeql_raw_query": "/**\n * @name Disabled SSL certificate verification\n * @description Disabling SSL certificate verification can allow man-in-the-middle attacks\n * @kind problem\n * @problem.severity warning\n * @id py/disabled-cert-validation\n * @tags security\n *        external/cwe/cwe-295\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node arg\nwhere\n  (\n    call = API::moduleImport(\"httpx\").getMember([\"Client\", \"AsyncClient\", \"get\", \"post\", \"put\", \"delete\", \"patch\", \"head\", \"options\", \"request\"]).getACall() or\n    call = API::moduleImport(\"httpx\").getMember(\"Client\").getReturn().getMember([\"get\", \"post\", \"put\", \"delete\", \"patch\", \"head\", \"options\", \"request\"]).getACall() or\n    call = API::moduleImport(\"httpx\").getMember(\"AsyncClient\").getReturn().getMember([\"get\", \"post\", \"put\", \"delete\", \"patch\", \"head\", \"options\", \"request\"]).getACall()\n  ) and\n  arg = call.getArgByName(\"verify\") and\n  arg.asExpr().(BooleanLiteral).booleanValue() = false\nselect call, \"SSL certificate verification is explicitly disabled, which can allow man-in-the-middle attacks.\"",
   "hypothesis": "Check for explicit disabling of SSL certificate verification in httpx client calls",
   "severity": "high",
   "cwe_ids": [
    "cwe-295"
   ],
