   "codeql_query_uuid": "20251213164122",
   "codeql_raw_query": "/**\n * @name Sensitive data in logs\n * @description Logging sensitive information like passwords or tokens\n * @kind problem\n * @problem.severity warning\n * @id py/sensitive-data-logging\n * @tags security\n *        external/cwe/cwe-532\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node arg\nwhere\n  (\n    call = API::moduleImport(\"logging\").getMember([\"debug\", \"info\", \"warning\", \"error\", \"critical\", \"log\"]).getACall() or\n    call = API::builtin(\"print\").getACall()\n  ) and\n  arg = call.getArg(_) and\n  (\n    arg.asExpr().(Name).getId().toLowerCase().matches([\"%password%\", \"%token%\", \"%secret%\", \"%key%\", \"%auth%\"]) or\n    arg.asExpr().(Attribute).getName().toLowerCase().matches([\"%password%\", \"%token%\", \"%secret%\", \"%key%\", \"%auth%\"])\n  )\nselect call, \"Potential logging of sensitive information.\"",
