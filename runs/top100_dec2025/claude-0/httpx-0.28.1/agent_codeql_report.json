   "codeql_raw_query": "/**\n * @name Potential SSRF via unvalidated URL construction\n * @description HTTP requests with user-controlled URLs without proper validation can lead to SSRF\n * @kind problem\n * @problem.severity error\n * @id py/httpx-ssrf-unvalidated-url\n * @tags security\n *        external/cwe/cwe-918\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node urlArg\nwhere\n  // Find calls to httpx request methods\n  (\n    call = API::moduleImport(\"httpx\").getMember([\"get\", \"post\", \"put\", \"patch\", \"delete\", \"head\", \"options\", \"request\"]).getACall() or\n    call = API::moduleImport(\"httpx\").getMember([\"Client\", \"AsyncClient\"]).getReturn().getMember([\"get\", \"post\", \"put\", \"patch\", \"delete\", \"head\", \"options\", \"request\"]).getACall()\n  ) and\n  // Get the URL argument (first positional argument)\n  urlArg = call.getArg(0) and\n  // Check if it flows from a remote source\n  exists(RemoteFlowSource source | \n    DataFlow::localFlow(source, urlArg)\n  )\nselect call, \"HTTP request with potentially user-controlled URL may lead to SSRF vulnerabilities.\"\n",
   "hypothesis": "Check for SSRF vulnerabilities where user-controlled input flows directly to HTTP request URLs without validation",
