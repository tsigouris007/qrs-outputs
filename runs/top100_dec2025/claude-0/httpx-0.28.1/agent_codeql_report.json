   "codeql_raw_query": "/**\n * @name Path traversal via file operations\n * @description File operations with unsanitized user input can lead to path traversal\n * @kind path-problem\n * @problem.severity error\n * @id py/path-traversal-flow\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Parameters to functions\n    source instanceof DataFlow::ParameterNode or\n    // Attribute access that could be user-controlled\n    exists(DataFlow::AttrRead attr | source = attr)\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(FileSystemAccess fa | sink = fa.getAPathArgument())\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"File path may be controlled by $@.\", source.getNode(), \"user input\"\n",
