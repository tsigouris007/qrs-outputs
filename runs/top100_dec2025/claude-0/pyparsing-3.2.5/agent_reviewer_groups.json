   {
    "codeql_query_uuid": "20251219003832",
    "codeql_raw_query": "/**\n * @name Uncontrolled recursion\n * @description Recursive functions without depth limits can cause stack overflow\n * @kind problem\n * @problem.severity warning\n * @id py/uncontrolled-recursion\n * @tags security\n *        external/cwe/cwe-674\n *        external/cwe/cwe-400\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\n// Find recursive functions\npredicate isRecursiveFunction(Function f) {\n  exists(Call call |\n    call.getScope() = f and\n    call.getFunc().(Name).getId() = f.getName()\n  )\n}\n\n// Check if function has depth/recursion limit checks\npredicate hasRecursionLimit(Function f) {\n  exists(Compare cmp |\n    cmp.getScope() = f and\n    (\n      cmp.getASubExpression().(Name).getId().regexpMatch(\"(?i).*(depth|limit|max|count|level).*\") or\n      cmp.getASubExpression().(Attribute).getName().regexpMatch(\"(?i).*(depth|limit|max|count|level).*\")\n    )\n  )\n}\n\nfrom Function f\nwhere \n  isRecursiveFunction(f) and\n  not hasRecursionLimit(f)\nselect f, \"Recursive function '\" + f.getName() + \"' may be vulnerable to stack overflow without recursion depth limit.\"\n",
    "hypothesis": "Uncontrolled recursion that could lead to stack overflow or denial of service",
    "severity": "medium",
    "cwe_ids": [
     "cwe-674",
     "cwe-400"
    ],
