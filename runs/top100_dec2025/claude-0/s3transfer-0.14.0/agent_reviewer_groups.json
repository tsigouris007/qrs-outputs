    "codeql_query_uuid": "20251219195644",
    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description User-controlled file paths in S3 transfer operations could allow writing files outside intended directories\n * @kind path-problem\n * @problem.severity error\n * @id py/s3transfer-path-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Parameters that could contain S3 keys or filenames\n    exists(DataFlow::ParameterNode param |\n      source = param and\n      (\n        param.getParameter().getName() in [\"key\", \"filename\", \"fileobj\", \"bucket\", \"extra_args\", \"s3_key\", \"dest\", \"source\"]\n      )\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    // File operations that could be vulnerable to path traversal\n    exists(DataFlow::CallCfgNode call |\n      sink = call.getArg(_) and\n      (\n        call = API::builtin(\"open\").getACall() or\n        call = API::moduleImport(\"os\").getMember([\"open\", \"makedirs\", \"mkdir\", \"remove\", \"unlink\", \"rename\"]).getACall() or\n        call = API::moduleImport(\"os\").getMember(\"path\").getMember(\"join\").getACall() or\n        call = API::moduleImport(\"shutil\").getMember([\"copy\", \"copy2\", \"copyfile\", \"move\"]).getACall()\n      )\n    )\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from $@.\", source.getNode(), \"user-controlled input\"",
    "hypothesis": "Path traversal vulnerability in file download/upload operations where user-controlled S3 keys or filenames could be used to write files outside intended directories",
    "severity": "high",
