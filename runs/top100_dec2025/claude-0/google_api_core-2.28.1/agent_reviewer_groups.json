    "codeql_raw_query": "/**\n * @name Hardcoded credentials\n * @description Detects hardcoded passwords, API keys, or secrets\n * @kind problem\n * @problem.severity warning\n * @id py/hardcoded-credentials\n * @tags security\n *        external/cwe/cwe-798\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom Assign assign, StrConst str\nwhere\n  assign.getValue() = str and\n  (\n    assign.getATarget().(Name).getId().toLowerCase().matches(\"%password%\") or\n    assign.getATarget().(Name).getId().toLowerCase().matches(\"%secret%\") or\n    assign.getATarget().(Name).getId().toLowerCase().matches(\"%api_key%\") or\n    assign.getATarget().(Name).getId().toLowerCase().matches(\"%apikey%\") or\n    assign.getATarget().(Name).getId().toLowerCase().matches(\"%token%\")\n  ) and\n  str.getText().length() > 8 and\n  not str.getText() = \"\"\nselect assign, \"Potential hardcoded credential: \" + assign.getATarget().(Name).getId()",
