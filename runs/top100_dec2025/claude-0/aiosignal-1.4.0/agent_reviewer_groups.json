    "codeql_query_uuid": "20251205165225",
    "codeql_raw_query": "/**\n * @name Type confusion in callback registration\n * @description Callbacks registered without proper callable validation may lead to runtime errors\n * @kind problem\n * @problem.severity warning\n * @id py/type-confusion-callback\n * @tags security\n *       reliability\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node arg\nwhere\n  // Find calls to methods that likely register callbacks (append, connect, etc.)\n  (\n    call.getFunction().(DataFlow::AttrRead).getAttributeName() in [\"append\", \"connect\", \"register\"] or\n    call.getFunction().asExpr().(Name).getId() in [\"append\", \"connect\", \"register\"]\n  ) and\n  arg = call.getArg(0) and\n  // Check if there's no explicit callable check before registration\n  not exists(DataFlow::CallCfgNode check |\n    check.getFunction().(DataFlow::AttrRead).getAttributeName() = \"callable\" or\n    check.getFunction().asExpr().(Name).getId() = \"callable\"\n  )\nselect call, \"Callback registration without explicit callable validation\"\n",
    "hypothesis": "Callbacks may be registered without validating they are callable, leading to runtime errors when invoked",
