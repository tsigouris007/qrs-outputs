   {
    "codeql_query_uuid": "20251205164933",
    "codeql_raw_query": "/**\n * @name Unvalidated callback registration\n * @description Callbacks registered without validation could allow arbitrary code execution\n * @kind problem\n * @problem.severity warning\n * @id py/unvalidated-callback-registration\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node arg\nwhere\n  // Look for methods that register callbacks (like 'append', 'register', etc.)\n  (\n    call.getFunction().(DataFlow::AttrRead).getAttributeName() in [\"append\", \"register\", \"add\", \"connect\"]\n    or\n    call = API::builtin(\"list\").getReturn().getMember(\"append\").getACall()\n  )\n  and\n  arg = call.getArg(0)\n  and\n  // Check if the argument is callable-like\n  exists(arg.asExpr())\nselect call, \"Callback registration at this location may accept unvalidated callbacks: \" + arg.toString()\n",
    "hypothesis": "Check for potential callback injection where attacker-controlled data could influence callback registration or execution without proper validation",
    "severity": "high",
    "cwe_ids": [
     "cwe-94",
     "cwe-913"
    ],
