    "codeql_query_uuid": "20251205165000",
    "codeql_raw_query": "/**\n * @name Unhandled exceptions in callback execution\n * @description Callbacks executed without proper exception handling may lead to denial of service or information disclosure\n * @kind problem\n * @problem.severity warning\n * @id py/unhandled-callback-exception\n * @tags security\n *       reliability\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call, Function func\nwhere\n  // Find calls that look like callback invocations\n  (call.getFunction().asExpr().(Name).getId() = \"receiver\" or\n   call.getFunction().asExpr().(Attribute).getName() = \"send\") and\n  // Check if the call is within a try-except block\n  not exists(Try try_stmt |\n    try_stmt.getBody().contains(call.getNode().getNode()) and\n    exists(try_stmt.getAHandler())\n  ) and\n  func = call.getNode().getScope()\nselect call, \"Callback execution without exception handling may lead to unhandled errors\"\n",
    "hypothesis": "Check if exceptions during callback execution are properly handled to prevent information disclosure or denial of service",
