    "codeql_raw_query": "/**\n * @name Timing attack on secret comparison\n * @description Using standard equality operators to compare secrets can leak information through timing side channels\n * @kind problem\n * @problem.severity warning\n * @id py/timing-attack-secret-comparison\n * @tags security\n *        external/cwe/cwe-208\n */\n\nimport python\n\nfrom Compare cmp, Name name\nwhere\n  name = cmp.getASubExpression() and\n  exists(string varName |\n    varName = name.getId() and\n    (\n      varName.toLowerCase().matches(\"%token%\") or\n      varName.toLowerCase().matches(\"%secret%\") or\n      varName.toLowerCase().matches(\"%key%\") or\n      varName.toLowerCase().matches(\"%signature%\")\n    )\n  )\nselect cmp, \"Potential timing attack: comparing secret '\" + name.getId() + \"' using standard equality operator\"",
    "hypothesis": "Using standard equality operators to compare secrets can leak information through timing side channels",
