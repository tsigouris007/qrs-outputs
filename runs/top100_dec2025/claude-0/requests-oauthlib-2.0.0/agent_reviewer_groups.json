    "codeql_raw_query": "/**\n * @name Hardcoded secrets or credentials\n * @description Hardcoded secrets, tokens, or API keys in source code can be extracted and misused\n * @kind problem\n * @problem.severity error\n * @id py/hardcoded-credentials\n * @tags security\n *        external/cwe/cwe-798\n */\n\nimport python\n\nfrom StrConst str\nwhere\n  exists(string value |\n    value = str.getText() and\n    value.length() > 20 and\n    (\n      value.regexpMatch(\"(?i).*(secret|token|key|password|credential|api[_-]?key).*\") or\n      value.regexpMatch(\"[A-Za-z0-9+/]{40,}={0,2}\") or  // Base64-like\n      value.regexpMatch(\"[a-f0-9]{32,}\")  // Hex strings\n    ) and\n    not value.matches(\"%http%\") and\n    not value.matches(\"%example%\") and\n    not value.matches(\"%test%\") and\n    not value.matches(\"%dummy%\")\n  )\nselect str, \"Potential hardcoded secret or credential: \" + str.getText().prefix(50)",
    "hypothesis": "Check for hardcoded OAuth secrets, tokens, or API keys that could be extracted and misused",
