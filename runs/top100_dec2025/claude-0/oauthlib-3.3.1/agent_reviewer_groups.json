    "codeql_query_uuid": "20251216184611",
    "codeql_raw_query": "/**\n * @name Timing attack in OAuth signature verification\n * @description OAuth signature comparisons using non-constant-time operators can leak timing information\n * @kind problem\n * @problem.severity error\n * @id py/oauth-timing-attack-signature\n * @tags security\n *        external/cwe/cwe-208\n *        external/cwe/cwe-697\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom Compare cmp, ControlFlowNode left, ControlFlowNode right\nwhere\n  (cmp.getOp(0) instanceof Eq or cmp.getOp(0) instanceof NotEq) and\n  left = cmp.getLeft().getAFlowNode() and\n  right = cmp.getComparator(0).getAFlowNode() and\n  (\n    // Signature comparisons\n    exists(string varName | \n      varName = left.getNode().(Name).getId() or\n      varName = right.getNode().(Name).getId() |\n      varName.matches(\"%signature%\") or\n      varName.matches(\"%sig%\") or\n      varName.matches(\"%token%\") or\n      varName.matches(\"%secret%\") or\n      varName.matches(\"%key%\")\n    ) or\n    // Method calls that return signatures/tokens\n    exists(Attribute attr |\n      (attr = left.getNode() or attr = right.getNode()) and\n      (\n        attr.getName().matches(\"%signature%\") or\n        attr.getName().matches(\"%token%\") or\n        attr.getName().matches(\"%secret%\")\n      )\n    )\n  )\nselect cmp, \"Non-constant-time comparison of cryptographic value may be vulnerable to timing attacks.\"\n",
    "hypothesis": "Timing attacks in OAuth signature verification - focusing on signature comparison operations that should use constant-time comparison",
    "severity": "high",
    "cwe_ids": [
     "cwe-208",
     "cwe-697"
    ],
