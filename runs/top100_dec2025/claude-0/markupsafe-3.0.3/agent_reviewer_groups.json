    "codeql_raw_query": "/**\n * @name String formatting operations on Markup objects\n * @description String formatting operations that might bypass HTML escaping\n * @kind problem\n * @problem.severity warning\n * @id py/markupsafe-format-bypass\n * @tags security\n *        external/cwe/cwe-79\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    // Format method calls\n    call.getFunction().asExpr().(Attribute).getName() = \"format\" or\n    // % formatting\n    call.getFunction().asExpr().(Attribute).getName() = \"__mod__\" or\n    // join operations\n    call.getFunction().asExpr().(Attribute).getName() = \"join\" or\n    // replace operations\n    call.getFunction().asExpr().(Attribute).getName() = \"replace\"\n  )\nselect call, \"String operation that may affect escaping behavior\"\n",
