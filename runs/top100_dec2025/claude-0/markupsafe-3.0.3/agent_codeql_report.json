   "codeql_raw_query": "/**\n * @name Missing type validation before __html__ call\n * @description Calling __html__ without proper type validation could lead to unexpected behavior\n * @kind problem\n * @problem.severity warning\n * @id py/markupsafe-missing-type-check\n * @tags security\n *        external/cwe/cwe-79\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call, DataFlow::AttrRead attr\nwhere\n  attr.getAttributeName() = \"__html__\" and\n  call.getFunction() = attr and\n  // Check if there's a hasattr or isinstance check protecting this call\n  not exists(Call hasattrCall |\n    hasattrCall.getFunc().(Name).getId() = \"hasattr\" and\n    hasattrCall.getArg(1).(StrConst).getText() = \"__html__\"\n  )\nselect call, \"Call to __html__ method without explicit type validation\"\n",
