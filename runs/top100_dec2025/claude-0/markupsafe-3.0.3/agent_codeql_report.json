   "codeql_raw_query": "/**\n * @name HTML escaping bypass via type confusion\n * @description Identifies cases where objects might bypass HTML escaping due to type handling\n * @kind problem\n * @problem.severity error\n * @id py/markupsafe-escape-bypass\n * @tags security\n *        external/cwe/cwe-79\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call, string funcName\nwhere\n  (\n    call.getFunction().asExpr().(Name).getId() = funcName and\n    funcName in [\"escape\", \"escape_silent\", \"soft_str\", \"soft_unicode\"]\n  ) or\n  (\n    call.getFunction().asExpr().(Attribute).getName() = funcName and\n    funcName in [\"escape\", \"unescape\", \"__html__\"]\n  )\nselect call, \"Call to markup handling function: \" + funcName",
