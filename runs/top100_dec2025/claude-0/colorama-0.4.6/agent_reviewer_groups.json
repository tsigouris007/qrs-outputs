    "codeql_raw_query": "/**\n * @name Unsafe ctypes usage\n * @description Detects potentially unsafe ctypes operations\n * @kind problem\n * @problem.severity warning\n * @id py/unsafe-ctypes\n * @tags security\n * @cwe cwe-704\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    // ctypes.windll, ctypes.cdll, ctypes.oledll access\n    call = API::moduleImport(\"ctypes\").getMember([\"windll\", \"cdll\", \"oledll\", \"WinDLL\", \"CDLL\", \"OleDLL\"]).getACall()\n    or\n    // ctypes pointer operations\n    call = API::moduleImport(\"ctypes\").getMember([\"pointer\", \"POINTER\", \"cast\", \"string_at\", \"wstring_at\"]).getACall()\n    or\n    // ctypes memory operations\n    call = API::moduleImport(\"ctypes\").getMember([\"memmove\", \"memset\", \"addressof\"]).getACall()\n  )\nselect call, \"Potentially unsafe ctypes operation that could lead to memory corruption if misused.\"\n",
