    "codeql_query_uuid": "20251205213341",
    "codeql_raw_query": "/**\n * @name Improper Input Validation\n * @description User-controlled data flows to sensitive operations without proper validation\n * @kind problem\n * @problem.severity warning\n * @id py/improper-input-validation\n * @tags security\n * @cwe cwe-20\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node arg\nwhere\n  (\n    // Check for calls to ctypes functions with arguments\n    call = API::moduleImport(\"ctypes\").getMember(_).getACall() or\n    call = API::moduleImport(\"ctypes\").getMember(\"windll\").getMember(_).getMember(_).getACall()\n  ) and\n  arg = call.getArg(_) and\n  // Exclude constant values\n  not arg.asExpr() instanceof IntegerLiteral and\n  not arg.asExpr() instanceof StringLiteral\nselect call, \"Call to ctypes function with potentially unvalidated argument.\"\n",
