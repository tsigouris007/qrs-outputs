    "codeql_query_uuid": "20251221031639",
    "codeql_raw_query": "/**\n * @name Code injection via exec with tainted input\n * @description Using exec with untrusted input can lead to arbitrary code execution\n * @kind path-problem\n * @problem.severity error\n * @id py/exec-code-injection\n * @tags security\n *        external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.Concepts\n\nmodule ExecInjectionConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Remote flow sources\n    source instanceof RemoteFlowSource\n    or\n    // Function parameters that could be user-controlled\n    source instanceof DataFlow::ParameterNode\n    or\n    // Attribute access that could be external input\n    exists(DataFlow::AttrRead attr |\n      source = attr and\n      not attr.getAttributeName() in [\"__name__\", \"__module__\", \"__qualname__\", \"__class__\"]\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    sink = any(CodeExecution ce).getCode()\n  }\n}\n\nmodule ExecInjectionFlow = TaintTracking::Global<ExecInjectionConfig>;\nimport ExecInjectionFlow::PathGraph\n\nfrom ExecInjectionFlow::PathNode source, ExecInjectionFlow::PathNode sink\nwhere ExecInjectionFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"exec() call with potentially untrusted input from $@.\", source.getNode(), \"this source\"\n",
    "hypothesis": "Check if exec() calls use tainted/untrusted input that could lead to code injection",
    "severity": "critical",
    "cwe_ids": [
     "cwe-094"
    ],
