    "codeql_raw_query": "/**\n * @name Check if exec parameters come from remote sources\n * @description Determine if the exec() calls receive input from remote/external sources\n * @kind problem\n * @problem.severity error\n * @id py/exec-remote-flow-check\n * @tags security\n *        external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node arg\nwhere\n  call.getFunction().asExpr().(Name).getId() = \"exec\" and\n  arg = call.getArg(0)\nselect call, \"exec() call with argument: \" + arg.toString()\n",
