    "codeql_query_uuid": "20251213165534",
    "codeql_raw_query": "/**\n * @name Type confusion in input handling\n * @description Missing or improper type checking on inputs could lead to unexpected behavior\n * @kind problem\n * @problem.severity warning\n * @id py/type-confusion\n * @tags security\n *        correctness\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node arg\nwhere\n  (\n    call.getFunction().asExpr().(Attribute).getName() in [\"encode\", \"decode\"] or\n    call.getFunction().asExpr().(Name).getId() in [\"encode\", \"decode\"]\n  ) and\n  arg = call.getArg(0) and\n  not exists(Call typecheck |\n    typecheck.getFunc().(Name).getId() = \"isinstance\" and\n    DataFlow::exprNode(typecheck.getArg(0)) = arg\n  )\nselect call, \"Encode/decode operation without type validation on input argument.\"\n",
