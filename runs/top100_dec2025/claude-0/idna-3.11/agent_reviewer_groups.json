    "codeql_raw_query": "/**\n * @name Information disclosure through exception messages\n * @description Exception messages that include user input may leak sensitive information\n * @kind problem\n * @problem.severity warning\n * @id py/info-disclosure-exception\n * @tags security\n *        external/cwe/cwe-209\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node arg\nwhere\n  (\n    call.getFunction().asExpr().(Name).getId() in [\"Exception\", \"ValueError\", \"UnicodeError\", \"IDNAError\"] or\n    call.getFunction().asExpr().(Attribute).getName() in [\"Exception\", \"ValueError\", \"UnicodeError\"]\n  ) and\n  arg = call.getArg(_) and\n  exists(DataFlow::Node source |\n    DataFlow::localFlow(source, arg) and\n    (\n      source.asExpr() instanceof BinaryExpr or\n      source.asExpr() instanceof Call\n    )\n  )\nselect call, \"Exception constructed with potentially sensitive data in message.\"\n",
