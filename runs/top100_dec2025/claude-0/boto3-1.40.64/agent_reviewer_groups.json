    "codeql_raw_query": "/**\n * @name Hardcoded credentials in boto3\n * @description Detects hardcoded AWS credentials or secrets\n * @kind problem\n * @problem.severity error\n * @id py/boto3-hardcoded-credentials\n * @tags security\n *        external/cwe/cwe-798\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::Node node, string varName\nwhere\n  exists(StrConst str |\n    node.asExpr() = str and\n    (\n      str.getText().regexpMatch(\"(?i).*(aws_access_key_id|aws_secret_access_key|secret_key|access_key).*\") or\n      str.getText().regexpMatch(\"AKIA[0-9A-Z]{16}\") or\n      str.getText().regexpMatch(\"[A-Za-z0-9/+=]{40}\")\n    ) and\n    not str.getText().matches(\"%example%\") and\n    not str.getText().matches(\"%test%\") and\n    not str.getText().matches(\"%dummy%\") and\n    not str.getText().matches(\"%placeholder%\")\n  ) and\n  varName = node.asExpr().(StrConst).getText()\nselect node, \"Potential hardcoded credential: \" + varName",
    "hypothesis": "Detects hardcoded AWS credentials or API keys in the source code",
