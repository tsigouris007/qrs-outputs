    "codeql_query_uuid": "20251205195622",
    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description User-controlled data flowing to file operations may allow path traversal attacks\n * @kind path-problem\n * @problem.severity error\n * @id py/boto3-path-traversal\n * @tags security\n *       external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Parameters that could be user-controlled\n    source instanceof DataFlow::ParameterNode or\n    // Attribute access that might come from external input\n    exists(DataFlow::AttrRead attr |\n      source = attr and\n      attr.getAttributeName() in [\"key\", \"filename\", \"path\", \"name\", \"Key\", \"Bucket\"]\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    // File system access operations\n    exists(FileSystemAccess fsa |\n      sink = fsa.getAPathArgument()\n    ) or\n    // Direct file operations\n    exists(DataFlow::CallCfgNode call |\n      call.getFunction().(DataFlow::AttrRead).getAttributeName() in [\"open\", \"read\", \"write\"] and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from $@.\", source.getNode(), \"user-controlled input\"\n",
    "hypothesis": "Path traversal vulnerability in file operations where user-controlled input flows to file system operations without proper validation",
    "severity": "high",
    "cwe_ids": [
     "cwe-22"
    ],
