    "codeql_raw_query": "/**\n * @name Uncontrolled resource consumption\n * @description Detects operations that may lead to resource exhaustion\n * @kind problem\n * @problem.severity warning\n * @id py/uncontrolled-resource-consumption\n * @tags security\n *       external/cwe/cwe-400\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    // Recursive parsing or deep nesting operations\n    call.getFunction().asCfgNode().(NameNode).getId() in [\"parse\", \"parseString\", \"fromstring\", \"feed\"]\n    or\n    // Large buffer allocations\n    call = API::builtin(\"bytearray\").getACall()\n    or\n    call = API::builtin(\"bytes\").getACall()\n    or\n    // Unbounded loops or iterations\n    call.getFunction().asCfgNode().(NameNode).getId() in [\"read\", \"readlines\"]\n  )\nselect call, \"Potential uncontrolled resource consumption\"\n",
