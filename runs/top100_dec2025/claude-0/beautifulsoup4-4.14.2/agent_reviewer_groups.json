    "codeql_query_uuid": "20251205194418",
    "codeql_raw_query": "/**\n * @name Hardcoded credentials or secrets\n * @description Detects hardcoded passwords, API keys, tokens, or other secrets\n * @kind problem\n * @problem.severity warning\n * @id py/hardcoded-credentials\n * @tags security\n *       external/cwe/cwe-798\n *       external/cwe/cwe-259\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::Node assignment, string value\nwhere\n  exists(Assign a, StrConst s |\n    assignment.asExpr() = a.getValue() and\n    s = a.getValue() and\n    value = s.getText() and\n    (\n      a.getATarget().(Name).getId().toLowerCase().matches([\"%password%\", \"%passwd%\", \"%pwd%\", \"%secret%\", \"%api_key%\", \"%apikey%\", \"%token%\", \"%auth%\"]) or\n      s.getText().regexpMatch(\"(?i).*(password|passwd|secret|api[_-]?key|token).*=.*\")\n    ) and\n    not s.getText() = \"\" and\n    not s.getText().matches(\"%{%}%\") and // Exclude template strings\n    not s.getText().matches(\"%$%\") // Exclude variable references\n  )\nselect assignment, \"Potential hardcoded credential or secret\"",
