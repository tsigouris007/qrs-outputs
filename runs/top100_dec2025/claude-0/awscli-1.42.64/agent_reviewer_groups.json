    "codeql_query_uuid": "20251205193147",
    "codeql_raw_query": "/**\n * @name Unsafe YAML deserialization\n * @description Using yaml.load without a safe Loader can execute arbitrary code\n * @kind problem\n * @problem.severity error\n * @id py/unsafe-yaml-load\n * @tags security\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  // yaml.load() calls\n  call = API::moduleImport(\"yaml\").getMember(\"load\").getACall() and\n  // Without SafeLoader or safe_load\n  not exists(DataFlow::Node loader |\n    loader = call.getArgByName(\"Loader\") and\n    (\n      loader.asExpr().(Attribute).getName() = \"SafeLoader\" or\n      loader.asExpr().(Attribute).getName() = \"CSafeLoader\"\n    )\n  )\n  or\n  // yaml.load_all() calls without safe loader\n  call = API::moduleImport(\"yaml\").getMember(\"load_all\").getACall() and\n  not exists(DataFlow::Node loader |\n    loader = call.getArgByName(\"Loader\") and\n    (\n      loader.asExpr().(Attribute).getName() = \"SafeLoader\" or\n      loader.asExpr().(Attribute).getName() = \"CSafeLoader\"\n    )\n  )\nselect call, \"Unsafe YAML deserialization using yaml.load() without SafeLoader can lead to arbitrary code execution.\"\n",
