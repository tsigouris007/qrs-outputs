    "codeql_raw_query": "/**\n * @name Command injection via subprocess with shell=True\n * @description Detects subprocess calls with shell=True where user input may flow into the command\n * @kind path-problem\n * @problem.severity error\n * @id py/command-injection\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.ApiGraphs\n\nmodule CommandInjectionConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // User-controlled input from sys.argv\n    exists(DataFlow::Node argvAccess |\n      argvAccess = API::moduleImport(\"sys\").getMember(\"argv\").getAValueReachableFromSource() and\n      source = argvAccess\n    )\n    or\n    // Function parameters as potential sources\n    source instanceof DataFlow::ParameterNode\n    or\n    // Remote flow sources (HTTP requests, etc.)\n    source instanceof RemoteFlowSource\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"subprocess\").getMember([\"call\", \"run\", \"Popen\", \"check_call\", \"check_output\"]).getACall() and\n      call.getArgByName(\"shell\").asExpr().(BooleanLiteral).booleanValue() = true and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule CommandInjectionFlow = TaintTracking::Global<CommandInjectionConfig>;\nimport CommandInjectionFlow::PathGraph\n\nfrom CommandInjectionFlow::PathNode source, CommandInjectionFlow::PathNode sink\nwhere CommandInjectionFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Command injection: user input flows to subprocess call with shell=True $@.\", source.getNode(), \"from here\"",
