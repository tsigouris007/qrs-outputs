   {
    "codeql_query_uuid": "20251219125737",
    "codeql_raw_query": "/**\n * @name Timezone name path traversal vulnerability\n * @description User-controlled timezone names used in file path construction without proper validation\n * @kind path-problem\n * @problem.severity error\n * @id py/pytz-timezone-path-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule TimezonePathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Function parameters that accept timezone names\n    exists(Function f, Parameter p |\n      (f.getName() in [\"timezone\", \"_tzinfo_factory\", \"build_tzinfo\", \"_p\"] and\n       source.(DataFlow::ParameterNode).getParameter() = p and\n       p = f.getAnArg())\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    // File operations with path arguments\n    exists(DataFlow::CallCfgNode call |\n      (\n        call = API::builtin(\"open\").getACall() or\n        call = API::moduleImport(\"os\").getMember(\"path\").getMember(\"join\").getACall() or\n        call = API::moduleImport(\"pkg_resources\").getMember(\"resource_stream\").getACall()\n      ) and\n      sink = call.getArg(_)\n    )\n  }\n}\n\nmodule TimezonePathTraversalFlow = TaintTracking::Global<TimezonePathTraversalConfig>;\nimport TimezonePathTraversalFlow::PathGraph\n\nfrom TimezonePathTraversalFlow::PathNode source, TimezonePathTraversalFlow::PathNode sink\nwhere TimezonePathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal via timezone name from $@.\", source.getNode(), \"user input\"",
    "hypothesis": "User-controlled timezone names could be used to traverse directories when loading timezone data files",
    "severity": "high",
    "cwe_ids": [
     "cwe-022"
    ],
