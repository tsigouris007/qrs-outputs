    "codeql_raw_query": "/**\n * @name Unsafe URL opening from user input\n * @description User input flowing to webbrowser.open() could lead to command injection\n * @kind path-problem\n * @problem.severity high\n * @id py/click-unsafe-url-open\n * @tags security\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule WebbrowserConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    exists(DataFlow::ParameterNode param |\n      source = param\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"webbrowser\").getMember(\"open\").getACall() and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule WebbrowserFlow = TaintTracking::Global<WebbrowserConfig>;\nimport WebbrowserFlow::PathGraph\n\nfrom WebbrowserFlow::PathNode source, WebbrowserFlow::PathNode sink\nwhere WebbrowserFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential unsafe URL opening from $@.\", source.getNode(), \"user input\"",
    "hypothesis": "User input flowing to webbrowser.open() could lead to command injection or URL manipulation",
