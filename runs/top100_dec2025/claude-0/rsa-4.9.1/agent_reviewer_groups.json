    "codeql_query_uuid": "20251219193940",
    "codeql_raw_query": "/**\n * @name Unsafe file permissions\n * @description Creating files without restricting permissions can expose sensitive data\n * @kind problem\n * @problem.severity warning\n * @id py/unsafe-file-permissions\n * @tags security\n *        external/cwe/cwe-732\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::builtin(\"open\").getACall() or\n    call = API::moduleImport(\"os\").getMember(\"open\").getACall()\n  ) and\n  // Check if mode includes write/create flags\n  exists(DataFlow::Node mode |\n    mode = call.getArg(1) or mode = call.getArgByName(\"mode\") |\n    mode.asExpr().(StringLiteral).getText().matches(\"%w%\")\n  ) and\n  // No explicit mode parameter for os.open\n  not exists(call.getArgByName(\"mode\"))\nselect call, \"File opened for writing without explicit permission mode.\"",
