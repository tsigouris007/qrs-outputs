    "codeql_raw_query": "/**\n * @name Information disclosure through exception messages\n * @description Exposing detailed error messages can leak sensitive information\n * @kind problem\n * @problem.severity warning\n * @id py/information-disclosure-exception\n * @tags security\n *        external/cwe/cwe-209\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node arg\nwhere\n  (\n    call = API::builtin(\"print\").getACall() or\n    call = API::moduleImport(\"sys\").getMember(\"stdout\").getMember(\"write\").getACall() or\n    call = API::moduleImport(\"sys\").getMember(\"stderr\").getMember(\"write\").getACall()\n  ) and\n  arg = call.getArg(_) and\n  exists(ExceptStmt except |\n    except.getAStmt().contains(call.asExpr())\n  )\nselect call, \"Potential information disclosure: printing exception details to output.\"",
    "hypothesis": "Check if exception handling exposes sensitive information through error messages",
    "severity": "medium",
    "cwe_ids": [
