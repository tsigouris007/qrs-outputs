    "codeql_raw_query": "/**\n * @name Information disclosure via exception messages\n * @description Sensitive information in exception messages could be exposed to users\n * @kind problem\n * @problem.severity warning\n * @id py/info-disclosure-packaging\n * @tags security\n *        external/cwe/cwe-209\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, string msg\nwhere\n  (\n    call = API::builtin(\"open\").getACall() or\n    call = API::moduleImport(\"pathlib\").getMember(\"Path\").getReturn().getMember(\"open\").getACall()\n  ) and\n  exists(Raise raise |\n    raise.getException().(Call).getFunc().(Name).getId() in [\"Exception\", \"ValueError\", \"IOError\", \"OSError\"] and\n    msg = raise.getException().(Call).getArg(0).(StrConst).getText()\n  )\nselect call, \"File operation that may expose path information in exceptions.\"",
