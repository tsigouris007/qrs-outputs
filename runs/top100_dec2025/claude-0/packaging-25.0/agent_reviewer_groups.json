    "codeql_raw_query": "/**\n * @name Regular Expression Denial of Service (ReDoS)\n * @description Complex regular expressions can cause exponential backtracking leading to DoS\n * @kind problem\n * @problem.severity warning\n * @id py/redos-packaging\n * @tags security\n *        external/cwe/cwe-1333\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, Expr pattern\nwhere\n  (\n    call = API::moduleImport(\"re\").getMember([\"compile\", \"match\", \"search\", \"findall\", \"finditer\", \"sub\", \"subn\", \"split\"]).getACall() or\n    call = API::moduleImport(\"re\").getMember(\"Pattern\").getMember([\"match\", \"search\", \"findall\", \"finditer\", \"sub\", \"subn\", \"split\"]).getACall()\n  ) and\n  pattern = call.getArg(0).asExpr() and\n  exists(StrConst s | s = pattern |\n    // Look for patterns with nested quantifiers or alternation that could cause backtracking\n    s.getText().regexpMatch(\".*[\\\\*\\\\+\\\\{][^\\\\]]*[\\\\*\\\\+\\\\{].*\") or\n    s.getText().regexpMatch(\".*(\\\\|.*){3,}.*\") or\n    s.getText().regexpMatch(\".*\\\\([^)]*[\\\\*\\\\+].*\\\\)[\\\\*\\\\+\\\\{].*\")\n  )\nselect call, \"Regular expression with potential for exponential backtracking: \" + pattern.toString()",
