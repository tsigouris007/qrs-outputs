    "codeql_query_uuid": "20251205220732",
    "codeql_raw_query": "/**\n * @name Direct eval/exec usage\n * @description Direct use of eval or exec with untrusted input can lead to arbitrary code execution\n * @kind path-problem\n * @problem.severity error\n * @id py/eval-exec-distlib\n * @tags security\n * @cwe cwe-95\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule EvalExecConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"sys\").getMember(\"argv\").getAValueReachableFromSource() or\n      call.getFunction().asCfgNode().(NameNode).getId() in [\"input\", \"raw_input\"]\n    |\n      source = call\n    )\n    or\n    exists(DataFlow::ParameterNode param |\n      source = param\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call.getFunction().asCfgNode().(NameNode).getId() in [\"eval\", \"exec\", \"compile\", \"__import__\"] and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule EvalExecFlow = TaintTracking::Global<EvalExecConfig>;\nimport EvalExecFlow::PathGraph\n\nfrom EvalExecFlow::PathNode source, EvalExecFlow::PathNode sink\nwhere EvalExecFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Dangerous eval/exec from $@.\", source.getNode(), \"untrusted input\"",
    "hypothesis": "Direct use of eval or exec with potentially untrusted input",
