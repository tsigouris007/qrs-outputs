    "codeql_raw_query": "/**\n * @name Path traversal in archive extraction\n * @description Extracting archive entries without validating paths can allow writing outside intended directory\n * @kind path-problem\n * @problem.severity error\n * @id py/zipslip-distlib\n * @tags security\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule ZipSlipConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    exists(DataFlow::CallCfgNode call |\n      // ZipFile.namelist() or TarFile.getnames() or member.name\n      call = API::moduleImport(\"zipfile\").getMember(\"ZipFile\").getReturn().getMember(\"namelist\").getACall() or\n      call = API::moduleImport(\"tarfile\").getMember(\"TarFile\").getReturn().getMember(\"getnames\").getACall() or\n      call = API::moduleImport(\"tarfile\").getMember(\"TarFile\").getReturn().getMember(\"getmembers\").getACall() or\n      // Getting name from archive member\n      exists(DataFlow::AttrRead attr |\n        attr.getAttributeName() = \"name\" or\n        attr.getAttributeName() = \"filename\" |\n        source = attr\n      )\n      |\n      source = call\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      // File operations that write to paths\n      call = API::moduleImport(\"os\").getMember(\"path\").getMember(\"join\").getACall() or\n      call = API::builtin(\"open\").getACall() or\n      call = API::moduleImport(\"shutil\").getMember([\"copy\", \"copy2\", \"copyfile\", \"move\"]).getACall() or\n      // Extract operations\n      call = API::moduleImport(\"zipfile\").getMember(\"ZipFile\").getReturn().getMember([\"extract\", \"extractall\"]).getACall() or\n      call = API::moduleImport(\"tarfile\").getMember(\"TarFile\").getReturn().getMember([\"extract\", \"extractall\"]).getACall()\n      |\n      sink = call.getArg(_)\n    )\n  }\n}\n\nmodule ZipSlipFlow = TaintTracking::Global<ZipSlipConfig>;\nimport ZipSlipFlow::PathGraph\n\nfrom ZipSlipFlow::PathNode source, ZipSlipFlow::PathNode sink\nwhere ZipSlipFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from archive entry $@.\", source.getNode(), \"name\"",
    "hypothesis": "Path traversal vulnerability in archive extraction (zip slip) where malicious archive entries with ../ in paths can write outside intended directory",
    "severity": "high",
