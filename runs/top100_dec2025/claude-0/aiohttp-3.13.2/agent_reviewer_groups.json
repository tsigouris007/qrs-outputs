    "codeql_query_uuid": "20251205155335",
    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description User-controlled data flows to file system operations without proper sanitization\n * @kind path-problem\n * @problem.severity error\n * @id py/aiohttp-path-traversal\n * @tags security\n *       external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.Concepts\nimport semmle.python.ApiGraphs\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Remote flow sources (HTTP request data)\n    source instanceof RemoteFlowSource\n    or\n    // Request path/query parameters\n    exists(DataFlow::AttrRead attr |\n      attr.getAttributeName() in [\"path\", \"query\", \"match_info\", \"rel_url\"] and\n      source = attr\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    // File system access operations\n    sink = any(FileSystemAccess fa).getAPathArgument()\n    or\n    // Path operations that could lead to file access\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"pathlib\").getMember(\"Path\").getACall() and\n      sink = call.getArg(0)\n    )\n    or\n    // Open file operations\n    exists(DataFlow::CallCfgNode call |\n      call = API::builtin(\"open\").getACall() and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from $@.\", source.getNode(), \"user-controlled input\"\n",
    "hypothesis": "Path traversal vulnerability in file serving operations where user-controlled input is used to construct file paths without proper validation",
    "severity": "high",
