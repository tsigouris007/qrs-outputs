   "codeql_raw_query": "/**\n * @name Environment variable injection\n * @description Using user-controlled input to set environment variables can lead to security issues\n * @kind path-problem\n * @problem.severity warning\n * @id py/env-injection-platformdirs\n * @tags security\n *        external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.ApiGraphs\n\nmodule EnvInjectionConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof RemoteFlowSource or\n    source instanceof DataFlow::ParameterNode\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"os\").getMember(\"environ\").getMember(\"__setitem__\").getACall() and\n      sink = call.getArg(_)\n    ) or\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"os\").getMember(\"putenv\").getACall() and\n      sink = call.getArg(_)\n    )\n  }\n}\n\nmodule EnvInjectionFlow = TaintTracking::Global<EnvInjectionConfig>;\nimport EnvInjectionFlow::PathGraph\n\nfrom EnvInjectionFlow::PathNode source, EnvInjectionFlow::PathNode sink\nwhere EnvInjectionFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Environment variable injection from $@.\", source.getNode(), \"user input\"",
