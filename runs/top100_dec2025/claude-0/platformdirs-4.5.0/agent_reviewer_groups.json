    "codeql_query_uuid": "20251217143000",
    "codeql_raw_query": "/**\n * @name Race condition in directory creation\n * @description Creating directories without proper checks can lead to TOCTOU vulnerabilities\n * @kind problem\n * @problem.severity warning\n * @id py/toctou-directory-creation\n * @tags security\n *        external/cwe/cwe-367\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"os\").getMember([\"mkdir\", \"makedirs\"]).getACall() or\n    call = API::moduleImport(\"pathlib\").getMember(\"Path\").getReturn().getMember(\"mkdir\").getACall()\n  ) and\n  not exists(DataFlow::CallCfgNode existsCheck |\n    existsCheck = API::moduleImport(\"os\").getMember(\"path\").getMember(\"exists\").getACall()\n  )\nselect call, \"Directory creation without proper synchronization may be vulnerable to race conditions.\"",
    "hypothesis": "Race condition in directory creation (TOCTOU)",
