    "codeql_raw_query": "/**\n * @name Path traversal via user-controlled input\n * @description User-controlled input used in path operations without validation may allow path traversal\n * @kind path-problem\n * @problem.severity error\n * @id py/path-traversal-platformdirs\n * @tags security\n *        external/cwe/cwe-22\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.Concepts\nimport semmle.python.ApiGraphs\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof RemoteFlowSource or\n    source instanceof DataFlow::ParameterNode\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"os\").getMember(\"path\").getMember([\"join\", \"normpath\", \"abspath\"]).getACall() and\n      sink = call.getArg(_)\n    ) or\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"pathlib\").getMember(\"Path\").getACall() and\n      sink = call.getArg(_)\n    )\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from $@.\", source.getNode(), \"user input\"",
