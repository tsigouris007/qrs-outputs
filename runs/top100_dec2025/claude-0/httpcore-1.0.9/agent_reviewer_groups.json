    "codeql_raw_query": "/**\n * @name Hardcoded Credentials or Secrets\n * @description Detects hardcoded passwords, API keys, or secrets\n * @kind problem\n * @problem.severity warning\n * @id py/hardcoded-credentials\n * @tags security\n *        external/cwe/cwe-798\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom StrConst str, string value\nwhere\n  value = str.getText() and\n  (\n    value.regexpMatch(\"(?i).*(password|passwd|pwd|secret|api[_-]?key|token|auth).*\") and\n    not value.regexpMatch(\"(?i).*(example|test|dummy|placeholder|sample).*\") and\n    str.getEnclosingModule().getName().matches(\"httpcore%\")\n  )\nselect str, \"Potential hardcoded credential or secret: \" + value",
    "hypothesis": "Detects hardcoded passwords, API keys, or secrets in the codebase",
