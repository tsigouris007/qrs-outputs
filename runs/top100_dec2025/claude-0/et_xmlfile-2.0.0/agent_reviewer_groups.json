    "codeql_query_uuid": "20251205222246",
    "codeql_raw_query": "/**\n * @name Insecure temporary file usage\n * @description Detects insecure temporary file creation\n * @kind problem\n * @problem.severity warning\n * @id py/insecure-temp-file-et-xmlfile\n * @tags security\n *       external/cwe/cwe-377\n *       external/cwe/cwe-732\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  // Check for mktemp usage (insecure)\n  call = API::moduleImport(\"tempfile\").getMember(\"mktemp\").getACall() or\n  // Check for NamedTemporaryFile with delete=False without secure permissions\n  (call = API::moduleImport(\"tempfile\").getMember(\"NamedTemporaryFile\").getACall() and\n   exists(call.getArgByName(\"delete\"))) or\n  // Check for open() with mode 'w' or 'a' without proper checks\n  (call = API::builtin(\"open\").getACall() and\n   exists(DataFlow::Node mode | mode = call.getArg(1) or mode = call.getArgByName(\"mode\")))\nselect call, \"Potential insecure file operation\"\n",
    "hypothesis": "Check for insecure temporary file creation or file operations with weak permissions",
    "severity": "medium",
