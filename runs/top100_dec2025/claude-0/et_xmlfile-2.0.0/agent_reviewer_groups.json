    "codeql_query_uuid": "20251205222515",
    "codeql_raw_query": "/**\n * @name Hardcoded credentials\n * @description Detects hardcoded passwords, API keys, or secrets\n * @kind problem\n * @problem.severity warning\n * @id py/hardcoded-credentials-et-xmlfile\n * @tags security\n *       external/cwe/cwe-798\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom StrConst str, string value\nwhere\n  value = str.getText() and\n  (\n    value.regexpMatch(\"(?i).*(password|passwd|pwd|secret|api[_-]?key|token|auth).*\") and\n    value.length() > 8 and\n    not value.regexpMatch(\"(?i).*(example|test|dummy|placeholder|your_|<|>|\\\\{|\\\\}).*\")\n  )\nselect str, \"Potential hardcoded credential: \" + value",
