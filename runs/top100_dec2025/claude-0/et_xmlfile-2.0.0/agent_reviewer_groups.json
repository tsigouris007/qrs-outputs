    "codeql_query_uuid": "20251205222453",
    "codeql_raw_query": "/**\n * @name Uncontrolled resource consumption\n * @description Detects potential denial of service through unbounded operations\n * @kind problem\n * @problem.severity warning\n * @id py/uncontrolled-resource-consumption-et-xmlfile\n * @tags security\n *       external/cwe/cwe-400\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call\nwhere\n  // Check for unbounded loops or operations on user input\n  exists(For loop, DataFlow::Node source |\n    source instanceof DataFlow::ParameterNode and\n    loop.getIter().getAFlowNode() = source.asCfgNode()\n  ) or\n  // Check for reading entire file without size limits\n  exists(DataFlow::CallCfgNode readCall |\n    readCall = call and\n    readCall.getFunction().asCfgNode().(AttrNode).getName() in [\"read\", \"readlines\"] and\n    not exists(readCall.getArg(0))\n  )\nselect call, \"Potential uncontrolled resource consumption\"",
    "hypothesis": "Check for denial of service vulnerabilities through unbounded operations like reading entire files without size limits or unbounded loops on user input",
