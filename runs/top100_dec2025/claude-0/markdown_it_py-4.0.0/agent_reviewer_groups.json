    "codeql_raw_query": "/**\n * @name Uncontrolled recursion\n * @description Recursive functions without proper depth limits can cause stack overflow\n * @kind problem\n * @problem.severity warning\n * @id py/uncontrolled-recursion\n * @tags security\n *        external/cwe/cwe-674\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom Function func, Call call\nwhere\n  call.getScope() = func and\n  call.getFunc().(Name).getId() = func.getName() and\n  not exists(If guard | guard.getScope() = func and guard.getTest().toString().matches(\"%depth%\"))\nselect func, \"Recursive function without apparent depth limit check.\"",
