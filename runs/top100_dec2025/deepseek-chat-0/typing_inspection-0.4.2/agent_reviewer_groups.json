    "codeql_raw_query": "/**\n * @name Unsafe type operations in typing inspection\n * @description Checking for potentially unsafe type casting or manipulation operations\n * @kind problem\n * @problem.severity warning\n * @id py/unsafe-type-operations\n * @tags security\n *        external/cwe/cwe-843\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  // Check for potentially unsafe type() usage with user input\n  call = API::builtin(\"type\").getACall()\n  or\n  // Check for isinstance with potentially untrusted input\n  call = API::builtin(\"isinstance\").getACall()\n  or\n  // Check for issubclass with potentially untrusted input\n  call = API::builtin(\"issubclass\").getACall()\n  or\n  // Check for getattr with potentially untrusted attribute names\n  call = API::builtin(\"getattr\").getACall()\n  or\n  // Check for setattr with potentially untrusted attribute names\n  call = API::builtin(\"setattr\").getACall()\n  or\n  // Check for hasattr with potentially untrusted attribute names\n  call = API::builtin(\"hasattr\").getACall()\n  or\n  // Check for eval with type-related operations\n  call = API::builtin(\"eval\").getACall()\n  or\n  // Check for exec with type-related operations\n  call = API::builtin(\"exec\").getACall()\nselect call, \"Potentially unsafe type operation that could lead to type confusion or security issues if used with untrusted input.\"",
    "hypothesis": "Unsafe type operations that could lead to type confusion or security issues",
