    "codeql_raw_query": "/**\n * @name Regular expression denial of service (ReDoS)\n * @description Regular expressions with exponential backtracking complexity can lead to denial of service\n * @kind problem\n * @problem.severity warning\n * @id py/redos\n * @tags security\n *        external/cwe/cwe-1333\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"re\").getMember([\"compile\", \"search\", \"match\", \"findall\", \"finditer\"]).getACall()\n  or\n  call = API::builtin(\"compile\").getACall() and call.getArg(0).asExpr().toString().matches(\".*re.*\")\nselect call, \"Regular expression operation that could be vulnerable to ReDoS attacks\"",
