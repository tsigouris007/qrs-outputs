   "codeql_raw_query": "/**\n * @name Potential Sinks\n * @description Find calls to potentially dangerous functions\n * @kind problem\n * @problem.severity warning\n * @id py/potential-sinks\n * @tags security\n *       external/cwe/cwe-078\n *       external/cwe/cwe-094\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall() or\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall() or\n  call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\"]).getACall() or\n  call = API::moduleImport(\"marshal\").getMember([\"load\", \"loads\"]).getACall() or\n  call = API::moduleImport(\"yaml\").getMember([\"load\", \"unsafe_load\"]).getACall() or\n  call = API::builtin(\"eval\").getACall() or\n  call = API::builtin(\"exec\").getACall()\nselect call, \"Potential dangerous sink called\"",
