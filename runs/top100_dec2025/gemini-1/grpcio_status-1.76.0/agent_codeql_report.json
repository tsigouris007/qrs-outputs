   "codeql_raw_query": "/**\n * @name Logging of Sensitive Information\n * @description Detects logging of data that might be sensitive or untrusted.\n * @kind problem\n * @problem.severity warning\n * @id py/sensitive-logging\n * @tags security\n *       external/cwe/cwe-532\n *       external/cwe/cwe-117\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"logging\").getMember([\"debug\", \"info\", \"warning\", \"error\", \"critical\", \"exception\", \"log\"]).getACall() or\n  call = API::moduleImport(\"logging\").getMember(\"Logger\").getASubclass().getMember([\"debug\", \"info\", \"warning\", \"error\", \"critical\", \"exception\", \"log\"]).getACall()\nselect call, \"Potential logging of sensitive or untrusted information.\"\n",
