    "codeql_raw_query": "/**\n * @name Code injection in _make.py\n * @description Tracing flow from public API to exec/eval calls in _make.py\n * @kind path-problem\n * @problem.severity error\n * @id py/attrs-code-injection\n * @tags security\n *       external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\n\nmodule CodeInjectionConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Treat parameters of public functions in _make.py or the main `attr` API as sources\n    // This is a heuristic. We are looking for things like attribute names or types.\n    exists(DataFlow::ParameterNode p |\n      p = source and\n      (\n        p.getScope().getEnclosingModule().getName().matches(\"%attr%\")\n      )\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    sink = any(CodeExecution ce).getCode()\n  }\n}\n\nmodule CodeInjectionFlow = TaintTracking::Global<CodeInjectionConfig>;\nimport CodeInjectionFlow::PathGraph\n\nfrom CodeInjectionFlow::PathNode source, CodeInjectionFlow::PathNode sink\nwhere CodeInjectionFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Code injection from $@.\", source.getNode(), \"parameter\"",
