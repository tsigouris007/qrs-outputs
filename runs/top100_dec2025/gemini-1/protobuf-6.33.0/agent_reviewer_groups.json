    "codeql_raw_query": "/**\n * @name Potentially unsafe operations\n * @description Checks for pickle usage and dynamic code execution\n * @kind problem\n * @problem.severity warning\n * @id py/unsafe-ops-check\n * @tags security\n *       external/cwe/cwe-502\n *       external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall() or\n    call = API::moduleImport(\"builtins\").getMember([\"eval\", \"exec\"]).getACall()\n  )\nselect call, \"Potentially unsafe operation: \" + call.getNode().toString()",
