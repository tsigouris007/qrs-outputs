    "codeql_query_uuid": "20251228143544",
    "codeql_raw_query": "/**\n * @name User-controlled setattr attribute\n * @description Detects if the attribute name in setattr is influenced by function arguments\n * @kind path-problem\n * @problem.severity warning\n * @id py/tainted-setattr\n * @tags security\n *       external/cwe/cwe-915\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule SetattrTaintConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof DataFlow::ParameterNode\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::builtin(\"setattr\").getACall() and\n      sink = call.getArg(1)\n    )\n  }\n}\n\nmodule SetattrTaintFlow = TaintTracking::Global<SetattrTaintConfig>;\nimport SetattrTaintFlow::PathGraph\n\nfrom SetattrTaintFlow::PathNode source, SetattrTaintFlow::PathNode sink\nwhere SetattrTaintFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Attribute name in setattr depends on function parameter $@\", source.getNode(), \"param\"\n",
    "hypothesis": "The package uses setattr with user-controlled input, potentially leading to object modification.",
    "severity": "high",
    "cwe_ids": [
