    "codeql_raw_query": "/**\n * @name Check for main block\n * @description Check if files have if __name__ == \"__main__\": block\n * @kind problem\n * @problem.severity warning\n * @id py/check-main-block\n */\n\nimport python\n\nfrom If i, Compare c, Name n, StrConst s\nwhere\n  i.getTest() = c and\n  c.getOp(0) instanceof Eq and\n  c.getLeft() = n and\n  n.getId() = \"__name__\" and\n  c.getComparator(0) = s and\n  s.getText() = \"__main__\" and\n  i.getLocation().getFile().getShortName() in [\"to_interpreter.py\", \"to_process.py\"]\nselect i, \"File has a main block, indicating it can be run as a script.\"",
