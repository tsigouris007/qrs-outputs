   "codeql_raw_query": "/**\n * @name Untrusted Data to Pickle\n * @description Tracing data flow from potential sources to pickle.loads\n * @kind path-problem\n * @problem.severity error\n * @id py/pickle-dataflow\n * @tags security\n *        external/cwe/cwe-502\n */\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule PickleFlowConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Broad sources: function parameters, stdin, sockets\n    source instanceof DataFlow::ParameterNode or\n    source = API::moduleImport(\"sys\").getMember(\"stdin\").asSource() or\n    source = API::moduleImport(\"sys\").getMember(\"stdin\").getMember(\"buffer\").asSource() or\n    source = API::moduleImport(\"sys\").getMember(\"stdin\").getMember(\"read\").getACall() or\n    source = API::moduleImport(\"sys\").getMember(\"stdin\").getMember(\"buffer\").getMember(\"read\").getACall()\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"pickle\").getMember(\"loads\").getACall() and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule PickleFlow = TaintTracking::Global<PickleFlowConfig>;\nimport PickleFlow::PathGraph\n\nfrom PickleFlow::PathNode source, PickleFlow::PathNode sink\nwhere PickleFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Pickle loads data from $@\", source.getNode(), \"source\"\n",
