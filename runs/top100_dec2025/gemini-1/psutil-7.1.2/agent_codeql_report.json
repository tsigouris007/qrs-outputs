  {
   "codeql_query_uuid": "20251231153140",
   "codeql_raw_query": "/**\n * @name Insecure temporary file creation\n * @description Creating a temporary file using insecure methods can lead to race conditions.\n * @kind problem\n * @problem.severity warning\n * @id py/insecure-temp-file\n * @tags security\n *       external/cwe/cwe-377\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"tempfile\").getMember(\"mktemp\").getACall() or\n  call = API::moduleImport(\"os\").getMember([\"tempnam\", \"tmpnam\"]).getACall()\nselect call, \"Insecure temporary file creation.\"\n",
