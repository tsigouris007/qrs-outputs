  {
   "codeql_query_uuid": "20251231153116",
   "codeql_raw_query": "/**\n * @name Subprocess with shell=True\n * @description Using subprocess with shell=True can be dangerous if arguments are not properly sanitized.\n * @kind problem\n * @problem.severity warning\n * @id py/subprocess-shell-true\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node shellArg\nwhere\n  call = API::moduleImport(\"subprocess\").getMember([\"Popen\", \"call\", \"check_call\", \"check_output\", \"run\"]).getACall() and\n  shellArg = call.getArgByName(\"shell\") and\n  shellArg.asExpr().(BooleanLiteral).booleanValue() = true\nselect call, \"Call to subprocess with shell=True.\"\n",
   "hypothesis": "Subprocess calls with shell=True significantly increase the risk of command injection.",
   "severity": "high",
   "cwe_ids": [
    "cwe-78"
