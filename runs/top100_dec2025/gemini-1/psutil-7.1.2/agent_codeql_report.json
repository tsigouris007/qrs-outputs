   "codeql_raw_query": "/**\n * @name Insecure temporary file creation\n * @description Creating a temporary file with insecure permissions or using unsafe temporary file functions can lead to race conditions or information disclosure.\n * @kind problem\n * @problem.severity warning\n * @id py/insecure-temporary-file\n * @tags security\n *       external/cwe/cwe-377\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"tempfile\").getMember(\"mktemp\").getACall() or\n    call = API::moduleImport(\"os\").getMember(\"tempnam\").getACall() or\n    call = API::moduleImport(\"os\").getMember(\"tmpnam\").getACall()\n  )\nselect call, \"Use of insecure temporary file function.\"",
