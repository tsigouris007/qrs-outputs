   "codeql_query_uuid": "20251231152543",
   "codeql_raw_query": "/**\n * @name Subprocess with shell=True and variable command\n * @description executing subprocess with shell=True and a non-literal command is dangerous\n * @kind problem\n * @problem.severity high\n * @id py/subprocess-shell-true\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node command\nwhere\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall() and\n  call.getArgByName(\"shell\").asExpr().(BooleanLiteral).booleanValue() = true and\n  (\n    command = call.getArg(0) or\n    command = call.getArgByName(\"args\")\n  ) and\n  not command.asExpr() instanceof StringLiteral\nselect call, \"subprocess call with shell=True and non-literal command argument\"\n",
   "hypothesis": "Subprocess calls with shell=True and variable arguments are vulnerable to command injection.",
   "severity": "high",
   "cwe_ids": [
    "cwe-78"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20251231153044",
   "codeql_raw_query": "/**\n * @name Use of eval or exec\n * @description Using eval or exec can be dangerous if used with untrusted input\n * @kind problem\n * @problem.severity warning\n * @id py/unsafe-code-execution\n * @tags security\n *        external/cwe/cwe-094\n *        external/cwe/cwe-095\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin(\"eval\").getACall() or\n  call = API::builtin(\"exec\").getACall()\nselect call, \"Call to eval or exec.\"\n",
   "hypothesis": "Check for usage of eval or exec which are potential code injection vectors.",
