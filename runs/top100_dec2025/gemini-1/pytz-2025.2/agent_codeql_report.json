   "codeql_query_uuid": "20260101135557",
   "codeql_raw_query": "/**\n * @name Pytz Traversal Final Attempt\n * @description Flow from timezone arg to file open\n * @kind path-problem\n * @problem.severity error\n * @id py/pytz-traversal-final\n * @tags security\n *       external/cwe/cwe-022\n */\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\n\nmodule Config implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    exists(DataFlow::ParameterNode p |\n      p.getParameter().getName() = \"zone\" and\n      source = p\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    sink = any(FileSystemAccess fa).getAPathArgument()\n  }\n}\n\nmodule Flow = TaintTracking::Global<Config>;\nimport Flow::PathGraph\n\nfrom Flow::PathNode source, Flow::PathNode sink\nwhere Flow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Traversal from $@.\", source.getNode(), \"zone arg\"\n",
   "hypothesis": "Checking if 'zone' parameter flows to file open, indicating potential path traversal if input is not validated against a allowlist.",
