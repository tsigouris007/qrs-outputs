    "codeql_raw_query": "/**\n * @name File Opens\n * @description Find all calls to open() or equivalent to understand file access patterns.\n * @kind problem\n * @problem.severity info\n * @id py/file-opens\n * @tags security\n *       external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin(\"open\").getACall() or\n  call = API::moduleImport(\"pkg_resources\").getMember(\"resource_stream\").getACall()\nselect call, \"File opening operation\"\n",
