    "codeql_raw_query": "/**\n * @name Regex Extraction for ReDoS Analysis\n * @description Extracts regex patterns used in the library to manually analyze for ReDoS vulnerabilities.\n * @kind problem\n * @problem.severity warning\n * @id py/regex-extraction\n * @tags security\n *       external/cwe/cwe-1333\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::ExprNode regexArg\nwhere\n  (\n    call = API::moduleImport(\"re\").getMember([\"compile\", \"match\", \"search\", \"findall\", \"finditer\", \"split\", \"sub\", \"subn\"]).getACall()\n    and regexArg = call.getArg(0)\n  )\nselect regexArg, \"Regular expression pattern used: \" + regexArg.asExpr().(StrConst).getText()\n",
