    "codeql_raw_query": "/**\n * @name Lxml Parser Configuration for XXE\n * @description Checks how lxml parsers are configured, looking for insecure entity resolution.\n * @kind problem\n * @problem.severity error\n * @id py/lxml-xxe-config\n * @tags security\n *       external/cwe/cwe-611\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"lxml\").getMember(\"etree\").getMember([\"XMLParser\", \"HTMLParser\"]).getACall()\nselect call, \"lxml parser instantiation found. Check arguments for entity resolution settings.\"\n",
