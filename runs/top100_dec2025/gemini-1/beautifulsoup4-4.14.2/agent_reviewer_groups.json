    "codeql_query_uuid": "20251225045025",
    "codeql_raw_query": "/**\n * @name LXML XXE Configuration Check\n * @description Checks if lxml parser is configured to forbid entity resolution (XXE prevention)\n * @kind problem\n * @problem.severity error\n * @id py/lxml-xxe-check\n * @tags security\n *        external/cwe/cwe-611\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::ArgumentNode arg\nwhere\n  (\n    call = API::moduleImport(\"lxml\").getMember(\"etree\").getMember([\"XMLParser\", \"HTMLParser\"]).getACall() or\n    call = API::moduleImport(\"lxml\").getMember(\"html\").getMember(\"HTMLParser\").getACall()\n  ) and\n  (\n    arg = call.getArgByName(\"resolve_entities\") and\n    not arg.asExpr().(BooleanLiteral).booleanValue() = false\n    or\n    not exists(call.getArgByName(\"resolve_entities\"))\n    or\n    arg = call.getArgByName(\"no_network\") and\n    not arg.asExpr().(BooleanLiteral).booleanValue() = true\n  )\nselect call, \"lxml parser instantiation might allow network access or entity resolution.\"\n",
    "hypothesis": "LXML parser configured without XXE protection (resolve_entities=False or no_network=True).",
    "severity": "high",
    "cwe_ids": [
