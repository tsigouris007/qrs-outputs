   "codeql_raw_query": "/**\n * @name Dangerous Sinks\n * @description Detects calls to dangerous functions like eval, exec, subprocess, etc.\n * @kind problem\n * @problem.severity error\n * @id py/dangerous-sinks\n * @tags security\n *       external/cwe/cwe-078\n *       external/cwe/cwe-094\n *       external/cwe/cwe-095\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall() or\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall() or\n  call = API::moduleImport(\"builtins\").getMember([\"eval\", \"exec\", \"compile\"]).getACall()\nselect call, \"Potential dangerous sink found.\"\n",
