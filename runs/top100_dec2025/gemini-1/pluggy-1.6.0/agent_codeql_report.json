   "codeql_query_uuid": "20251228141934",
   "codeql_raw_query": "/**\n * @name Dynamic Code Execution\n * @description Detects usage of dynamic code execution functions like eval, exec, and compile.\n * @kind problem\n * @problem.severity warning\n * @id py/dynamic-code-execution-discovery\n * @tags security\n *       external/cwe/cwe-094\n *       external/cwe/cwe-095\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call.getFunction().asCfgNode().(NameNode).getId() in [\"eval\", \"exec\", \"compile\"]\nselect call, \"Usage of dynamic code execution function.\"\n",
