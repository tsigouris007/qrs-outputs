   "codeql_query_uuid": "20251228141557",
   "codeql_raw_query": "/**\n * @name Dynamic Code Execution\n * @description Detects usage of exec() or eval() which can be dangerous if used with untrusted input.\n * @kind problem\n * @problem.severity warning\n * @id py/dynamic-code-execution\n * @tags security\n *       external/cwe/cwe-094\n *       external/cwe/cwe-095\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin(\"exec\").getACall() or\n  call = API::builtin(\"eval\").getACall()\nselect call, \"Call to dynamic execution function.\"",
   "hypothesis": "Usage of exec or eval indicates potential code injection risks.",
   "severity": "medium",
   "cwe_ids": [
    "CWE-94",
    "CWE-95"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20251228141719",
   "codeql_raw_query": "/**\n * @name Command Injection\n * @description Detects command injection vulnerabilities where user input is passed to system command execution APIs.\n * @kind path-problem\n * @problem.severity error\n * @id py/command-injection\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.Concepts\nimport semmle.python.ApiGraphs\n\nmodule CommandInjectionConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof RemoteFlowSource\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    sink = any(SystemCommandExecution c).getCommand()\n  }\n}\n\nmodule CommandInjectionFlow = TaintTracking::Global<CommandInjectionConfig>;\nimport CommandInjectionFlow::PathGraph\n\nfrom CommandInjectionFlow::PathNode source, CommandInjectionFlow::PathNode sink\nwhere CommandInjectionFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential command injection from $@.\", source.getNode(), \"untrusted input\"\n",
   "hypothesis": "Check for command injection via subprocess or os.system with remote sources.",
   "severity": "high",
   "cwe_ids": [
    "CWE-78"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20251228141805",
   "codeql_raw_query": "/**\n * @name Dynamic Import Injection\n * @description Detecting dynamic imports with potentially user-controlled input\n * @kind path-problem\n * @problem.severity error\n * @id py/dynamic-import-injection\n * @tags security\n *       external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule DynamicImportConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof DataFlow::ParameterNode\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"importlib\").getMember(\"import_module\").getACall() or\n      call = API::builtin(\"__import__\").getACall()\n      |\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule DynamicImportFlow = TaintTracking::Global<DynamicImportConfig>;\nimport DynamicImportFlow::PathGraph\n\nfrom DynamicImportFlow::PathNode source, DynamicImportFlow::PathNode sink\nwhere DynamicImportFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Dynamic import from $@.\", source.getNode(), \"parameter\"\n",
   "hypothesis": "Dynamic imports using untrusted input can allow an attacker to load arbitrary modules, potentially leading to code execution.",
   "severity": "high",
   "cwe_ids": [
    "CWE-94"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20251228141915",
   "codeql_raw_query": "/**\n * @name Subprocess Usage Discovery\n * @description Finds all usages of subprocess and os.system/popen to identify potential command injection sinks.\n * @kind problem\n * @problem.severity warning\n * @id py/subprocess-discovery\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall() or\n  call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall()\nselect call, \"Call to subprocess or system command execution.\"\n",
   "hypothesis": "Discovery of potential command injection sinks in the codebase.",
