    "codeql_raw_query": "/**\n * @name Subprocess Usage Discovery\n * @description Finds all usages of subprocess and os.system/popen to identify potential command injection sinks.\n * @kind problem\n * @problem.severity warning\n * @id py/subprocess-discovery\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall() or\n  call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall()\nselect call, \"Call to subprocess or system command execution.\"\n",
