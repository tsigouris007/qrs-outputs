    "codeql_raw_query": "/**\n * @name Subprocess calls\n * @description Find all calls to subprocess module to check for command injection risks.\n * @kind problem\n * @problem.severity warning\n * @id py/subprocess-usage\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"Popen\", \"run\"]).getACall()\nselect call, \"Call to subprocess found.\"",
