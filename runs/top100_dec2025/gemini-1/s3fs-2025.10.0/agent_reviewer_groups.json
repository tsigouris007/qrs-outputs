    "codeql_query_uuid": "20260101143724",
    "codeql_raw_query": "/**\n * @name Potential Path Traversal\n * @description file access with untrusted input\n * @kind path-problem\n * @problem.severity error\n * @id py/path-traversal-s3fs\n * @tags security\n *       external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Treat all parameters of public methods in s3fs.core as sources\n    exists(Function f |\n      f.getScope().getEnclosingModule().getName().matches(\"s3fs%\") and\n      source instanceof DataFlow::ParameterNode and\n      source.getScope() = f\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    sink = any(FileSystemAccess fa).getAPathArgument()\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from $@.\", source.getNode(), \"parameter\"\n",
    "hypothesis": "S3FS might allow local file system access via path traversal if it caches files locally using unsanitized S3 keys.",
    "severity": "high",
    "cwe_ids": [
     "CWE-22"
    ],
