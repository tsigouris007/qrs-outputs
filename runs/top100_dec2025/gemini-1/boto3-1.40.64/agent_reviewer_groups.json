    "codeql_raw_query": "/**\n * @name JMESPath Injection Search\n * @description Detects usage of jmespath search with potentially untrusted input.\n * @kind problem\n * @problem.severity warning\n * @id py/jmespath-injection\n * @tags security\n *       external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"jmespath\").getMember(\"search\").getACall() or\n  call = API::moduleImport(\"jmespath\").getMember(\"compile\").getACall()\nselect call, \"Potential JMESPath injection point.\"\n",
