    "codeql_query_uuid": "20251225125534",
    "codeql_raw_query": "/**\n * @name JMESPath Injection Taint Tracking\n * @description Detects if function parameters flow into JMESPath queries.\n * @kind path-problem\n * @problem.severity error\n * @id py/jmespath-injection-taint\n * @tags security\n *       external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule JmesPathConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof DataFlow::ParameterNode\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"jmespath\").getMember([\"search\", \"compile\"]).getACall() and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule JmesPathFlow = TaintTracking::Global<JmesPathConfig>;\nimport JmesPathFlow::PathGraph\n\nfrom JmesPathFlow::PathNode source, JmesPathFlow::PathNode sink\nwhere JmesPathFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"JMESPath expression depends on $@.\", source.getNode(), \"parameter\"\n",
    "hypothesis": "User-controlled input flows into JMESPath compilation or search, leading to injection.",
    "severity": "medium",
