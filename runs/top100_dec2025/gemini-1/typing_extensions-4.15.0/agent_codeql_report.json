   "codeql_raw_query": "/**\n * @name Find eval and exec calls\n * @description Locates all calls to eval() and exec() to check for potential code injection vulnerabilities.\n * @kind problem\n * @problem.severity warning\n * @id py/find-eval-exec\n * @tags security\n *       external/cwe/cwe-094\n *       external/cwe/cwe-095\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin(\"eval\").getACall() or\n  call = API::builtin(\"exec\").getACall()\nselect call, \"Call to eval or exec detected.\"",
