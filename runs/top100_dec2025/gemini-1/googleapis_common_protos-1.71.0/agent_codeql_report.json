   "codeql_query_uuid": "20251226134643",
   "codeql_raw_query": "/**\n * @name Dangerous function calls\n * @description Detects calls to dangerous functions like exec, eval, and os.system\n * @kind problem\n * @problem.severity error\n * @id py/dangerous-calls\n * @tags security\n *       external/cwe/cwe-078\n *       external/cwe/cwe-094\n *       external/cwe/cwe-095\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin([\"exec\", \"eval\"]).getACall() or\n  call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall() or\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall()\nselect call, \"Call to dangerous function.\"\n",
   "hypothesis": "The package might contain dangerous function calls indicating a backdoor or insecure code.",
   "severity": "critical",
   "cwe_ids": [
    "CWE-78",
    "CWE-94",
    "CWE-95"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20251226134721",
   "codeql_raw_query": "/**\n * @name Insecure Deserialization\n * @description Detects usage of insecure deserialization libraries.\n * @kind problem\n * @problem.severity error\n * @id py/insecure-deserialization\n * @tags security\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport([\"pickle\", \"_pickle\", \"cPickle\", \"dill\", \"marshal\", \"shelve\"]).getMember([\"load\", \"loads\", \"dump\", \"dumps\"]).getACall()\n  or\n  call = API::moduleImport(\"yaml\").getMember([\"load\", \"full_load\"]).getACall()\nselect call, \"Potential insecure deserialization detected.\"",
   "hypothesis": "The package might use insecure deserialization libraries like pickle or yaml.",
   "severity": "high",
   "cwe_ids": [
    "CWE-502"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20251226134755",
   "codeql_raw_query": "/**\n * @name Suspicious behavior in setup.py\n * @description specific check for dangerous operations in setup.py\n * @kind problem\n * @problem.severity high\n * @id py/suspicious-setup\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call.getLocation().getFile().getShortName() = \"setup.py\" and\n  (\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall() or\n    call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"run\", \"Popen\"]).getACall() or\n    call = API::moduleImport(\"urllib.request\").getMember(\"urlopen\").getACall() or\n    call = API::moduleImport(\"requests\").getMember([\"get\", \"post\"]).getACall() or\n    call = API::moduleImport(\"socket\").getMember(\"socket\").getACall()\n  )\nselect call, \"Suspicious call in setup.py: \" + call.getFunction().toString()\n",
   "hypothesis": "Malicious code execution in setup.py",
   "severity": "high",
   "cwe_ids": [
    "cwe-78"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20251226134841",
   "codeql_raw_query": "/**\n * @name Hardcoded secrets\n * @description Detects hardcoded secrets such as API keys, passwords, or tokens.\n * @kind problem\n * @problem.severity error\n * @id py/hardcoded-secrets\n * @tags security\n *       external/cwe/cwe-798\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::Node node, StringLiteral str\nwhere\n    node.asExpr() = str and\n    (\n        str.getText().regexpMatch(\"(?i).*(password|secret|api_key|token|auth).{0,20}=.*\") or\n        str.getText().regexpMatch(\"AIza[0-9A-Za-z-_]{35}\") // Google API Key pattern\n    )\nselect node, \"Potential hardcoded secret found.\"\n",
   "hypothesis": "Hardcoded secrets like API keys or passwords might be present in the source code.",
   "severity": "high",
   "cwe_ids": [
    "CWE-798"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20251226134920",
   "codeql_raw_query": "/**\n * @name Hardcoded credentials\n * @description Detecting hardcoded credentials such as API keys, passwords, or tokens.\n * @kind problem\n * @problem.severity error\n * @id py/hardcoded-credentials\n * @tags security\n *       external/cwe/cwe-798\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::Node node\nwhere\n  (\n    node.asExpr().(StrConst).getText().regexpMatch(\"(?i).*(password|secret|api_key|token|auth).*\") and\n    not node.asExpr().(StrConst).getText().regexpMatch(\"(?i).*(example|test|default|placeholder).*\") and\n    node.asExpr().(StrConst).getText().length() > 8\n  )\nselect node, \"Possible hardcoded credential.\"",
   "hypothesis": "Hardcoded credentials might be present in the source code.",
   "severity": "medium",
