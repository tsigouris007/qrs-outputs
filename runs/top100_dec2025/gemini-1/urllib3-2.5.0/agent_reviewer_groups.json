    "codeql_query_uuid": "20260102155810",
    "codeql_raw_query": "/**\n * @name Hostname Verification Disabled\n * @description Disabling hostname verification (assert_hostname=False or check_hostname=False) allows Man-in-the-Middle attacks.\n * @kind problem\n * @problem.severity error\n * @id py/urllib3/hostname-verification-disabled\n * @tags security\n *       external/cwe/cwe-295\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::Node node\nwhere\n  // Check for setting assert_hostname = False\n  exists(DataFlow::CallCfgNode call |\n    (\n        call = API::moduleImport(\"urllib3\").getMember(\"PoolManager\").getACall() or\n        call = API::moduleImport(\"urllib3\").getMember(\"connection_from_url\").getACall() or\n        call = API::moduleImport(\"urllib3\").getMember(\"HTTPSConnectionPool\").getACall()\n    ) and\n    (\n        call.getArgByName(\"assert_hostname\").asExpr().(BooleanLiteral).booleanValue() = false\n        or\n        call.getArgByName(\"check_hostname\").asExpr().(BooleanLiteral).booleanValue() = false\n    )\n    and node = call\n  )\n  or\n  // Check for assigning False to check_hostname attribute of an SSLContext\n  exists(DataFlow::AttrWrite write |\n    write.getAttributeName() = \"check_hostname\" and\n    write.getValue().asExpr().(BooleanLiteral).booleanValue() = false and\n    node = write\n  )\nselect node, \"Hostname verification is explicitly disabled, allowing potential MitM attacks.\"\n",
    "hypothesis": "Explicitly disabling hostname verification makes connections susceptible to Man-in-the-Middle attacks.",
    "severity": "high",
    "cwe_ids": [
     "cwe-295"
    ],
    "results_count": 3,
