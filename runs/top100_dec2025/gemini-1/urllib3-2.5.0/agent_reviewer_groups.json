    "codeql_raw_query": "/**\n * @name Disabled SSL Verification\n * @description Detecting instances where SSL certificate verification is disabled.\n * @kind problem\n * @problem.severity error\n * @id py/urllib3/disabled-ssl\n * @tags security\n *       external/cwe/cwe-295\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::Node node\nwhere\n  (\n    // Checking for ssl.CERT_NONE\n    node = API::moduleImport(\"ssl\").getMember(\"CERT_NONE\").getAValueReachableFromSource()\n    or\n    // Checking for verify_mode = ssl.CERT_NONE in context creation\n    exists(DataFlow::CallCfgNode call |\n       call = API::moduleImport(\"ssl\").getMember(\"create_default_context\").getACall() and\n       call.getArgByName(\"check_hostname\").asExpr().(BooleanLiteral).booleanValue() = false\n    )\n  )\nselect node, \"Potential disabled SSL verification.\"\n",
    "hypothesis": "Checking for disabled SSL verification (CERT_NONE or check_hostname=False).",
