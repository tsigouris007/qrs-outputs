    "codeql_raw_query": "/**\n * @name File system access\n * @description Finds calls to open() and other file system access methods\n * @kind problem\n * @problem.severity warning\n * @id py/file-system-access\n * @tags security\n *       external/cwe/cwe-022\n *       external/cwe/cwe-023\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin(\"open\").getACall() or\n  call = API::moduleImport(\"pathlib\").getMember(\"Path\").getACall() or\n  call = API::moduleImport(\"pathlib\").getMember(\"Path\").getReturn().getMember([\"read_text\", \"read_bytes\", \"open\", \"write_text\", \"write_bytes\"]).getACall()\nselect call, \"File system access detected.\"",
