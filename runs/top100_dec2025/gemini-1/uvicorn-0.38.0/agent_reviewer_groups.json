    "codeql_query_uuid": "20260103110414",
    "codeql_raw_query": "/**\n * @name Insecure SSL Configuration\n * @description Checks for insecure SSL context creation or configuration in Uvicorn.\n * @kind problem\n * @problem.severity warning\n * @id py/uvicorn/insecure-ssl\n * @tags security\n *       external/cwe/cwe-327\n *       external/cwe/cwe-295\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"ssl\").getMember(\"SSLContext\").getACall() or\n  call = API::moduleImport(\"ssl\").getMember(\"create_default_context\").getACall() or\n  call = API::moduleImport(\"ssl\").getMember(\"_create_unverified_context\").getACall()\nselect call, \"SSL Context creation found. Check for insecure protocol versions or settings.\"\n",
    "hypothesis": "Weak SSL/TLS configuration can allow man-in-the-middle attacks.",
