   {
    "codeql_query_uuid": "20251231164924",
    "codeql_raw_query": "/**\n * @name Identify function containing sink\n * @description Find the function definition that contains the subprocess call in src/_pytest/_py/path.py\n * @kind problem\n * @problem.severity medium\n * @id py/identify-sink-function\n * @tags research\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode sink, Function func\nwhere\n  sink.getLocation().getFile().getRelativePath() = \"src/_pytest/_py/path.py\" and\n  sink.getLocation().getStartLine() = 1169 and\n  sink.getScope() = func\nselect sink, \"Sink is in function: \" + func.getName()\n",
    "hypothesis": "Identify the function containing the sink to understand its usage context.",
    "severity": "medium",
    "cwe_ids": [
     "CWE-78"
    ],
