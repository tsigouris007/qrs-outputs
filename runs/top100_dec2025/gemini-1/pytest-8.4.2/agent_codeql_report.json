   "codeql_raw_query": "/**\n * @name Inspect argument to eval in expression.py\n * @description Check if the argument to eval in src/_pytest/mark/expression.py is a code object or string, and where it comes from locally.\n * @kind problem\n * @problem.severity warning\n * @id py/inspect-eval-argument\n * @tags security\n *       external/cwe/cwe-095\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode evalCall, DataFlow::Node arg\nwhere\n  evalCall = API::builtin(\"eval\").getACall() and\n  evalCall.getLocation().getFile().getShortName() = \"expression.py\" and\n  arg = evalCall.getArg(0)\nselect evalCall, \"eval called with argument from $@\", arg, arg.toString()\n",
