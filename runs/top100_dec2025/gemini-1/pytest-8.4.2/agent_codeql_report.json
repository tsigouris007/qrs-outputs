   "codeql_query_uuid": "20251231164755",
   "codeql_raw_query": "/**\n * @name Dangerous subprocess usage in library code\n * @description specific check for shell=True or os.system/popen in non-test files\n * @kind problem\n * @problem.severity error\n * @id py/dangerous-subprocess-audit\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    (\n      call = API::moduleImport(\"subprocess\").getMember([\"Popen\", \"call\", \"check_call\", \"check_output\", \"run\"]).getACall() and\n      call.getArgByName(\"shell\").asExpr().(BooleanLiteral).booleanValue() = true\n    ) or\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall()\n  ) and\n  not call.getLocation().getFile().getAbsolutePath().matches(\"%/testing/%\") and\n  not call.getLocation().getFile().getAbsolutePath().matches(\"%/bench/%\") and\n  not call.getLocation().getFile().getAbsolutePath().matches(\"%/scripts/%\")\nselect call, \"Dangerous subprocess usage with shell=True or os.system/popen.\"",
   "hypothesis": "Command injection via unsafe subprocess usage in library code",
   "severity": "high",
   "cwe_ids": [
    "CWE-78"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20251231164823",
   "codeql_raw_query": "/**\n * @name Subprocess calls in scripts\n * @description List all subprocess calls in the scripts directory for manual review\n * @kind problem\n * @problem.severity warning\n * @id py/scripts-subprocess-audit\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, File f\nwhere\n  (\n    call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall() or\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall()\n  ) and\n  f = call.getLocation().getFile() and\n  f.getRelativePath().matches(\"scripts/%\")\nselect call, \"Subprocess call in script: \" + f.getRelativePath()\n",
