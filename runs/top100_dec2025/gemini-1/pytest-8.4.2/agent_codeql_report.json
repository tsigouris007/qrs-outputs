   "codeql_raw_query": "/**\n * @name Potentially unsafe deserialization or code execution\n * @description Detects usage of eval, exec, pickle, or yaml.load which can be dangerous if used with untrusted input.\n * @kind problem\n * @problem.severity warning\n * @id py/unsafe-execution-deserialization\n * @tags security\n *       external/cwe/cwe-502\n *       external/cwe/cwe-094\n *       external/cwe/cwe-095\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall() or\n    call = API::moduleImport(\"yaml\").getMember([\"load\", \"unsafe_load\"]).getACall() or\n    call = API::moduleImport(\"marshal\").getMember([\"load\", \"loads\"]).getACall() or\n    call = API::moduleImport(\"shelve\").getMember(\"open\").getACall() or\n    call = API::builtin(\"eval\").getACall() or\n    call = API::builtin(\"exec\").getACall()\n  )\nselect call, \"Potential unsafe execution or deserialization sink.\"",
