   "codeql_raw_query": "/**\n * @name Identify eval calls in src\n * @description Find calls to eval() in the src directory to check for code injection risks.\n * @kind problem\n * @problem.severity warning\n * @id py/eval-in-src\n * @tags security\n *       external/cwe/cwe-095\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin(\"eval\").getACall() and\n  call.getLocation().getFile().getRelativePath().regexpMatch(\"src/.*\")\nselect call, \"Call to eval() found in src.\"\n",
