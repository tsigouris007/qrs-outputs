    "codeql_raw_query": "/**\n * @name Potentially unsafe operations\n * @description Checking for eval, exec, subprocess, and pickle usage\n * @kind problem\n * @problem.severity warning\n * @id py/unsafe-operations\n * @tags security\n *       external/cwe/cwe-094\n *       external/cwe/cwe-078\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::builtin([\"eval\", \"exec\"]).getACall() or\n    call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall() or\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall() or\n    call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\"]).getACall()\n  )\nselect call, \"Potentially unsafe operation: \" + call.getFunction().toString()\n",
    "hypothesis": "The package might use unsafe functions like eval, exec, subprocess, or pickle, leading to code injection, command injection, or unsafe deserialization.",
