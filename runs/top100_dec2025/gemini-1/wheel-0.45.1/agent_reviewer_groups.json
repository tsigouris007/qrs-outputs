    "codeql_query_uuid": "20260103112003",
    "codeql_raw_query": "/**\n * @name Subprocess calls with dynamic arguments\n * @description Findings calls to subprocess functions where the command is not a constant string.\n * @kind problem\n * @problem.severity warning\n * @id py/subprocess-dynamic\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::ExprNode arg\nwhere\n  (\n    call = API::moduleImport(\"subprocess\").getMember([\"run\", \"call\", \"check_call\", \"check_output\", \"Popen\"]).getACall() or\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall()\n  ) and\n  (\n    arg = call.getArg(0)\n  ) and\n  not exists(arg.asExpr().(Str))\nselect call, \"Subprocess call with dynamic argument: \" + arg.asExpr().toString()\n",
    "hypothesis": "Dynamic arguments in subprocess calls may lead to command injection if not properly sanitized or if shell=True is used.",
