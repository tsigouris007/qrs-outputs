   "codeql_query_uuid": "20251226142334",
   "codeql_raw_query": "/**\n * @name Assert statement in production code\n * @description Assert statements should not be used for validation as they can be optimized away.\n * @kind problem\n * @problem.severity warning\n * @id py/assert-in-production\n * @tags reliability\n *       security\n *       external/cwe/cwe-617\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom Assert a\nwhere not a.getScope().inSource() // exclude tests if possible, though 'inSource' might not be enough.\n      // A better heuristic for tests is file path.\n      and not a.getLocation().getFile().getShortName().matches(\"test_%\")\n      and not a.getLocation().getFile().getShortName().matches(\"%_test.py\")\nselect a, \"Assert statement used in library code.\"\n",
