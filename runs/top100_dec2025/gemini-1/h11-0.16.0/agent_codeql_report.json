   "codeql_query_uuid": "20251226141938",
   "codeql_raw_query": "/**\n * @name Extract regex patterns\n * @description Extracts regex patterns used in re.compile, match, search, etc.\n * @kind problem\n * @problem.severity warning\n * @id py/extract-all-regex\n * @tags security\n *       external/cwe/cwe-1333\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node arg\nwhere\n  call = API::moduleImport(\"re\").getMember([\"compile\", \"match\", \"search\", \"findall\", \"finditer\", \"split\", \"sub\", \"subn\"]).getACall() and\n  arg = call.getArg(0)\nselect call, \"Regex pattern used: \" + arg.asExpr().(StringLiteral).getText()\n",
