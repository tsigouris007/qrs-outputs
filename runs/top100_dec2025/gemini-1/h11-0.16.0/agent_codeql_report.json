   "codeql_raw_query": "/**\n * @name ReDoS in HTTP parsing\n * @description Detects potentially exponential regular expressions which can lead to ReDoS.\n * @kind problem\n * @problem.severity error\n * @id py/redos-http\n * @tags security\n *       external/cwe/cwe-1333\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::ExprNode pattern\nwhere\n  (\n    call = API::moduleImport(\"re\").getMember([\"compile\", \"match\", \"search\", \"findall\", \"finditer\", \"fullmatch\", \"split\", \"sub\", \"subn\"]).getACall()\n  )\n  and pattern = call.getArg(0)\nselect call, \"Potential regex usage: \" + pattern.getNode().toString()\n",
