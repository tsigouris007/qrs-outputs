   "codeql_raw_query": "/**\n * @name Check for dangerous function calls and imports\n * @description Checks for usage of eval, exec, compile, and dangerous modules like subprocess, pickle, yaml.\n * @kind problem\n * @problem.severity error\n * @id py/dangerous-calls\n * @tags security\n *       external/cwe/cwe-078\n *       external/cwe/cwe-094\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  // Check for dangerous built-ins\n  call = API::builtin([\"eval\", \"exec\", \"compile\"]).getACall() or\n  // Check for subprocess\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall() or\n  // Check for os.system/popen\n  call = API::moduleImport(\"os\").getMember([\"system\", \"popen\", \"spawn\"]).getACall() or\n  // Check for pickle/yaml/marshal\n  call = API::moduleImport([\"pickle\", \"marshal\", \"yaml\"]).getMember([\"load\", \"loads\", \"dump\", \"dumps\"]).getACall()\nselect call, \"Potential use of dangerous function or module.\"\n",
