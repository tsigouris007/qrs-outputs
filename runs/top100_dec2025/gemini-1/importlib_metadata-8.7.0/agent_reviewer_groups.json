    "codeql_raw_query": "/**\n * @name Identify file access context\n * @description Identify the function and specific call for file access locations\n * @kind problem\n * @problem.severity medium\n * @id py/file-access-context\n * @tags security\n *       external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, Function f\nwhere\n  call.getLocation().getFile().getShortName() = \"__init__.py\" and\n  (\n    call.getLocation().getStartLine() = 504 or\n    call.getLocation().getStartLine() = 813\n  ) and\n  call.getScope() = f\nselect call, \"File access in function \" + f.getName() + \" calling \" + call.getFunction().toString()\n",
