    "codeql_raw_query": "/**\n * @name Identify File System and Command Execution\n * @description Find all file system accesses and command executions to understand package behavior.\n * @kind problem\n * @problem.severity warning\n * @id py/file-and-command-audit\n * @tags security\n *       audit\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"builtins\").getMember(\"open\").getACall() or\n  call = API::moduleImport(\"os\").getMember(\"system\").getACall() or\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall() or\n  call = API::moduleImport(\"os\").getMember(\"popen\").getACall() or\n  call = API::moduleImport(\"importlib.resources\").getMember([\"path\", \"read_text\", \"read_binary\", \"open_text\", \"open_binary\"]).getACall() or\n  call = API::moduleImport(\"pkg_resources\").getMember([\"resource_filename\", \"resource_string\", \"resource_stream\"]).getACall()\nselect call, \"File system or command execution detected.\"",
