   "codeql_raw_query": "/**\n * @name Audit os module usage\n * @description Identify potentially dangerous usages of the os module\n * @kind problem\n * @problem.severity warning\n * @id py/audit-os-usage\n * @tags security\n *       external/cwe/cwe-078\n *       external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, API::Node osNode\nwhere\n  osNode = API::moduleImport(\"os\") and\n  call = osNode.getMember([\"system\", \"popen\", \"spawn\", \"execl\", \"execle\", \"execlp\", \"execlpe\", \"execv\", \"execve\", \"execvp\", \"execvpe\", \"kill\", \"remove\", \"unlink\", \"rmdir\", \"rename\", \"replace\", \"link\", \"symlink\", \"chmod\", \"chown\", \"lchown\", \"fchown\", \"mkdir\", \"makedirs\", \"walk\"]).getACall()\nselect call, \"Usage of os module function: \" + call.getFunction().toString()\n",
