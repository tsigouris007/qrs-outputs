   "codeql_raw_query": "/**\n * @name Potentially dangerous function calls\n * @description Detects calls to eval, exec, and subprocess which can lead to command execution.\n * @kind problem\n * @problem.severity warning\n * @id py/dangerous-functions\n * @tags security\n *       external/cwe/cwe-078\n *       external/cwe/cwe-094\n *       external/cwe/cwe-095\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin([\"eval\", \"exec\"]).getACall() or\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall() or\n  call = API::moduleImport(\"os\").getMember([\"system\", \"popen\", \"spawn\"]).getACall()\nselect call, \"Call to potentially dangerous function.\"\n",
