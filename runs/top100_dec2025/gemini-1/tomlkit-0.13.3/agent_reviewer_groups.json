    "codeql_raw_query": "/**\n * @name Recursion detection\n * @description Detects recursive function calls to check for potential stack overflow vulnerabilities\n * @kind problem\n * @problem.severity warning\n * @id py/recursion-detection\n * @tags security\n *       external/cwe/cwe-674\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom Function f, Function called, Call call\nwhere\n  call.getScope() = f and\n  call.getFunc().(Name).getId() = called.getName() and\n  called = f and\n  // Filter out common utility recursion which might be safe or tail-recursive optimized (though Python doesn't optimize)\n  not f.getName().matches(\"%walk%\") and\n  not f.getName().matches(\"%visit%\")\nselect call, \"Recursive call to \" + f.getName()\n",
