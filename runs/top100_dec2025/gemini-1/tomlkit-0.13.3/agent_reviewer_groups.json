    "codeql_query_uuid": "20260102150543",
    "codeql_raw_query": "/**\n * @name Dangerous Sinks\n * @description Detects usage of dangerous system functions and unsafe deserialization\n * @kind problem\n * @problem.severity error\n * @id py/dangerous-sinks\n * @tags security\n *       external/cwe/cwe-078\n *       external/cwe/cwe-022\n *       external/cwe/cwe-502\n *       external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  // Command Injection\n  call = API::moduleImport(\"os\").getMember([\"system\", \"popen\", \"spawnl\", \"spawnle\", \"spawnlp\", \"spawnlpe\", \"spawnv\", \"spawnve\", \"spawnvp\", \"spawnvpe\"]).getACall() or\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall() or\n  \n  // Path Traversal (basic file open)\n  call = API::builtin(\"open\").getACall() or \n  \n  // Code Injection / Unsafe Deserialization\n  call = API::builtin([\"eval\", \"exec\", \"compile\"]).getACall() or\n  call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall() or\n  call = API::moduleImport(\"yaml\").getMember([\"load\", \"unsafe_load\"]).getACall() or\n  call = API::moduleImport(\"marshal\").getMember([\"load\", \"loads\"]).getACall() or\n  call = API::moduleImport(\"shelve\").getMember(\"open\").getACall()\n\nselect call, \"Potential dangerous operation.\"",
    "hypothesis": "The package might use dangerous system functions or unsafe deserialization methods.",
