    "codeql_query_uuid": "20251227132122",
    "codeql_raw_query": "/**\n * @name Extract regex strings from html_re.py\n * @description Extracts string constants assigned to variables in markdown_it/common/html_re.py to check for ReDoS\n * @kind problem\n * @problem.severity warning\n * @id py/extract-html-re-strings\n * @tags security\n *       external/cwe/cwe-1333\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom Assign stmt, StrConst s\nwhere\n  stmt.getScope().getEnclosingModule().getName().matches(\"%markdown_it.common.html_re%\") and\n  stmt.getValue() = s\nselect stmt, \"Variable assigned regex-like string: \" + s.getText()\n",
