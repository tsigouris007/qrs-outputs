   "codeql_query_uuid": "20251227131939",
   "codeql_raw_query": "/**\n * @name MarkdownIt HTML enabled\n * @description Detects if MarkdownIt is initialized with html=True, enabling raw HTML rendering.\n * @kind problem\n * @problem.severity warning\n * @id py/markdown-it-html-enabled\n * @tags security\n *       external/cwe/cwe-079\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"markdown_it\").getMember(\"MarkdownIt\").getACall() and\n  (\n    call.getArg(1).asExpr().(BooleanLiteral).booleanValue() = true\n    or\n    call.getArgByName(\"html\").asExpr().(BooleanLiteral).booleanValue() = true\n  )\nselect call, \"MarkdownIt instantiated with html=True, potentially enabling XSS.\"\n",
   "hypothesis": "Enabling HTML in Markdown processing can lead to XSS if the input is untrusted.",
   "severity": "medium",
   "cwe_ids": [
    "CWE-79"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20251227132007",
   "codeql_raw_query": "/**\n * @name URL Decoding Usage\n * @description Finds usages of URL decoding functions which can be risky if not handled correctly.\n * @kind problem\n * @problem.severity warning\n * @id py/url-decoding-usage\n * @tags security\n *       external/cwe/cwe-020\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"urllib\").getMember(\"parse\").getMember([\"unquote\", \"unquote_plus\"]).getACall()\nselect call, \"URL decoding function used.\"\n",
   "hypothesis": "Improper URL decoding can lead to security bypasses.",
