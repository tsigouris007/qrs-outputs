   "codeql_raw_query": "/**\n * @name Extract Regex Strings\n * @description Extract string literals used as regexes in specific files for manual ReDoS inspection.\n * @kind problem\n * @problem.severity warning\n * @id py/extract-regex-strings\n * @tags security\n *       external/cwe/cwe-1333\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::ExprNode arg, StrConst regexStr\nwhere\n  call = API::moduleImport(\"re\").getMember([\"compile\", \"match\", \"search\", \"findall\", \"split\", \"sub\"]).getACall() and\n  arg = call.getArg(0) and\n  arg.asExpr() = regexStr and\n  (\n    call.getLocation().getFile().getShortName() = \"html_re.py\" or\n    call.getLocation().getFile().getShortName() = \"autolink.py\" or\n    call.getLocation().getFile().getShortName() = \"linkify.py\"\n  )\nselect call, \"Regex found: \" + regexStr.getText()\n",
