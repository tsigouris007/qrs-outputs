    "codeql_query_uuid": "20251226133828",
    "codeql_raw_query": "/**\n * @name Taint Tracking to Subprocess\n * @description Track flow from remote sources or environment variables to subprocess calls\n * @kind path-problem\n * @problem.severity error\n * @id py/taint-subprocess-specific\n * @tags security\n *        external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.ApiGraphs\n\nmodule SubprocessInjectionConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof RemoteFlowSource or\n    // Environment variables as sources\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"os\").getMember(\"environ\").getMember(\"get\").getACall() and\n      source = call\n    ) or\n    exists(DataFlow::Node env |\n      env = API::moduleImport(\"os\").getMember(\"environ\").getAValueReachableFromSource() and\n      source = env\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"subprocess\").getMember([\"check_call\", \"check_output\", \"call\", \"run\", \"Popen\"]).getACall() and\n      (sink = call.getArg(0) or sink = call.getArg(1)) // Arg 0 is command, Arg 1 might be args list\n    )\n  }\n}\n\nmodule SubprocessInjectionFlow = TaintTracking::Global<SubprocessInjectionConfig>;\nimport SubprocessInjectionFlow::PathGraph\n\nfrom SubprocessInjectionFlow::PathNode source, SubprocessInjectionFlow::PathNode sink\nwhere SubprocessInjectionFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential command injection from $@.\", source.getNode(), \"external input\"\n",
    "hypothesis": "Arguments to subprocess calls may be tainted by environment variables or remote input, leading to command injection.",
    "severity": "high",
    "cwe_ids": [
     "CWE-78"
    ],
