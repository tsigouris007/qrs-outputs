  {
   "codeql_query_uuid": "20260102153637",
   "codeql_raw_query": "/**\n * @name Identify function containing eval\n * @description Identifies the function and its parameters for the found eval calls\n * @kind problem\n * @problem.severity info\n * @id py/identify-eval-context\n * @tags debugging\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, Function func\nwhere\n  call = API::builtin(\"eval\").getACall() and\n  call.getScope() = func\nselect call, \"Eval called in function: \" + func.getName() + \" with params: \" + func.getArgName(0)",
