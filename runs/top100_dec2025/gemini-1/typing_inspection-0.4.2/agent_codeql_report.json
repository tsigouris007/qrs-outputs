   "codeql_raw_query": "/**\n * @name Identify functions containing exec\n * @description Identify the functions that contain the exec calls found previously to understand the context.\n * @kind problem\n * @problem.severity note\n * @id py/identify-exec-functions\n * @tags context\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom Function f, Call call\nwhere\n  call.getScope() = f and\n  call.getFunc().(Name).getId() = \"exec\"\nselect f, \"Function containing exec call\", call, \"The exec call\"",
