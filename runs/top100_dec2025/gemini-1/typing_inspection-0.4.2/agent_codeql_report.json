  {
   "codeql_query_uuid": "20260102153749",
   "codeql_raw_query": "/**\n * @name Inspect Exec Calls\n * @description Inspect arguments passed to exec calls to determine if they are influenced by function parameters.\n * @kind problem\n * @problem.severity warning\n * @id py/inspect-exec-calls\n * @tags security\n *       external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode execCall, Function func, DataFlow::ParameterNode param\nwhere\n  execCall = API::builtin(\"exec\").getACall() and\n  execCall.getScope() = func and\n  param.getScope() = func and\n  DataFlow::localFlow(param, execCall.getArg(0))\nselect execCall, \"exec call in function \" + func.getName() + \" uses parameter \" + param.getParameter().getName()\n",
   "hypothesis": "The exec calls inside the library functions are taking arguments directly from the function parameters, leading to potential code injection if the library user passes untrusted data.",
   "severity": "high",
   "cwe_ids": [
    "CWE-94"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20260102153830",
   "codeql_raw_query": "/**\n * @name Inspect Exec Arguments\n * @description Inspect arguments passed to exec to see if they are derived from function parameters.\n * @kind problem\n * @problem.severity warning\n * @id py/inspect-exec-args\n * @tags security\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode execCall, Function func, DataFlow::ParameterNode param, DataFlow::Node execArg\nwhere\n  execCall = API::builtin(\"exec\").getACall() and\n  execCall.getScope() = func and\n  execArg = execCall.getArg(0) and\n  // Check if there is local flow from any parameter to the exec argument\n  DataFlow::localFlow(param, execArg)\nselect execCall, \"exec called with argument derived from parameter: \" + param.getParameter().getName()\n",
   "hypothesis": "Exec call uses function parameters, potentially leading to code injection.",
   "severity": "high",
   "cwe_ids": [
    "CWE-94"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20260102153940",
   "codeql_raw_query": "/**\n * @name Taint flow to exec\n * @description Tracing flow from function parameters to exec calls\n * @kind path-problem\n * @problem.severity error\n * @id py/taint-to-exec\n * @tags security\n *        external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\n\nmodule ExecTaintConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof DataFlow::ParameterNode\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    sink = any(CodeExecution ce).getCode()\n  }\n}\n\nmodule ExecTaintFlow = TaintTracking::Global<ExecTaintConfig>;\nimport ExecTaintFlow::PathGraph\n\nfrom ExecTaintFlow::PathNode source, ExecTaintFlow::PathNode sink\nwhere ExecTaintFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Exec call depends on parameter $@.\", source.getNode(), \"param\"\n",
   "hypothesis": "Function parameters flow into exec calls, potentially allowing code injection if the caller passes untrusted data.",
   "severity": "high",
