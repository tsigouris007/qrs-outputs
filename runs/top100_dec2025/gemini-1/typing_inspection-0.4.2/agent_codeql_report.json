  {
   "codeql_query_uuid": "20260102154146",
   "codeql_raw_query": "/**\n * @name Unsafe deserialization\n * @description Deserializing untrusted data using pickle or other unsafe methods can lead to arbitrary code execution\n * @kind problem\n * @problem.severity error\n * @id py/unsafe-deserialization\n * @tags security\n *        external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall() or\n    call = API::moduleImport(\"yaml\").getMember([\"load\", \"unsafe_load\"]).getACall() or\n    call = API::moduleImport(\"marshal\").getMember([\"load\", \"loads\"]).getACall() or\n    call = API::moduleImport(\"shelve\").getMember(\"open\").getACall() or\n    call = API::moduleImport(\"jsonpickle\").getMember([\"decode\", \"unpickler\"]).getACall()\n  )\nselect call, \"Potentially unsafe deserialization operation.\"\n",
   "hypothesis": "Unsafe deserialization could allow arbitrary code execution.",
   "severity": "high",
   "cwe_ids": [
    "CWE-502"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20260102154225",
   "codeql_raw_query": "\n/**\n * @name Find callers of vulnerable compilation functions\n * @description Find functions that call _compile_type_check_function or _compile_identity_check_function\n * @kind problem\n * @problem.severity warning\n * @id py/find-compilation-callers\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom Function func, Call call, Name name\nwhere\n  call.getScope() = func and\n  call.getFunc() = name and\n  name.getId() in [\"_compile_type_check_function\", \"_compile_identity_check_function\"]\nselect call, \"Called by \" + func.getName()\n",
   "hypothesis": "Public functions call vulnerable internal compilation functions.",
   "severity": "high",
   "cwe_ids": [],
