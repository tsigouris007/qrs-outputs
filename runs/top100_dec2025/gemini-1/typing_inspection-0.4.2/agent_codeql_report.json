   "codeql_query_uuid": "20260102153603",
   "codeql_raw_query": "/**\n * @name Dynamic Code Execution\n * @description Detects usage of eval, exec, and compile which can be dangerous if used with untrusted input.\n * @kind problem\n * @problem.severity warning\n * @id py/dynamic-code-execution\n * @tags security\n *       external/cwe/cwe-094\n *       external/cwe/cwe-095\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin([\"eval\", \"exec\", \"compile\"]).getACall()\nselect call, \"Usage of dynamic code execution found.\"\n",
   "hypothesis": "The package might use eval() or exec() to resolve string type hints, which could be exploitable if the strings come from untrusted sources.",
   "severity": "high",
