    "codeql_raw_query": "/**\n * @name Subprocess with shell=True\n * @description Finding subprocess calls with shell=True which can be dangerous.\n * @kind problem\n * @problem.severity high\n * @id py/cffi/subprocess-shell-true\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::ArgumentNode arg\nwhere\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"Popen\", \"run\"]).getACall() and\n  arg = call.getArgByName(\"shell\") and\n  arg.asExpr().(BooleanLiteral).booleanValue() = true\nselect call, \"Subprocess call with shell=True.\"\n",
