    "codeql_query_uuid": "20251225133011",
    "codeql_raw_query": "/**\n * @name Pkgconfig Command Injection\n * @description Taint tracking from pkgconfig function parameters to subprocess calls.\n * @kind path-problem\n * @problem.severity error\n * @id py/cffi/pkgconfig-injection\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule PkgConfigInjectionConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    exists(DataFlow::ParameterNode param |\n      source = param and\n      param.getLocation().getFile().getShortName() = \"pkgconfig.py\"\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"subprocess\").getMember([\"check_output\", \"Popen\", \"run\", \"call\"]).getACall() and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule PkgConfigInjectionFlow = TaintTracking::Global<PkgConfigInjectionConfig>;\nimport PkgConfigInjectionFlow::PathGraph\n\nfrom PkgConfigInjectionFlow::PathNode source, PkgConfigInjectionFlow::PathNode sink\nwhere PkgConfigInjectionFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Command injection from $@.\", source.getNode(), \"parameter\"\n",
    "hypothesis": "Command injection in pkgconfig.py via subprocess calls using function parameters.",
    "severity": "high",
    "cwe_ids": [
     "cwe-78"
    ],
