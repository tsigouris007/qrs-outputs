    "codeql_query_uuid": "20260102143602",
    "codeql_raw_query": "/**\n * @name Potential ReDoS in regex\n * @description specific check for nested quantifiers in regexes which often lead to ReDoS\n * @kind problem\n * @problem.severity warning\n * @id py/redos-nested-quantifiers\n * @tags security\n *       external/cwe/cwe-1333\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, StrConst pattern\nwhere\n  (\n    call = API::moduleImport(\"re\").getMember([\"compile\", \"search\", \"match\", \"findall\", \"finditer\", \"split\", \"sub\", \"subn\"]).getACall() and\n    call.getArg(0).asExpr() = pattern\n  )\n  and\n  // Simple heuristic for nested quantifiers: a quantifier followed by another quantifier, possibly with grouping\n  // This is a rough approximation as regex parsing in QL is limited without library support\n  pattern.getText().regexpMatch(\".*(\\\\*|\\\\+|\\\\})[?]?\\\\).*(\\\\*|\\\\+|\\\\{).*\")\nselect call, \"Potential ReDoS vulnerability due to nested quantifiers in regex: \" + pattern.getText()\n",
    "hypothesis": "Complex regular expressions with nested quantifiers can cause ReDoS.",
    "severity": "medium",
    "cwe_ids": [
     "CWE-1333"
    ],
