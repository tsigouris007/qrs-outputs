    "codeql_query_uuid": "20260102144113",
    "codeql_raw_query": "/**\n * @name Dynamic Regex Construction\n * @description compiling a regex from a non-constant source\n * @kind problem\n * @problem.severity warning\n * @id py/dynamic-regex\n * @tags security\n *       external/cwe/cwe-1333\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node arg\nwhere\n  call = API::moduleImport(\"re\").getMember([\"compile\", \"match\", \"search\", \"findall\", \"finditer\", \"split\", \"sub\", \"subn\"]).getACall() and\n  arg = call.getArg(0) and\n  not exists(arg.asExpr().(StringLiteral)) and\n  not exists(arg.getALocalSource().asExpr().(StringLiteral))\nselect call, \"Regex constructed from non-constant source.\"\n",
