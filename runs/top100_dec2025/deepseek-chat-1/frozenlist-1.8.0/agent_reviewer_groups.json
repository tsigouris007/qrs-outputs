    "codeql_query_uuid": "20251226232953",
    "codeql_raw_query": "/**\n * @name Potential thread safety issues in FrozenList\n * @description Check for methods that modify shared state without synchronization\n * @kind problem\n * @problem.severity warning\n * @id py/thread-safety\n * @tags security\n *        external/cwe/cwe-362\n *        external/cwe/cwe-366\n */\n\nimport python\n\n// Look for methods in FrozenList class that modify the list\nfrom Class cls, Function func, Call call\nwhere\n  cls.getName() = \"FrozenList\" and\n  func.getEnclosingScope() = cls and\n  // Look for methods that likely modify the list\n  (\n    func.getName() = \"append\" or\n    func.getName() = \"extend\" or\n    func.getName() = \"insert\" or\n    func.getName() = \"remove\" or\n    func.getName() = \"pop\" or\n    func.getName() = \"clear\" or\n    func.getName() = \"__setitem__\" or\n    func.getName() = \"__delitem__\" or\n    func.getName() = \"__iadd__\" or\n    func.getName() = \"__imul__\"\n  )\nselect func, \"Method \" + func.getName() + \" modifies FrozenList state - potential thread safety issue if used concurrently\"",
    "hypothesis": "FrozenList methods that modify state may have thread safety issues when used concurrently",
