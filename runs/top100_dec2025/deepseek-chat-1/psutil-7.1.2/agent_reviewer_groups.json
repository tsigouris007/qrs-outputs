    "codeql_raw_query": "/**\n * @name Insecure temporary file usage\n * @description Using insecure temporary file creation methods like tempfile.mktemp()\n * @kind problem\n * @problem.severity warning\n * @id py/insecure-temp-files\n * @tags security\n *        external/cwe/cwe-377\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"tempfile\").getMember(\"mktemp\").getACall()\n  or\n  call = API::moduleImport(\"tempfile\").getMember(\"NamedTemporaryFile\").getACall()\nselect call, \"Temporary file creation that could be vulnerable to race conditions or insecure\"",
