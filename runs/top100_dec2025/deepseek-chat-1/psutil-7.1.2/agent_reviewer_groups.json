    "codeql_raw_query": "/**\n * @name Path traversal in file open operations\n * @description Check for open() calls that could be vulnerable to path traversal\n * @kind problem\n * @problem.severity warning\n * @id py/path-traversal-open\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  // Check for built-in open() function\n  call = API::builtin(\"open\").getACall()\n  or\n  // Check for os.open\n  call = API::moduleImport(\"os\").getMember(\"open\").getACall()\n  or\n  // Check for io.open\n  call = API::moduleImport(\"io\").getMember(\"open\").getACall()\nselect call, \"File open operation that could be vulnerable to path traversal if path is user-controlled\"",
