    "codeql_raw_query": "/**\n * @name Subprocess calls detection\n * @description Detecting subprocess calls that could be vulnerable to command injection\n * @kind problem\n * @problem.severity warning\n * @id py/subprocess-calls\n * @tags security\n *        external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall() or\n  call = API::moduleImport(\"os\").getMember([\"system\", \"popen\", \"popen2\", \"popen3\", \"popen4\"]).getACall()\nselect call, \"Subprocess call detected. Ensure command arguments are properly sanitized to prevent command injection.\"",
