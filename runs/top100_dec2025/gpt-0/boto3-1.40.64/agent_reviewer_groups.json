    "codeql_query_uuid": "20251207193841",
    "codeql_raw_query": "/**\n * @name Hard-coded AWS credentials in boto3\n * @description Detect hard-coded AWS access keys and secret keys in the boto3 package.\n * @kind problem\n * @problem.severity warning\n * @id py/boto3/hardcoded-aws-credentials\n * @tags security\n *       external/cwe/cwe-798\n */\n\nimport python\n\nfrom Expr e\nwhere\n  e.toString().regexpMatch(\"AKIA[0-9A-Z]{16}\") or\n  e.toString().regexpMatch(\"ASIA[0-9A-Z]{16}\") or\n  e.toString().regexpMatch(\"(?i)aws(.{0,20})?(secret|access)[-_]?key\")\nselect e, \"Potential hard-coded AWS credential or access key pattern.\"\n",
