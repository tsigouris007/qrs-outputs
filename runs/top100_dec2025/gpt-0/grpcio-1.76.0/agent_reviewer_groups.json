    "codeql_raw_query": "/**\n * @name Insecure subprocess usage in grpcio\n * @description Detects use of subprocess and os.system that may execute external commands.\n * @kind problem\n * @problem.severity warning\n * @id py/grpcio/insecure-subprocess-usage\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"subprocess\").getMember([\"Popen\", \"call\", \"check_call\", \"check_output\", \"run\"]).getACall()\n  or\n  call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall()\nselect call, \"Potentially insecure use of subprocess or os.system/os.popen in grpcio package.\"",
