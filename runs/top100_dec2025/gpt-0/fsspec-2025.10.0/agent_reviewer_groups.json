    "codeql_raw_query": "/**\n * @name Unsafe deserialization in fsspec (pickle, json, ujson)\n * @description Detects uses of pickle, json, or ujson deserialization APIs inside fsspec, which may be unsafe on untrusted data.\n * @kind problem\n * @problem.severity warning\n * @id py/fsspec-unsafe-deserialization-audit\n * @tags security\n *        external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call.getLocation().getFile().getRelativePath().regexpMatch(\"^fsspec/.*\") and\n  (\n    call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall() or\n    call = API::moduleImport(\"json\").getMember([\"load\", \"loads\"]).getACall() or\n    call = API::moduleImport(\"ujson\").getMember([\"load\", \"loads\"]).getACall()\n  )\nselect call, \"Deserialization API used inside fsspec; ensure only trusted data is deserialized.\"\n",
