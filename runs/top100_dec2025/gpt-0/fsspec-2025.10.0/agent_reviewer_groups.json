    "codeql_raw_query": "/**\n * @name Dangerous use of pickle and similar deserialization in fsspec\n * @description Detects uses of pickle, dill, marshal, or yaml.unsafe_load that may deserialize untrusted data.\n * @kind problem\n * @problem.severity warning\n * @id py/fsspec-unsafe-deserialization\n * @tags security\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\"]).getACall()\n  or call = API::moduleImport(\"marshal\").getMember([\"load\", \"loads\"]).getACall()\n  or call = API::moduleImport(\"yaml\").getMember([\"load\", \"unsafe_load\"]).getACall()\nselect call, \"Potentially unsafe deserialization operation in fsspec that could execute arbitrary code.\"",
