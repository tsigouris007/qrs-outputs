    "codeql_raw_query": "/**\n * @name Command execution in fsspec\n * @description Detects use of os.system, subprocess, or similar APIs that may lead to command injection.\n * @kind problem\n * @problem.severity warning\n * @id py/fsspec-command-execution\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall()\n  or call = API::moduleImport(\"subprocess\").getMember([\"Popen\", \"call\", \"run\", \"check_call\", \"check_output\"]).getACall()\nselect call, \"Command execution API used in fsspec; ensure inputs are trusted to avoid command injection.\"",
