    "codeql_raw_query": "/**\n * @name Click: unsafe use of os.system and popen\n * @description Find uses of os.system, os.popen, and subprocess.* with shell=True in click.\n * @kind problem\n * @problem.severity warning\n * @id py/click/os-system-shell\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call.getLocation().getFile().getRelativePath().matches(\"src/click/%\") and\n  (\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall() or\n    call = API::moduleImport(\"subprocess\").getMember([\"Popen\", \"call\", \"run\", \"check_call\", \"check_output\"]).getACall()\n  )\nselect call, \"Potentially unsafe shell invocation in Click core library.\"",
