    "codeql_raw_query": "/**\n * @name Potential unsafe use of eval/exec in library code\n * @description Flags eval/exec calls in non-test, non-setup library modules for manual review.\n * @kind problem\n * @problem.severity warning\n * @id py/library-eval-exec\n * @tags security\n *       external/cwe/cwe-094\n */\n\nimport python\n\nfrom Call call, Expr callee, string file\nwhere\n  call.getFunc() = callee and\n  callee.toString() in [\"eval\", \"exec\"] and\n  file = call.getLocation().getFile().getRelativePath() and\n  not file.regexpMatch(\"^testing/.*\") and\n  file != \"setup.py\"\nselect call, \"Use of \" + callee.toString() + \" in library code; ensure inputs are trusted or sanitized.\"\n",
