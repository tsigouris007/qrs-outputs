    "codeql_query_uuid": "20251226033417",
    "codeql_raw_query": "/**\n * @name pyarrow file-system writes\n * @description Detect functions that write to the filesystem where paths derive from parameters\n * @kind path-problem\n * @problem.severity warning\n * @id pyarrow/tainted-file-write\n * @tags security\n *       external/cwe/cwe-22\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule FileWriteConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) { source instanceof DataFlow::ParameterNode }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      (\n        call = API::moduleImport(\"os\").getMember([\"open\"]).getACall() or\n        call = API::moduleImport(\"builtins\").getMember(\"open\").getACall() or\n        call = API::moduleImport(\"pathlib.Path\").getMember([\"write_text\", \"write_bytes\", \"open\"]).getACall()\n      ) and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule FileWriteFlow = TaintTracking::Global<FileWriteConfig>;\nimport FileWriteFlow::PathGraph\n\nfrom FileWriteFlow::PathNode source, FileWriteFlow::PathNode sink\nwhere FileWriteFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Function parameter flows into file write path $@.\", sink.getNode(), \"path\"",
    "hypothesis": "Detect potential path traversal or arbitrary file write where path comes from caller",
