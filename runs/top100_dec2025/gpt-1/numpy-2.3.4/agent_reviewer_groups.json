    "codeql_raw_query": "/**\n * @name Unsafe deserialization\n * @description Find uses of pickle, yaml.load, marshal, or shelve which may deserialize untrusted data.\n * @kind problem\n * @problem.severity error\n * @id py/unsafe-deserialization\n * @tags security\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport([\"pickle\", \"yaml\", \"marshal\", \"shelve\"]).getMember([\"load\", \"loads\", \"open\", \"unsafe_load\", \"Unpickler\"]).getACall()\nselect call, \"Potentially unsafe deserialization that may execute arbitrary code.\"",
