    "codeql_query_uuid": "20251225234334",
    "codeql_raw_query": "/**\n * @name Dynamic code evaluation via eval/exec (refined)\n * @description Find uses of eval/exec in numpy library code (excluding vendored meson) which may execute arbitrary code.\n * @kind problem\n * @problem.severity warning\n * @id py/dynamic-code-eval\n * @tags security\n *       external/cwe/cwe-094\n */\n\nimport python\n\nfrom Call call, File f, Name funcName\nwhere\n  call.getFunc() = funcName and\n  funcName.getId() in [\"eval\", \"exec\"] and\n  f = call.getLocation().getFile() and\n  f.getRelativePath().matches(\"numpy/%\") and\n  not f.getRelativePath().matches(\"vendored-meson/%\")\nselect call, \"Use of eval/exec may allow execution of arbitrary code if input is not trusted.\"\n",
    "hypothesis": "numpy uses eval/exec for dynamic code evaluation, which could lead to code injection if exposed to untrusted input.",
    "severity": "high",
    "cwe_ids": [
     "cwe-094"
    ],
