    "codeql_raw_query": "/**\n * @name Unsafe deserialization in typing_extensions\n * @description Detects use of pickle, yaml.load, marshal, or shelve that could deserialize untrusted data.\n * @kind problem\n * @problem.severity error\n * @id py/typing-extensions-deserialization\n * @tags security\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport([\"pickle\", \"yaml\", \"marshal\", \"shelve\"]).getMember([\"load\", \"loads\", \"open\", \"unsafe_load\"]).getACall()\nselect call, \"Potentially unsafe deserialization API is used in typing_extensions.\"",
    "hypothesis": "Check for any unsafe deserialization primitives, which should be absent in a pure typing helper library",
    "severity": "high",
