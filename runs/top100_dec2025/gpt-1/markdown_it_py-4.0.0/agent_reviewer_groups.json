    "codeql_query_uuid": "20251225224450",
    "codeql_raw_query": "/**\n * @name OS command execution in scripts\n * @description Find uses of subprocess or os.system in helper scripts that could be abused.\n * @kind problem\n * @problem.severity warning\n * @id py/markdown-it-py/os-command-execution\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call.getLocation().getFile().getRelativePath().regexpMatch(\"^scripts/.*\") and\n  (\n    call = API::moduleImport(\"subprocess\").getMember([\"run\", \"call\", \"Popen\", \"check_call\", \"check_output\"]).getACall()\n    or\n    call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall()\n  )\nselect call, \"OS command execution used in script; ensure inputs are trusted.\"",
    "hypothesis": "Project scripts may invoke subprocess or os.system in unsafe ways.",
