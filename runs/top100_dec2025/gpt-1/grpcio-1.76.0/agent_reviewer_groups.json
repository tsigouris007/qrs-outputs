    "codeql_raw_query": "/**\n * @name Direct use of shell commands in grpcio\n * @description Finds direct uses of subprocess and os.system in the grpcio package (no dataflow).\n * @kind problem\n * @problem.severity warning\n * @id py/grpcio/shell-usage-simple\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom API::CallNode c\nwhere\n  c = API::moduleImport(\"subprocess\").getMember([\"Popen\", \"call\", \"check_call\", \"check_output\", \"run\"]).getACall()\n  or\n  c = API::moduleImport(\"os\").getMember(\"system\").getACall()\nselect c, \"Use of shell/command execution function here may require review for injection risks.\"\n",
