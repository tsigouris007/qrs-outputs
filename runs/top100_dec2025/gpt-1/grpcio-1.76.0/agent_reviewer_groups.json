    "codeql_raw_query": "/**\n * @name Insecure random usage in grpcio (predictable tokens)\n * @description Detects use of the `random` module where `secrets` or `os.urandom` would be more appropriate for security tokens.\n * @kind problem\n * @problem.severity warning\n * @id py/grpcio/insecure-random\n * @tags security\n *       external/cwe/cwe-330\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"random\").getMember([\"random\", \"randint\", \"randrange\", \"getrandbits\"]).getACall()\nselect call, \"Use of the 'random' module for potentially security-sensitive randomness; consider using 'secrets' instead.\"\n",
    "hypothesis": "Use of python random module for security-sensitive operations (tokens, nonces, secrets).",
