   "codeql_query_uuid": "20251213202238",
   "codeql_raw_query": "/**\n * @name Dangerous Function Calls\n * @description Checks for usage of dangerous functions like eval, exec, subprocess\n * @kind problem\n * @problem.severity error\n * @id py/dangerous-functions\n * @tags security\n *       external/cwe/cwe-078\n *       external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"builtins\").getMember([\"eval\", \"exec\"]).getACall() or\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall() or\n  call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall()\nselect call, \"Dangerous function call\"\n",
   "hypothesis": "Check for command injection and code injection vulnerabilities.",
   "severity": "high",
   "cwe_ids": [
    "CWE-78",
    "CWE-94"
   ],
