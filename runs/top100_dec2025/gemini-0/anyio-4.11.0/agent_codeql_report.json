   "codeql_query_uuid": "20251206194240",
   "codeql_raw_query": "/**\n * @name Unsafe pickle deserialization from remote source\n * @description Deserializing untrusted data using pickle can lead to arbitrary code execution\n * @kind path-problem\n * @problem.severity error\n * @id py/unsafe-deserialization-pickle-remote\n * @tags security\n *        external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.dataflow.new.RemoteFlowSources\nimport semmle.python.ApiGraphs\n\nmodule PickleRemoteConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof RemoteFlowSource\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\"]).getACall() and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule PickleRemoteFlow = TaintTracking::Global<PickleRemoteConfig>;\nimport PickleRemoteFlow::PathGraph\n\nfrom PickleRemoteFlow::PathNode source, PickleRemoteFlow::PathNode sink\nwhere PickleRemoteFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Unsafe pickle deserialization from $@.\", source.getNode(), \"remote source\"\n",
   "hypothesis": "Pickle deserialization of data from remote sources (e.g. network) leads to RCE.",
   "severity": "critical",
   "cwe_ids": [
    "cwe-502"
   ],
