   "codeql_raw_query": "/**\n * @name Asyncio subprocess shell usage\n * @description Checks for usage of asyncio.create_subprocess_shell which can be dangerous\n * @kind problem\n * @problem.severity warning\n * @id py/asyncio-shell-usage\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, Function f\nwhere\n  call.getScope() = f and\n  call = API::moduleImport(\"asyncio\").getMember(\"create_subprocess_shell\").getACall()\nselect call, \"Call to asyncio.create_subprocess_shell in function: \" + f.getName()\n",
