   "codeql_raw_query": "/**\n * @name Identify subprocess calls in asyncio backend\n * @description Checks for subprocess creation in asyncio backend to determine if shell execution is used.\n * @kind problem\n * @problem.severity warning\n * @id py/asyncio-subprocess-check\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call.getLocation().getFile().getShortName() = \"_asyncio.py\" and\n  (\n    call = API::moduleImport(\"asyncio\").getMember([\"create_subprocess_shell\", \"create_subprocess_exec\"]).getACall() or\n    call = API::moduleImport(\"subprocess\").getMember([\"Popen\", \"run\", \"call\", \"check_call\", \"check_output\"]).getACall()\n  )\nselect call, \"Subprocess call found: \" + call.getFunction().toString()",
