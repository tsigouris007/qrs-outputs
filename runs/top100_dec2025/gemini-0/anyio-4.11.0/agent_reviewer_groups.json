    "codeql_query_uuid": "20251206194349",
    "codeql_raw_query": "/**\n * @name Trace pickle data source in to_interpreter.py\n * @description Trace where the data passed to pickle.loads comes from in to_interpreter.py\n * @kind problem\n * @problem.severity warning\n * @id py/trace-pickle-source-interpreter\n * @tags security\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node arg\nwhere\n  call = API::moduleImport(\"pickle\").getMember(\"loads\").getACall() and\n  call.getLocation().getFile().getShortName() = \"to_interpreter.py\" and\n  arg = call.getArg(0)\nselect arg, \"Argument to pickle.loads in to_interpreter.py\", arg.getALocalSource(), \"Local source\"\n",
