    "codeql_raw_query": "/**\n * @name Inspect weak hash usage in extensions.py\n * @description Inspect the context of weak hash usage in extensions.py\n * @kind problem\n * @problem.severity low\n * @id py/inspect-extensions-weak-hash\n * @tags security\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call.getLocation().getFile().getShortName() = \"extensions.py\" and\n  call.getLocation().getStartLine() > 60 and\n  call.getLocation().getStartLine() < 80 and\n  (\n    call = API::moduleImport(\"hashlib\").getMember([\"md5\", \"sha1\"]).getACall() or\n    call = API::moduleImport(\"cryptography\").getMember(\"hazmat\").getMember(\"primitives\").getMember(\"hashes\").getMember([\"MD5\", \"SHA1\"]).getACall()\n  )\nselect call, \"Weak hash usage found.\"\n",
