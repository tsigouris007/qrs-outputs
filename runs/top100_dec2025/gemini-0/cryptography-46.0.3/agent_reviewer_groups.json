    "codeql_raw_query": "/**\n * @name Command Injection\n * @description Detects command injection vulnerabilities in subprocess and os calls where arguments are not string literals.\n * @kind problem\n * @problem.severity error\n * @id py/command-injection\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node arg\nwhere\n  (\n    (\n      call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"run\", \"Popen\"]).getACall()\n      or\n      call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall()\n    )\n    and\n    arg = call.getArg(0)\n    and\n    not arg.asExpr() instanceof StringLiteral\n  )\nselect call, \"Potential command injection sink with non-literal argument.\"",
    "hypothesis": "The package might be using subprocess or os.system with user-controlled input, leading to command injection.",
