    "codeql_raw_query": "/**\n * @name Hardcoded secret\n * @description Hardcoded credentials in source code\n * @kind problem\n * @problem.severity error\n * @id py/hardcoded-secret\n * @tags security\n *        external/cwe/cwe-798\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::Node node, string key\nwhere\n  node.asExpr() instanceof StringLiteral and\n  (\n    key = \"password\" or\n    key = \"secret\" or\n    key = \"api_key\" or\n    key = \"access_token\"\n  ) and\n  exists(AssignStmt assign |\n    assign.contains(node.asExpr()) and\n    exists(Name name |\n      name = assign.getTarget(0) and\n      name.getId().toLowerCase().matches(\"%\" + key + \"%\")\n    )\n  ) and\n  not node.asExpr().(StringLiteral).getText() = \"\"\nselect node, \"Possible hardcoded secret assigned to variable matching '\" + key + \"'.\"\n",
