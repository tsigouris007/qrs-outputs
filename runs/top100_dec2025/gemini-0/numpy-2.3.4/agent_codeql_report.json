   "codeql_raw_query": "/**\n * @name Unsafe deserialization with numpy.load or pickle\n * @description Calling numpy.load with allow_pickle=True or using pickle can lead to arbitrary code execution.\n * @kind problem\n * @problem.severity error\n * @id py/numpy-unsafe-deserialization\n * @tags security\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"numpy\").getMember(\"load\").getACall() and\n    exists(DataFlow::Node arg |\n      arg = call.getArgByName(\"allow_pickle\") and\n      arg.asExpr().(ImmutableLiteral).booleanValue() = true\n    )\n  )\n  or\n  call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\"]).getACall()\nselect call, \"Potential unsafe deserialization.\"\n",
   "hypothesis": "Unsafe deserialization via numpy.load(allow_pickle=True) or pickle usage.",
   "severity": "high",
