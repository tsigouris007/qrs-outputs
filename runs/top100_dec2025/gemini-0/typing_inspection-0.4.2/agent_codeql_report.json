  {
   "codeql_query_uuid": "20251221161012",
   "codeql_raw_query": "/**\n * @name Identify functions using exec\n * @description Finds functions that use exec and returns their names\n * @kind problem\n * @problem.severity warning\n * @id py/exec-function-names\n * @tags security\n *       external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom Function f, Call c, Name n\nwhere\n  c.getScope() = f and\n  c.getFunc() = n and\n  n.getId() = \"exec\"\nselect c, \"exec called in function \" + f.getName()\n",
