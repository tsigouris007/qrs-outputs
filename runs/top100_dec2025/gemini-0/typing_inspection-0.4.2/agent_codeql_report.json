   "codeql_query_uuid": "20251221161127",
   "codeql_raw_query": "/**\n * @name Exposure of internal compile functions\n * @description Find public functions that call _compile_identity_check_function or _compile_isinstance_check_function\n * @kind problem\n * @problem.severity warning\n * @id py/internal-compile-exposure\n * @tags security\n *        external/cwe/cwe-094\n */\n\nimport python\n\nfrom Function internalFunc, Function publicFunc, Call call\nwhere\n  internalFunc.getName() in [\"_compile_identity_check_function\", \"_compile_isinstance_check_function\"] and\n  // Find calls to the internal function\n  call.getFunc().(Name).getId() = internalFunc.getName() and\n  // Ensure the call is within the public function\n  call.getScope() = publicFunc and\n  // Public function doesn't start with underscore\n  not publicFunc.getName().matches(\"_%\")\nselect publicFunc, \"Public function \" + publicFunc.getName() + \" calls internal compile function.\"",
