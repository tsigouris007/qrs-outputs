   "codeql_query_uuid": "20251221160914",
   "codeql_raw_query": "/**\n * @name Identify functions with exec\n * @description Find functions containing exec calls and print their names and arguments\n * @kind problem\n * @problem.severity recommendation\n * @id py/identify-exec-context\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom Function f, Exec e\nwhere\n  e.getScope() = f\nselect f, \"Function \" + f.getName() + \" contains exec call at line \" + e.getLocation().getStartLine().toString()\n",
   "hypothesis": "Identify the functions containing the confirmed exec calls to understand their purpose and exposure.",
   "severity": "medium",
   "cwe_ids": [],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20251221160938",
   "codeql_raw_query": "/**\n * @name Improper Modification of Dynamically-Determined Object Attributes\n * @description Modifying object attributes with user-controlled input can lead to unexpected behavior.\n * @kind problem\n * @problem.severity warning\n * @id py/improper-attribute-modification\n * @tags security\n *       external/cwe/cwe-915\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin(\"setattr\").getACall() and\n  not exists(call.getArg(1).asExpr().(Str))\nselect call, \"Potential modification of dynamically-determined object attribute.\"\n",
