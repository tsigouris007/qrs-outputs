   "codeql_query_uuid": "20251221160708",
   "codeql_raw_query": "/**\n * @name Code injection via eval/exec\n * @description Using eval or exec with untrusted input can lead to arbitrary code execution\n * @kind problem\n * @problem.severity error\n * @id py/code-injection-check\n * @tags security\n *        external/cwe/cwe-094\n *        external/cwe/cwe-095\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin([\"eval\", \"exec\", \"compile\"]).getACall()\nselect call, \"Potential code injection via eval/exec/compile\"",
   "hypothesis": "The library might use eval() to resolve forward references in type hints.",
   "severity": "high",
