  {
   "codeql_query_uuid": "20251221160732",
   "codeql_raw_query": "/**\n * @name Code injection via eval/exec data flow\n * @description Tracing data flow to eval/exec calls\n * @kind path-problem\n * @problem.severity error\n * @id py/code-injection-flow\n * @tags security\n *        external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule CodeInjectionConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Consider parameters of functions as potential sources for a library\n    exists(Function f |\n      f.getName().matches(\"%\") and\n      source instanceof DataFlow::ParameterNode and\n      source.getScope() = f\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::builtin(\"eval\").getACall() and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule CodeInjectionFlow = TaintTracking::Global<CodeInjectionConfig>;\nimport CodeInjectionFlow::PathGraph\n\nfrom CodeInjectionFlow::PathNode source, CodeInjectionFlow::PathNode sink\nwhere CodeInjectionFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Code injection from $@.\", source.getNode(), \"parameter\"\n",
   "hypothesis": "Data flow from function parameters to eval() calls leads to code injection.",
   "severity": "high",
   "cwe_ids": [
    "CWE-94"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20251221160800",
   "codeql_raw_query": "/**\n * @name Analyze eval usage context\n * @description Get the function name and argument of the eval calls\n * @kind problem\n * @problem.severity warning\n * @id py/analyze-eval-context\n * @tags security\n *       external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, Function func\nwhere\n  call = API::builtin(\"eval\").getACall() and\n  call.getScope() = func\nselect call, \"Eval called in function \" + func.getName() + \" with argument: \" + call.getArg(0).asExpr().toString()",
   "hypothesis": "Investigate the context of eval calls to determine if they are safe.",
   "severity": "high",
   "cwe_ids": [
    "CWE-94"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20251221160822",
   "codeql_raw_query": "/**\n * @name Inspect eval arguments\n * @description Inspect arguments passed to eval to understand the context\n * @kind problem\n * @problem.severity warning\n * @id py/inspect-eval-args\n * @tags security\n *       external/cwe/cwe-095\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin(\"eval\").getACall()\nselect call, \"Call to eval with argument: \" + call.getArg(0).asExpr().toString()",
   "hypothesis": "Inspect arguments passed to eval to determine if they are potentially dangerous.",
   "severity": "medium",
   "cwe_ids": [
    "CWE-95"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20251221160844",
   "codeql_raw_query": "/**\n * @name Code injection via eval/exec from function arguments\n * @description Tracing flow from function arguments to eval/exec calls\n * @kind path-problem\n * @problem.severity error\n * @id py/code-injection-param-flow\n * @tags security\n *        external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\n\nmodule CodeInjectionConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof DataFlow::ParameterNode\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    sink = any(CodeExecution ce).getCode()\n  }\n}\n\nmodule CodeInjectionFlow = TaintTracking::Global<CodeInjectionConfig>;\nimport CodeInjectionFlow::PathGraph\n\nfrom CodeInjectionFlow::PathNode source, CodeInjectionFlow::PathNode sink\nwhere CodeInjectionFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Code injection from $@.\", source.getNode(), \"function argument\"\n",
   "hypothesis": "The eval() calls found earlier might be reachable from function arguments, posing a risk if the library user passes untrusted strings.",
   "severity": "high",
