    "codeql_raw_query": "/**\n * @name File system access with potentially user-controlled path\n * @description Detects file system access where the path might be influenced by external input or function arguments.\n * @kind problem\n * @problem.severity warning\n * @id py/file-system-access\n * @tags security\n *       external/cwe/cwe-022\n *       external/cwe/cwe-073\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node pathArg\nwhere\n  (\n    call = API::builtin(\"open\").getACall() or\n    call = API::moduleImport(\"io\").getMember(\"open\").getACall() or\n    call = API::moduleImport(\"os\").getMember([\"open\", \"fdopen\"]).getACall() or\n    call = API::moduleImport(\"pathlib\").getMember(\"Path\").getACall()\n  )\n  and\n  (\n    pathArg = call.getArg(0)\n  )\nselect call, \"File system access with path argument: \" + pathArg.toString()\n",
