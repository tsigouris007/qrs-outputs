   {
    "codeql_query_uuid": "20251213204043",
    "codeql_raw_query": "/**\n * @name Potential Path Traversal in Library\n * @description Detects flow from function parameters to file open operations, indicating potential path traversal if the input is not validated.\n * @kind path-problem\n * @problem.severity warning\n * @id py/library-path-traversal\n * @tags security\n *       external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Consider parameters of functions in the package as sources\n    exists(Function f |\n      f.getScope().getEnclosingModule().getName().matches(\"importlib_metadata%\") and\n      source instanceof DataFlow::ParameterNode and\n      source.getScope() = f\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    // Sinks are arguments to open() or similar file operations\n    exists(DataFlow::CallCfgNode call |\n      call = API::builtin(\"open\").getACall() and\n      sink = call.getArg(0)\n    )\n    or\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"pathlib\").getMember(\"Path\").getACall() and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\nimport PathTraversalFlow::PathGraph\n\nfrom PathTraversalFlow::PathNode source, PathTraversalFlow::PathNode sink\nwhere PathTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential path traversal from $@.\", source.getNode(), \"function parameter\"\n",
    "hypothesis": "Path traversal from library function parameters to file operations.",
    "severity": "medium",
    "cwe_ids": [
     "cwe-22"
