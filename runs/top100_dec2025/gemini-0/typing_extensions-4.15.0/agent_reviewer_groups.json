    "codeql_raw_query": "/**\n * @name Identify dynamic execution context\n * @description Inspects the arguments and context of eval/exec calls in typing_extensions.py\n * @kind problem\n * @problem.severity warning\n * @id py/inspect-dynamic-exec\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node arg\nwhere\n  call.getLocation().getFile().getShortName() = \"typing_extensions.py\" and\n  (\n    call = API::builtin(\"eval\").getACall() or\n    call = API::builtin(\"exec\").getACall()\n  ) and\n  arg = call.getArg(_)\nselect call, \"Dynamic execution call with argument: \" + arg.toString()\n",
