    "codeql_raw_query": "/**\n * @name Hardcoded Credentials\n * @description Detecting hardcoded credentials such as AWS keys or passwords.\n * @kind problem\n * @problem.severity error\n * @id py/hardcoded-credentials\n * @tags security\n *       external/cwe/cwe-798\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom StrConst s\nwhere\n  (\n    s.getText().regexpMatch(\"(?i).*(password|secret|apikey|access_key|secret_key).*\") and\n    not s.getText().regexpMatch(\"(?i).*(example|test|dummy|todo).*\") and\n    s.getText().length() > 10\n  )\nselect s, \"Possible hardcoded credential.\"\n",
