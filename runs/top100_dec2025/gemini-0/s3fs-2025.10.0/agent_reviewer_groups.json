    "codeql_raw_query": "/**\n * @name Subprocess usage\n * @description Finds calls to subprocess and os.system/popen to identify potential command injection risks.\n * @kind problem\n * @problem.severity warning\n * @id py/subprocess-usage\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall() or\n  call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall()\nselect call, \"Usage of subprocess or os command execution.\"",
