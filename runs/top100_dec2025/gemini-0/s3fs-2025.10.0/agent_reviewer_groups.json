   {
    "codeql_query_uuid": "20251219215340",
    "codeql_raw_query": "/**\n * @name Hardcoded credentials with string literals\n * @description Detecting hardcoded credentials that are assigned actual string literals, reducing false positives.\n * @kind problem\n * @problem.severity warning\n * @id py/hardcoded-credentials-literals\n * @tags security\n *       external/cwe/cwe-798\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom AssignStmt assign, StrConst str\nwhere\n  assign.getValue() = str and\n  exists(Name name |\n    assign.getTargets().getAnItem() = name and\n    (\n      name.getId().matches(\"%password%\") or\n      name.getId().matches(\"%secret%\") or\n      name.getId().matches(\"%key%\") or\n      name.getId().matches(\"%token%\") or\n      name.getId().matches(\"%auth%\")\n    ) and\n    not name.getId().matches(\"%template%\") and\n    not name.getId().matches(\"%format%\") and\n    not name.getId().matches(\"%example%\")\n  ) and\n  // Filter out empty strings or placeholders\n  str.getText().length() > 5 and\n  not str.getText().matches(\"% %\")\nselect assign, \"Possible hardcoded credential assigned to variable '\" + assign.getTargets().getAnItem().(Name).getId() + \"'.\"\n",
