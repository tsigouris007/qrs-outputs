    "codeql_raw_query": "/**\n * @name Path Traversal\n * @description Detecting potential path traversal vulnerabilities where user input controls file paths.\n * @kind problem\n * @problem.severity error\n * @id py/path-traversal\n * @tags security\n *       external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Consider function parameters as potential sources for library code\n    source instanceof DataFlow::ParameterNode\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    // Sinks: open(), os.path.join, etc.\n    exists(DataFlow::CallCfgNode call |\n      call = API::builtin(\"open\").getACall() and\n      sink = call.getArg(0)\n    )\n    or\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"os\").getMember(\"path\").getMember(\"join\").getACall() and\n      sink = call.getArg(_)\n    )\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\n\nfrom DataFlow::Node source, DataFlow::Node sink\nwhere PathTraversalFlow::flow(source, sink)\nselect sink, \"Potential path traversal from $@\", source, \"source\"",
