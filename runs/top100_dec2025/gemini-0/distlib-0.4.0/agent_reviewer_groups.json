    "codeql_raw_query": "/**\n * @name Subprocess Injection from Library Input\n * @description Detects command injection where the source is a function parameter (library context).\n * @kind path-problem\n * @problem.severity error\n * @id py/subprocess-injection-library\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.Concepts\n\nmodule LibraryInjectionConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof DataFlow::ParameterNode\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    sink = any(SystemCommandExecution sce).getCommand()\n  }\n}\n\nmodule LibraryInjectionFlow = TaintTracking::Global<LibraryInjectionConfig>;\nimport LibraryInjectionFlow::PathGraph\n\nfrom LibraryInjectionFlow::PathNode source, LibraryInjectionFlow::PathNode sink\nwhere LibraryInjectionFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential command injection from parameter $@.\", source.getNode(), \"parameter\"\n",
