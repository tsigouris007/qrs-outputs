    "codeql_raw_query": "/**\n * @name Tar Slip\n * @description Detects unsafe extraction of tar archives which can lead to path traversal.\n * @kind problem\n * @problem.severity error\n * @id py/tar-slip\n * @tags security\n *       external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"tarfile\").getMember(\"open\").getReturn().getMember([\"extract\", \"extractall\"]).getACall()\nselect call, \"Potential Tar Slip vulnerability: Unsafe tar archive extraction.\"\n",
