    "codeql_raw_query": "/**\n * @name Hardcoded Credentials\n * @description Detects hardcoded credentials in the source code.\n * @kind problem\n * @problem.severity warning\n * @id py/hardcoded-credentials\n * @tags security\n *       external/cwe/cwe-798\n */\n\nimport python\n\nfrom AssignStmt assign, Name name, StrConst str\nwhere\n  assign.getTarget(0) = name and\n  assign.getValue() = str and\n  name.getId().regexpMatch(\"(?i).*(password|secret|key|token|auth).*\") and\n  not name.getId().regexpMatch(\"(?i).*(message|file|path|error|info|desc).*\") and\n  // Filter out empty strings or short strings which are likely placeholders\n  str.getText().length() > 5\nselect assign, \"Possible hardcoded credential in variable: \" + name.getId()\n",
