    "codeql_query_uuid": "20251209112141",
    "codeql_raw_query": "/**\n * @name Unsafe Archive Extraction\n * @description Detects unsafe extraction of archives (tar/zip) which can lead to path traversal.\n * @kind problem\n * @problem.severity error\n * @id py/unsafe-archive-extraction\n * @tags security\n *       external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"tarfile\").getMember(\"open\").getReturn().getMember(\"extractall\").getACall() or\n    call = API::moduleImport(\"zipfile\").getMember(\"ZipFile\").getReturn().getMember(\"extractall\").getACall()\n  )\nselect call, \"Potential unsafe archive extraction (Zip Slip).\"\n",
    "hypothesis": "Unsafe extraction of tar or zip files allowing path traversal (Zip Slip).",
    "severity": "high",
    "cwe_ids": [
     "CWE-22"
    ],
