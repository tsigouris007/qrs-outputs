    "codeql_raw_query": "/**\n * @name Insecure SSL Configuration\n * @description Detects usage of insecure SSL protocols or certificate validation settings.\n * @kind problem\n * @problem.severity warning\n * @id py/insecure-ssl\n * @tags security\n *       external/cwe/cwe-295\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::Node node\nwhere\n    node = API::moduleImport(\"ssl\").getMember(\"CERT_NONE\").getAValueReachableFromSource()\nselect node, \"Reference to ssl.CERT_NONE which disables certificate validation.\"\n",
