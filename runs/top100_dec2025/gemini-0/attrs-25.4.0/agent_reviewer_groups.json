    "codeql_query_uuid": "20251208101735",
    "codeql_raw_query": "/**\n * @name Code Injection in attrs\n * @description Detects flow from public API to exec/eval calls in attrs\n * @kind path-problem\n * @problem.severity error\n * @id py/attrs-code-injection-flow\n * @tags security\n *       external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule AttrsCodeInjectionConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    exists(DataFlow::ParameterNode param |\n      source = param and\n      exists(Function f |\n        f = param.getScope() and\n        // Look for functions in the attr package\n        f.getEnclosingModule().getName().matches(\"attr%\")\n      )\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      (\n        call = API::builtin(\"exec\").getACall() or\n        call = API::builtin(\"eval\").getACall()\n      ) and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule AttrsCodeInjectionFlow = TaintTracking::Global<AttrsCodeInjectionConfig>;\nimport AttrsCodeInjectionFlow::PathGraph\n\nfrom AttrsCodeInjectionFlow::PathNode source, AttrsCodeInjectionFlow::PathNode sink\nwhere AttrsCodeInjectionFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential code injection from $@\", source.getNode(), \"parameter\"\n",
    "hypothesis": "User-controlled input to attrs API flows to exec/eval.",
    "severity": "high",
    "cwe_ids": [
     "cwe-094"
    ],
