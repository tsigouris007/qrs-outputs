   "codeql_raw_query": "/**\n * @name Code injection via eval/exec\n * @description Using eval or exec with untrusted input can lead to arbitrary code execution\n * @kind problem\n * @problem.severity error\n * @id py/attrs-code-injection\n * @tags security\n *        external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin(\"exec\").getACall() or\n  call = API::builtin(\"eval\").getACall()\nselect call, \"Call to exec/eval found.\"",
