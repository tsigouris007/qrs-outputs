    "codeql_query_uuid": "20251209115345",
    "codeql_raw_query": "/**\n * @name Potential manual XML construction\n * @description Detecting manual XML construction using string concatenation which might be prone to injection.\n * @kind problem\n * @problem.severity warning\n * @id py/manual-xml-construction\n * @tags security\n *       external/cwe/cwe-116\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom DataFlow::ExprNode expr\nwhere\n  (\n    expr.asExpr() instanceof BinaryExpr and\n    (\n      expr.asExpr().(BinaryExpr).getOp() instanceof Add or\n      expr.asExpr().(BinaryExpr).getOp() instanceof Mod // % formatting\n    )\n  )\n  and\n  (\n    exists(string s | s = expr.asExpr().(BinaryExpr).getLeft().(StrConst).getText() and (s.matches(\"%<%\") or s.matches(\"%>%\"))) or\n    exists(string s | s = expr.asExpr().(BinaryExpr).getRight().(StrConst).getText() and (s.matches(\"%<%\") or s.matches(\"%>%\")))\n  )\nselect expr, \"Potential manual XML construction detected.\"\n",
    "hypothesis": "Manual XML construction using string concatenation or formatting might lead to injection vulnerabilities if input is not properly escaped.",
