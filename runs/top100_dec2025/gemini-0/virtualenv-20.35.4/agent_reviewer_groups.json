    "codeql_query_uuid": "20251221163436",
    "codeql_raw_query": "/**\n * @name Command Injection Broad\n * @description Detects command injection vulnerabilities from CLI args or Env vars to subprocess calls.\n * @kind path-problem\n * @problem.severity error\n * @id py/command-injection-broad\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule CommandInjectionBroadConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // sys.argv\n    source = API::moduleImport(\"sys\").getMember(\"argv\").asSource()\n    or\n    // os.environ\n    source = API::moduleImport(\"os\").getMember(\"environ\").asSource()\n    or\n    // argparse\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"argparse\").getMember(\"ArgumentParser\").getACall().getReturn().getMember(\"parse_args\").getACall() and\n      source = call\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      (\n        call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall()\n        or\n        call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall()\n      ) and\n      (\n        sink = call.getArg(_) or\n        sink = call.getArgByName(_)\n      )\n    )\n  }\n}\n\nmodule CommandInjectionBroadFlow = TaintTracking::Global<CommandInjectionBroadConfig>;\nimport CommandInjectionBroadFlow::PathGraph\n\nfrom CommandInjectionBroadFlow::PathNode source, CommandInjectionBroadFlow::PathNode sink\nwhere CommandInjectionBroadFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Potential command injection from $@.\", source.getNode(), \"user input\"\n",
    "hypothesis": "Command injection via CLI arguments or environment variables into subprocess calls.",
    "severity": "high",
    "cwe_ids": [
     "cwe-078"
    ],
    "results_count": 2,
