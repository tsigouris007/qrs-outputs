   "codeql_query_uuid": "20251218233007",
   "codeql_raw_query": "/**\n * @name Trace pickle file source\n * @description Trace where the file object passed to pickle.load comes from and where its path originates.\n * @kind path-problem\n * @problem.severity error\n * @id py/trace-pickle-source\n * @tags security\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule PickleFileConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Consider any parameter as a potential source for now to see where it comes from\n    source instanceof DataFlow::ParameterNode\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    // The sink is the file argument to pickle.load\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"pickle\").getMember(\"load\").getACall() and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule PickleFileFlow = TaintTracking::Global<PickleFileConfig>;\nimport PickleFileFlow::PathGraph\n\nfrom PickleFileFlow::PathNode source, PickleFileFlow::PathNode sink\nwhere PickleFileFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Pickle load from file sourced at $@.\", source.getNode(), \"parameter\"\n",
   "hypothesis": "The file path used in pickle.load is controlled by a function parameter, potentially allowing unsafe deserialization.",
   "severity": "high",
   "cwe_ids": [
    "CWE-502"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20251218233206",
   "codeql_raw_query": "/**\n * @name Dangerous Sinks\n * @description Finds calls to subprocess, os.system, eval, exec, yaml.load\n * @kind problem\n * @problem.severity warning\n * @id py/dangerous-sinks\n * @tags security\n *       external/cwe/cwe-078\n *       external/cwe/cwe-094\n *       external/cwe/cwe-502\n */\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"check_output\", \"run\", \"Popen\"]).getACall() or\n  call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall() or\n  call = API::builtin(\"eval\").getACall() or\n  call = API::builtin(\"exec\").getACall() or\n  call = API::moduleImport(\"yaml\").getMember([\"load\", \"unsafe_load\"]).getACall()\nselect call, \"Potential dangerous sink.\"",
