    "codeql_raw_query": "/**\n * @name Uncontrolled Resource Consumption (File Read)\n * @description Detects file read operations without size limits which can lead to memory exhaustion.\n * @kind problem\n * @problem.severity warning\n * @id py/uncontrolled-resource-consumption\n * @tags security\n *       external/cwe/cwe-400\n *       external/cwe/cwe-770\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call.getFunction().(DataFlow::AttrRead).getAttributeName() = \"read\" and\n    not exists(call.getArg(0))\n  )\nselect call, \"File read without size limit.\"\n",
    "hypothesis": "Reading files without specifying a size limit can lead to memory exhaustion (DoS).",
