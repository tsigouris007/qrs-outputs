    "codeql_query_uuid": "20251208125124",
    "codeql_raw_query": "/**\n * @name Path Traversal in Library\n * @description Detects file opens with user-controlled paths in a library context\n * @kind problem\n * @problem.severity error\n * @id py/path-traversal-library\n * @tags security\n *       external/cwe/cwe-022\n */\nimport python\nimport semmle.python.ApiGraphs\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\n\nmodule PathTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Consider function parameters as sources for a library analysis\n    source instanceof DataFlow::ParameterNode\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      (\n        call = API::builtin(\"open\").getACall() or\n        call = API::moduleImport(\"builtins\").getMember(\"open\").getACall() or\n        call = API::moduleImport(\"io\").getMember(\"open\").getACall() or\n        call = API::moduleImport(\"pathlib\").getMember(\"Path\").getACall()\n      ) and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule PathTraversalFlow = TaintTracking::Global<PathTraversalConfig>;\n\nfrom DataFlow::Node source, DataFlow::Node sink\nwhere PathTraversalFlow::flow(source, sink)\nselect sink, \"File access depends on library parameter $@.\", source, source.toString()\n",
    "hypothesis": "The library exposes functions that take file paths as arguments, potentially allowing path traversal if not validated, although in a library context this is often intended behavior. We check to confirm.",
