    "codeql_raw_query": "/**\n * @name Verify escape replacements\n * @description Check if _escape_inner replaces the necessary characters\n * @kind problem\n * @problem.severity warning\n * @id py/markupsafe-escape-replacements\n * @tags security\n *       external/cwe/cwe-116\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\n\nfrom Function f, Call c, StrConst s\nwhere \n  f.getName() = \"_escape_inner\" and\n  c.getScope() = f and\n  c.getFunc().(Attribute).getName() = \"replace\" and\n  c.getArg(0) = s and\n  s.getText() in [\"&\", \"<\", \">\", \"\\\"\", \"'\"]\nselect c, \"Replaces \" + s.getText()",
