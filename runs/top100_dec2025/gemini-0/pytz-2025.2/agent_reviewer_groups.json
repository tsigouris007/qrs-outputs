    "codeql_raw_query": "/**\n * @name File Open and Resource Loading\n * @description Detects where files are opened or resources are loaded, which could be relevant for path traversal.\n * @kind problem\n * @problem.severity warning\n * @id py/file-open-detection\n * @tags security\n *       external/cwe/cwe-022\n *       external/cwe/cwe-073\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin(\"open\").getACall() or\n  call = API::moduleImport(\"pkg_resources\").getMember([\"resource_stream\", \"resource_string\"]).getACall()\nselect call, \"File open or resource load detected.\"",
