    "codeql_query_uuid": "20251219162052",
    "codeql_raw_query": "/**\n * @name User-controlled file open in pytz\n * @description Detects if file open operations in pytz use arguments from function parameters, which could be user-controlled.\n * @kind path-problem\n * @problem.severity error\n * @id py/pytz-file-open-taint\n * @tags security\n *       external/cwe/cwe-022\n *       external/cwe/cwe-073\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule FileOpenConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    source instanceof DataFlow::ParameterNode\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      (\n        call = API::builtin(\"open\").getACall() or\n        call = API::moduleImport(\"pkg_resources\").getMember(\"resource_stream\").getACall() or\n        call = API::moduleImport(\"pkg_resources\").getMember(\"resource_string\").getACall()\n      ) and\n      sink = call.getArg(0)\n    ) or\n    exists(DataFlow::CallCfgNode call |\n        call = API::moduleImport(\"pkg_resources\").getMember(\"resource_stream\").getACall() and\n        sink = call.getArg(1) \n    )\n  }\n}\n\nmodule FileOpenFlow = TaintTracking::Global<FileOpenConfig>;\nimport FileOpenFlow::PathGraph\n\nfrom FileOpenFlow::PathNode source, FileOpenFlow::PathNode sink\nwhere FileOpenFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"File open argument derived from parameter $@.\", source.getNode(), \"param\"\n",
    "hypothesis": "Arguments to file open or resource loading functions in pytz might be derived from function parameters, potentially allowing path traversal if the parameter is user-controlled.",
    "severity": "medium",
    "cwe_ids": [
