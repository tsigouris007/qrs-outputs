    "codeql_query_uuid": "20251208120958",
    "codeql_raw_query": "/**\n * @name Certifi Input Usage Analysis\n * @description Detects usage of argparse and environment variables to understand input handling.\n * @kind problem\n * @problem.severity info\n * @id py/certifi-input-usage\n * @tags analysis\n *       external/cwe/cwe-020\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::Node node\nwhere\n  // Check for environment variable access\n  node = API::moduleImport(\"os\").getMember(\"environ\").getAValueReachableFromSource()\n  or\n  // Check for argparse setup\n  node = API::moduleImport(\"argparse\").getMember(\"ArgumentParser\").getACall()\n  or\n  // Check for argparse argument definition\n  exists(DataFlow::CallCfgNode call |\n    call = API::moduleImport(\"argparse\").getMember(\"ArgumentParser\").getReturn().getMember(\"add_argument\").getACall() and\n    node = call\n  )\nselect node, \"Input handling detected: \" + node.toString()",
