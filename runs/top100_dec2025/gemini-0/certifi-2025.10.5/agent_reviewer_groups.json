    "codeql_raw_query": "/**\n * @name Resource Access Analysis\n * @description Detects usage of resource loading mechanisms\n * @kind problem\n * @problem.severity warning\n * @id py/certifi-resource-access\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"importlib\").getMember(\"resources\").getMember([\"path\", \"read_text\", \"open_text\", \"open_binary\", \"files\"]).getACall() or\n  call = API::moduleImport(\"pkg_resources\").getMember([\"resource_filename\", \"resource_string\", \"resource_stream\"]).getACall() or\n  call = API::moduleImport(\"builtins\").getMember(\"open\").getACall()\nselect call, \"Resource access detected\"\n",
