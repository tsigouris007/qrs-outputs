   "codeql_query_uuid": "20251208120815",
   "codeql_raw_query": "/**\n * @name Environment variable access\n * @description Finding access to environment variables which might influence file paths\n * @kind problem\n * @problem.severity medium\n * @id py/env-var-access\n * @tags security\n *       external/cwe/cwe-073\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::Node node\nwhere\n  node = API::moduleImport(\"os\").getMember(\"environ\").getAValueReachableFromSource()\n  or\n  node = API::moduleImport(\"os\").getMember(\"getenv\").getACall()\nselect node, \"Access to environment variable.\"\n",
   "hypothesis": "Certifi might allow overriding the CA bundle path via an environment variable, leading to path manipulation.",
   "severity": "medium",
   "cwe_ids": [
    "CWE-73"
   ],
   "results_count": 0,
   "results": []
  },
  {
   "codeql_query_uuid": "20251208120903",
   "codeql_raw_query": "/**\n * @name Command line argument and environment variable usage\n * @description Detects usage of argparse, sys.argv, and os.environ to understand external input handling.\n * @kind problem\n * @problem.severity info\n * @id py/certifi-input-analysis\n * @tags security\n *       external/cwe/cwe-020\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::Node node\nwhere\n  (\n    node = API::moduleImport(\"argparse\").getMember(\"ArgumentParser\").getACall() or\n    node = API::moduleImport(\"sys\").getMember(\"argv\").asSource() or\n    node = API::moduleImport(\"os\").getMember(\"environ\").asSource() or\n    node = API::moduleImport(\"os\").getMember(\"getenv\").getACall()\n  )\nselect node, \"External input source detected.\"\n",
