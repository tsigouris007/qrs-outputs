   "codeql_raw_query": "/**\n * @name Environment and Path Manipulation Check\n * @description Checks for access to os.environ or modification of sys.path which could indicate configurable paths or unsafe loading.\n * @kind problem\n * @problem.severity warning\n * @id py/certifi-env-path-check\n * @tags security\n *       external/cwe/cwe-426\n *       external/cwe/cwe-015\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::Node node\nwhere\n  // Check for os.environ access\n  (\n    node = API::moduleImport(\"os\").getMember(\"environ\").getAValueReachableFromSource()\n    or\n    node = API::moduleImport(\"os\").getMember(\"getenv\").getACall()\n  )\n  or\n  // Check for sys.path modification\n  exists(DataFlow::CallCfgNode call |\n    call = API::moduleImport(\"sys\").getMember(\"path\").getMember(\"append\").getACall() or\n    call = API::moduleImport(\"sys\").getMember(\"path\").getMember(\"insert\").getACall() or\n    call = API::moduleImport(\"sys\").getMember(\"path\").getMember(\"extend\").getACall()\n    | node = call\n  )\nselect node, \"Potential environment variable access or sys.path modification.\"",
   "hypothesis": "The package might allow overriding the certificate path via environment variables or modify sys.path, leading to potential hijacking of the trust store.",
