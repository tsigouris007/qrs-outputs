   "codeql_query_uuid": "20251206183141",
   "codeql_raw_query": "/**\n * @name Identify classes registering unsafe Python tags\n * @description Finds classes that register python-specific YAML tags which can lead to code execution.\n * @kind problem\n * @problem.severity warning\n * @id py/yaml-unsafe-tag-registration-classes\n * @tags security\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::Node tagArg, Class cls\nwhere\n  call.getFunction().(DataFlow::AttrRead).getAttributeName() = \"add_constructor\" and\n  tagArg = call.getArg(0) and\n  tagArg.asExpr().(StrConst).getText().matches(\"tag:yaml.org,2002:python/%\") and\n  // Find the class where this call happens (usually in the class body or __init__)\n  (\n    call.getScope() = cls or\n    call.getScope().getEnclosingScope() = cls\n  )\nselect cls, \"Class registers unsafe python tag: \" + tagArg.asExpr().(StrConst).getText()\n",
   "hypothesis": "Classes registering unsafe Python tags might be used in safe_load context.",
   "severity": "medium",
   "cwe_ids": [
    "CWE-502"
   ],
