   "codeql_raw_query": "/**\n * @name Check yaml.load default Loader\n * @description Checks the default value of the Loader argument in yaml.load\n * @kind problem\n * @problem.severity warning\n * @id py/yaml-load-default-loader\n * @tags security\n *       external/cwe/cwe-502\n */\n\nimport python\n\nfrom Function f, Parameter p, Expr defaultVal\nwhere\n  f.getName() = \"load\" and\n  f.getEnclosingModule().getName() = \"yaml\" and\n  p = f.getArgByName(\"Loader\") and\n  defaultVal = p.getDefault()\nselect f, \"yaml.load defined with default Loader: \" + defaultVal.toString()",
