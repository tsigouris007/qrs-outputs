    "codeql_raw_query": "/**\n * @name Identify potential unsafe deserialization sinks\n * @description Finds usages of pickle, eval, exec, and dynamic imports which are often used in unsafe deserialization.\n * @kind problem\n * @problem.severity warning\n * @id py/unsafe-deserialization-sinks\n * @tags security\n *       external/cwe/cwe-502\n *       external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\", \"Unpickler\"]).getACall() or\n  call = API::moduleImport(\"marshal\").getMember([\"load\", \"loads\"]).getACall() or\n  call = API::builtin(\"eval\").getACall() or\n  call = API::builtin(\"exec\").getACall() or\n  call = API::builtin(\"__import__\").getACall() or\n  call = API::moduleImport(\"importlib\").getMember(\"import_module\").getACall()\nselect call, \"Potential unsafe sink found.\"",
    "hypothesis": "PyYAML might use unsafe deserialization mechanisms internally to support its python object tags.",
