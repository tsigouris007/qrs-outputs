    "codeql_query_uuid": "20251206183031",
    "codeql_raw_query": "/**\n * @name Find YAML constructor registrations\n * @description Find where add_constructor is called to register handlers for python tags\n * @kind problem\n * @problem.severity warning\n * @id py/yaml-constructor-registration\n * @tags security\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call, DataFlow::ExprNode tagArg\nwhere\n  call.getFunction().(DataFlow::AttrRead).getAttributeName() = \"add_constructor\" and\n  tagArg = call.getArg(0) and\n  tagArg.asExpr().(StrConst).getText().matches(\"tag:yaml.org,2002:python%\")\nselect call, \"Registers python specific tag: \" + tagArg.asExpr().(StrConst).getText()\n",
