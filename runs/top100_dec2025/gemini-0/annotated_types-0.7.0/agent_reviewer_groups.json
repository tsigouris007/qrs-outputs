    "codeql_raw_query": "/**\n * @name Functions with control flow\n * @description Identify functions that have control flow logic (if, for, while) to spot potential complexity.\n * @kind problem\n * @problem.severity recommendation\n * @id py/complex-functions\n * @tags maintenance\n *       external/cwe/cwe-400\n */\n\nimport python\n\nfrom Function f, Stmt s\nwhere\n  s.getScope() = f and\n  (\n    s instanceof If or\n    s instanceof For or\n    s instanceof While\n  )\nselect f, \"Function contains control flow logic.\"\n",
