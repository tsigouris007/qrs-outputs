   {
    "codeql_query_uuid": "20251208132001",
    "codeql_raw_query": "/**\n * @name Subprocess with shell=True or os.system\n * @description Finding subprocess calls with shell=True or os.system which can be dangerous\n * @kind problem\n * @problem.severity warning\n * @id py/subprocess-shell-true\n * @tags security\n *       external/cwe/cwe-078\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::moduleImport(\"subprocess\").getMember([\"call\", \"check_call\", \"run\", \"Popen\"]).getACall() and\n    call.getArgByName(\"shell\").asExpr().(BooleanLiteral).booleanValue() = true\n  )\n  or\n  call = API::moduleImport(\"os\").getMember([\"system\", \"popen\"]).getACall()\nselect call, \"Call to subprocess with shell=True or os.system/popen.\"\n",
    "hypothesis": "Subprocess calls with shell=True or os.system usage might be present and potentially unsafe.",
