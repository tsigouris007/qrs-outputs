    "codeql_query_uuid": "20251209122900",
    "codeql_raw_query": "/**\n * @name Trace data flow to expandvars\n * @description Trace where the argument to expandvars comes from\n * @kind path-problem\n * @problem.severity warning\n * @id py/trace-expandvars\n * @tags security\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule ExpandVarsConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Consider all parameters of the function containing the call as sources initially\n    // to see where the data enters the function scope.\n    exists(Function f |\n        f = source.getScope() and\n        source instanceof DataFlow::ParameterNode\n    )\n    or\n    // Also consider file reads or environment variables\n    source = API::moduleImport(\"os\").getMember(\"environ\").getAValueReachableFromSource()\n    or\n    source = API::moduleImport(\"os\").getMember(\"getenv\").getACall()\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"expandvars\").getMember(\"expandvars\").getACall() or\n      call = API::moduleImport(\"os\").getMember(\"path\").getMember(\"expandvars\").getACall() |\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule ExpandVarsFlow = TaintTracking::Global<ExpandVarsConfig>;\nimport ExpandVarsFlow::PathGraph\n\nfrom ExpandVarsFlow::PathNode source, ExpandVarsFlow::PathNode sink\nwhere ExpandVarsFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"expandvars argument comes from $@.\", source.getNode(), \"source\"\n",
    "hypothesis": "The argument to expandvars might be controlled by an external source.",
    "severity": "low",
