   "codeql_raw_query": "/**\n * @name Insecure Temporary File\n * @description Detects use of insecure temporary file functions.\n * @kind problem\n * @problem.severity warning\n * @id py/insecure-temp-file\n * @tags security\n *       external/cwe/cwe-377\n */\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"tempfile\").getMember(\"mktemp\").getACall() or\n  call = API::moduleImport(\"os\").getMember(\"tempnam\").getACall() or\n  call = API::moduleImport(\"os\").getMember(\"tmpnam\").getACall()\nselect call, \"Use of insecure temporary file function.\"\n",
