   "codeql_query_uuid": "20251209134523",
   "codeql_raw_query": "/**\n * @name Unsafe YAML Deserialization\n * @description Detects calls to unsafe YAML deserialization functions.\n * @kind problem\n * @problem.severity error\n * @id py/unsafe-yaml-deserialization\n * @tags security\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"yaml\").getMember(\"load\").getACall()\nselect call, \"Call to yaml.load() is unsafe. Use yaml.safe_load() instead.\"\n",
   "hypothesis": "The package might use unsafe YAML loading functions which can lead to arbitrary code execution.",
   "severity": "high",
   "cwe_ids": [
    "CWE-502"
   ],
   "results_count": 0,
   "results": []
  },
