    "codeql_raw_query": "/**\n * @name XML External Entity (XXE)\n * @description Parsing XML with untrusted input can lead to XXE.\n * @kind problem\n * @problem.severity error\n * @id py/xxe\n * @tags security\n *       external/cwe/cwe-611\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"xml\").getMember(\"etree\").getMember(\"ElementTree\").getMember(\"parse\").getACall() or\n  call = API::moduleImport(\"xml\").getMember(\"etree\").getMember(\"ElementTree\").getMember(\"fromstring\").getACall() or\n  call = API::moduleImport(\"lxml\").getMember(\"etree\").getMember(\"parse\").getACall() or\n  call = API::moduleImport(\"lxml\").getMember(\"etree\").getMember(\"fromstring\").getACall() or\n  call = API::moduleImport(\"xml\").getMember(\"dom\").getMember(\"minidom\").getMember(\"parse\").getACall() or\n  call = API::moduleImport(\"xml\").getMember(\"dom\").getMember(\"minidom\").getMember(\"parseString\").getACall() or\n  call = API::moduleImport(\"xml\").getMember(\"sax\").getMember(\"parse\").getACall() or\n  call = API::moduleImport(\"xml\").getMember(\"sax\").getMember(\"parseString\").getACall()\nselect call, \"Potential XXE vulnerability in XML parsing.\"\n",
