   "codeql_query_uuid": "20251213210020",
   "codeql_raw_query": "/**\n * @name Unsafe Deserialization in Bytecode Cache\n * @description Deserializing data from files in the bytecode cache can be unsafe if the cache directory is writable by others.\n * @kind path-problem\n * @problem.severity error\n * @id py/unsafe-bccache-deserialization\n * @tags security\n *       external/cwe/cwe-502\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule DeserializationConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Source is a file read or a parameter that looks like a file object\n    exists(DataFlow::CallCfgNode call |\n      call = API::moduleImport(\"builtins\").getMember(\"open\").getACall() and\n      source = call\n    )\n    or\n    source instanceof DataFlow::ParameterNode\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    exists(DataFlow::CallCfgNode call |\n      (\n        call = API::moduleImport(\"pickle\").getMember([\"load\", \"loads\"]).getACall() or\n        call = API::moduleImport(\"marshal\").getMember([\"load\", \"loads\"]).getACall()\n      ) and\n      sink = call.getArg(0)\n    )\n  }\n}\n\nmodule DeserializationFlow = TaintTracking::Global<DeserializationConfig>;\nimport DeserializationFlow::PathGraph\n\nfrom DeserializationFlow::PathNode source, DeserializationFlow::PathNode sink\nwhere DeserializationFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Unsafe deserialization from $@.\", source.getNode(), \"file or parameter\"\n",
