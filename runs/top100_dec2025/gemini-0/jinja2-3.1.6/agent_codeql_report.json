  {
   "codeql_query_uuid": "20251213210058",
   "codeql_raw_query": "/**\n * @name Path Traversal in Loaders\n * @description specific check for path traversal in Jinja2 loaders\n * @kind path-problem\n * @problem.severity error\n * @id py/jinja2-loader-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.dataflow.new.TaintTracking\nimport semmle.python.ApiGraphs\n\nmodule LoaderTraversalConfig implements DataFlow::ConfigSig {\n  predicate isSource(DataFlow::Node source) {\n    // Source is the 'template' argument of get_source method in BaseLoader subclasses\n    exists(Function func, DataFlow::ParameterNode param |\n      func.getName() = \"get_source\" and\n      func.getEnclosingModule().getName().matches(\"%loaders%\") and\n      param.getParameter() = func.getArgByName(\"template\") and\n      source = param\n    )\n  }\n\n  predicate isSink(DataFlow::Node sink) {\n    // Sink is the open() call or os.path.join\n    sink = API::builtin(\"open\").getACall().getArg(0)\n  }\n}\n\nmodule LoaderTraversalFlow = TaintTracking::Global<LoaderTraversalConfig>;\nimport LoaderTraversalFlow::PathGraph\n\nfrom LoaderTraversalFlow::PathNode source, LoaderTraversalFlow::PathNode sink\nwhere LoaderTraversalFlow::flowPath(source, sink)\nselect sink.getNode(), source, sink, \"Path traversal from $@.\", source.getNode(), \"template name\"\n",
   "hypothesis": "Jinja2 loaders might allow path traversal via crafted template names.",
   "severity": "high",
   "cwe_ids": [
    "CWE-22"
   ],
   "results_count": 0,
   "results": []
