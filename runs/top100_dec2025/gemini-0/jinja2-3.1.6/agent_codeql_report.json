   "codeql_raw_query": "/**\n * @name Regex Injection\n * @description User input used in regular expressions can lead to ReDoS or logic errors.\n * @kind problem\n * @problem.severity error\n * @id py/regex-injection\n * @tags security\n *        external/cwe/cwe-1333\n *        external/cwe/cwe-730\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::moduleImport(\"re\").getMember([\"compile\", \"search\", \"match\", \"findall\", \"finditer\", \"split\", \"sub\", \"subn\"]).getACall() and\n  not call.getArg(0).asExpr() instanceof StringLiteral\nselect call, \"Regular expression pattern comes from a variable, potentially user-controlled.\"\n",
