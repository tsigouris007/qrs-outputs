    "codeql_raw_query": "/**\n * @name Code injection via eval/exec\n * @description Using eval or exec with untrusted input can lead to arbitrary code execution\n * @kind problem\n * @problem.severity error\n * @id py/code-injection-eval-exec\n * @tags security\n *        external/cwe/cwe-094\n *        external/cwe/cwe-095\n */\n\nimport python\nimport semmle.python.dataflow.new.DataFlow\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin(\"eval\").getACall() or\n  call = API::builtin(\"exec\").getACall() or\n  call = API::builtin(\"compile\").getACall()\nselect call, \"Call to eval, exec or compile.\"\n",
