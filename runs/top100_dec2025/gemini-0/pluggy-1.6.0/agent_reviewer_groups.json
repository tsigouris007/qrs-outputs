    "codeql_raw_query": "/**\n * @name Dynamic attribute access\n * @description Using getattr/setattr with dynamic attribute names can be risky\n * @kind problem\n * @problem.severity warning\n * @id py/dynamic-attr-access\n * @tags security\n *       external/cwe/cwe-915\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    call = API::builtin(\"getattr\").getACall() or\n    call = API::builtin(\"setattr\").getACall()\n  )\n  and not exists(call.getArg(1).asExpr().(StrConst))\nselect call, \"Dynamic attribute access using getattr/setattr.\"\n",
