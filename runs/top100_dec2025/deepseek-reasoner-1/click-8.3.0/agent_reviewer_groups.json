    "codeql_query_uuid": "20251227211720",
    "codeql_raw_query": "/**\n * @name Path traversal in file operations\n * @description Checking for unsafe file operations that could lead to path traversal\n * @kind problem\n * @problem.severity error\n * @id py/path-traversal\n * @tags security\n *        external/cwe/cwe-022\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom API::CallNode call\nwhere\n  // File open operations\n  call = API::moduleImport(\"builtins\").getMember(\"open\").getACall() or\n  call = API::moduleImport(\"os\").getMember([\"open\", \"makedirs\", \"remove\", \"unlink\", \"rmdir\"]).getACall() or\n  call = API::moduleImport(\"shutil\").getMember([\"copy\", \"copy2\", \"copytree\", \"move\", \"rmtree\"]).getACall() or\n  call = API::moduleImport(\"pathlib\").getMember([\"Path\", \"PurePath\"]).getACall()\nselect call, \"File operation that could be vulnerable to path traversal if user input is used\"",
