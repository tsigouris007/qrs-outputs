    "codeql_raw_query": "/**\n * @name Eval/exec usage in CFFI\n * @description Using eval or exec with untrusted input can lead to arbitrary code execution\n * @kind problem\n * @problem.severity error\n * @id py/eval-exec-usage\n * @tags security\n *        external/cwe/cwe-094\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  call = API::builtin([\"eval\", \"exec\", \"compile\"]).getACall() or\n  call = API::moduleImport(\"cffi\").getMember(\"*\").getACall() and\n  call.toString().matches(\"%eval%\") or\n  call.toString().matches(\"%exec%\")\nselect call, \"Potentially dangerous eval/exec/compile call that could execute arbitrary code.\"",
    "hypothesis": "CFFI may use eval/exec for parsing C expressions or dynamic code generation",
