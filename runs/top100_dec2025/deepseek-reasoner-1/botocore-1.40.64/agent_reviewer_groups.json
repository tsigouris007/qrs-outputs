    "codeql_raw_query": "/**\n * @name Insecure cryptographic operations\n * @description Using weak cryptographic algorithms or hardcoded secrets\n * @kind problem\n * @problem.severity error\n * @id py/insecure-crypto\n * @tags security\n *        external/cwe/cwe-326\n *        external/cwe/cwe-547\n */\n\nimport python\nimport semmle.python.ApiGraphs\n\nfrom DataFlow::CallCfgNode call\nwhere\n  (\n    // Weak hash algorithms\n    call = API::moduleImport(\"hashlib\").getMember([\"md5\", \"sha1\"]).getACall()\n    or\n    // Insecure random\n    call = API::moduleImport(\"random\").getMember([\"random\", \"randint\"]).getACall()\n    or\n    // Weak HMAC algorithms\n    call = API::moduleImport(\"hmac\").getMember([\"new\"]).getACall()\n    and exists(DataFlow::Node arg | arg = call.getArg(1) | \n      arg.asExpr().toString() = \"md5\" or arg.asExpr().toString() = \"sha1\"\n    )\n  )\nselect call, \"Potentially insecure cryptographic operation.\"",
